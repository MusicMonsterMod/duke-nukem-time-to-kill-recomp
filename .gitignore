# Track implementation source, patches, tools and documentation.
# Original media, generated game code, player data and build output stay local.

# --- Original game / retail media (never commit) ---
# Player dump drop folder (README is tracked; dumps are not).
/game/*
!/game/README.md

# Legacy CloneCD / Redump drop folders.
/Duke Nukem*/
*.img
*.sub
*.ccd
*.bin
*.cue
*.iso
*.chd
*.ecm
*.mds
*.mdf
*.nrg
*.pbp
*.toc

# Duke3D / Build archives and related packs (e.g. DUKE3D.GRP).
*.grp
*.GRP
*.wad
*.WAD
*.pk3
*.PK3
*.rff
*.RFF
*.ssi
*.con
*.VOC
*.voc

# BIOS, memory cards, save data.
SCPH*.BIN
SCPH*.bin
bios.cfg
disc.cfg
rom.cfg
*.mcd
*.mcr
*.mcs
*.gme
*.vmp
*.VMP
memcard*

# --- Recomp source is tracked; local inputs and outputs are not ---
/recomp/disc/
/recomp/generated/
/recomp/analysis/
/recomp/saves/
/recomp/config/
/recomp/build*/
/recomp/assets/fonts/
/recomp/assets/*.pack
/recomp/assets/*.provenance.json

# EDuke32 checkout, GRP, manuals, fonts, inventory tiles, reference configs.
/research/

