+static void runtime_halt_poll(void) {
+    if (g_headless) return;
+    SDL_Event event;
+    while (SDL_PollEvent(&event)) {
+        if (event.type == SDL_QUIT) {
+            psx_crash_trace_set_exit_origin("sdl_close_after_fatal");
+            shutdown_runtime();
+            std::exit(1);
+        }
+    }
