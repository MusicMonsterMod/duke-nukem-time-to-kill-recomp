+/* SDL3 has one fullscreen flag: a window without a fullscreen display mode
+ * is borderless desktop fullscreen, one with a mode is exclusive. Give mode 2
+ * the desktop's own display mode (a real exclusive mode at the current
+ * resolution) and clear it for mode 1, so the two settings differ. Call before
+ * entering fullscreen; SDL applies it immediately to a fullscreen window. */
+static void psx_apply_fullscreen_display_mode(SDL_Window* window, int mode) {
+#if defined(PSX_SDL3)
+    if (!window) return;
+    const SDL_DisplayMode* desktop = nullptr;
+    if (mode == 2) {
+        SDL_DisplayID display = SDL_GetDisplayForWindow(window);
+        if (!display) display = SDL_GetPrimaryDisplay();
+        desktop = SDL_GetDesktopDisplayMode(display);
+    }
+    if (!SDL_SetWindowFullscreenMode(window, desktop))
+        std::fprintf(stderr, "psxrecomp: fullscreen display mode not applied: %s\n",
+                     SDL_GetError());
+    else if (desktop)
+        std::fprintf(stdout, "psxrecomp: exclusive fullscreen mode %dx%d @ %.2f Hz\n",
+                     desktop->w, desktop->h, (double)desktop->refresh_rate);
+#else
+    (void)window;
+    (void)mode;
+#endif
+}
+
+/* Time to Kill D13: the fullscreen kind the fullscreen key (F11) enters from a windowed
+ * launch (1 borderless, 2 exclusive), the last windowed width seen (0 while
+ * maximised = fit the display, -1 = none yet), and the launcher's state file. */
+static int         s_fullscreen_target = 1;
+static int         s_last_windowed_w   = -1;
+static std::string s_presentation_state_path;
+
+static void psx_note_windowed_geometry(SDL_Window* window) {
+    if (!window) return;
+    const auto flags = SDL_GetWindowFlags(window);
+    if (flags & SDL_WINDOW_FULLSCREEN) return;
+    if (flags & SDL_WINDOW_MAXIMIZED) { s_last_windowed_w = 0; return; }
+    int w = 0, h = 0;
+    SDL_GetWindowSize(window, &w, &h);
+    if (w >= 640) s_last_windowed_w = w;
+}
+
+/* Written once at exit so the launcher can restore the window as it was left:
+ * fullscreen or windowed after any F11 toggle, the fullscreen kind, and width. */
+static void psx_write_presentation_state(SDL_Window* window) {
+    if (!window || s_presentation_state_path.empty()) return;
+    psx_note_windowed_geometry(window);
+    const bool fullscreen = (SDL_GetWindowFlags(window) & SDL_WINDOW_FULLSCREEN) != 0;
+    int kind = g_fullscreen ? g_fullscreen : s_fullscreen_target;
+#if defined(PSX_SDL3)
+    if (fullscreen) kind = SDL_GetWindowFullscreenMode(window) ? 2 : 1;
+#endif
+    const char* kind_name = kind == 2 ? "exclusive" : "borderless";
+    const int width = s_last_windowed_w >= 0 ? s_last_windowed_w
+                                             : (g_video_win_w_explicit ? g_video_win_w : 0);
+    const std::string temporary = s_presentation_state_path + ".tmp";
+    FILE* file = std::fopen(temporary.c_str(), "w");
+    if (!file) return;
+    const bool ok = std::fprintf(file,
+        "{\"display\": \"%s\", \"fullscreen_mode\": \"%s\", \"window_width\": %d}\n",
+        fullscreen ? kind_name : "windowed", kind_name, width) > 0;
+    if (std::fclose(file) == 0 && ok)
+        std::rename(temporary.c_str(), s_presentation_state_path.c_str());
+    else
+        std::remove(temporary.c_str());
+}
