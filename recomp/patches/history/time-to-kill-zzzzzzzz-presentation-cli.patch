+/* A binding's Ctrl/Alt/Shift are side-agnostic groups (KMOD_ALT is both Alt
+ * keys), while a key event reports the one side held (e.g. KMOD_LALT). Compare
+ * groups, not raw bits: an exact compare required both Alt keys for Alt+Enter. */
+static int mod_groups(int mod) {
+    return ((mod & KMOD_CTRL) ? (int)KMOD_CTRL : 0) |
+           ((mod & KMOD_ALT) ? (int)KMOD_ALT : 0) |
+           ((mod & KMOD_SHIFT) ? (int)KMOD_SHIFT : 0);
+}
