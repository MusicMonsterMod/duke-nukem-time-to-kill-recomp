+        if (to_save) rr_blit(s_wide_fbo[i], s_rr_wide_fbo[i], g_wide_w * S, hh, GL_COLOR_BUFFER_BIT | GL_STENCIL_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
