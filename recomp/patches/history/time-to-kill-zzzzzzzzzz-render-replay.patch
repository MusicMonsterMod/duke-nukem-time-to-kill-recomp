+static uint32_t g_text_exact_last_range_lo,g_text_exact_last_range_len;
+static uint32_t g_text_exact_last_mismatch,g_text_exact_last_live,g_text_exact_last_ref;
+static int aot_blocked(uint32_t x) {(void)x;return 0;}
+static int dirty_ram_is_dirty(uint32_t x) {(void)x;return 0;}
+''' + restore + guard + r'''
+static int overlay_cache_window_contains(uint32_t p) {return p>=8192 && p<12288;}
+uint32_t dirty_ram_text_modified_bitmap_word(uint32_t w) {return w<1?text_modified_bitmap[w]:0;}
+''' + eligibility + r'''
+static int s_active,prepared,attempts;
