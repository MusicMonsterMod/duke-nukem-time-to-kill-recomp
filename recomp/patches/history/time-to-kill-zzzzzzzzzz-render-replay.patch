+void gl_renderer_set_replay_provider(int (*fn)(const PSXModPresentInfo *info, void *user), void *user,
+                                     double target_hz, double host_hz, double source_hz) {
+    s_rp_provider = fn;
+    s_rp_user = user;
+    s_rp_target_hz = target_hz;
+    s_rp_host_hz = host_hz;
+    s_rp_source_hz = source_hz;
+    s_rp_enabled = fn != NULL && source_hz >= 1.0;
+    frame_interpolation_schedule_reset(&s_rp_schedule);
+    if (s_rp_enabled)
+        fprintf(stdout, "psxrecomp: replay presentation enabled: target %s%.1f Hz "
+                "(host %.1f Hz, guest %.3f Hz)\n",
+                target_hz < 0.0 ? "unlimited, cap " : target_hz == 0.0 ? "display " : "",
+                target_hz < 0.0 ? 1000.0 : target_hz == 0.0 ? host_hz : target_hz,
+                host_hz, source_hz);
+}
+
+void gl_renderer_set_replay_host_hz(double host_hz) { s_rp_host_hz = host_hz; }
+
+int gl_renderer_replay_owns_cadence(void) {
+    return s_ctx && s_raster_ok && s_rp_enabled;
+}
+
+void gl_renderer_replay_diag(uint64_t *presents, uint64_t *replays, uint64_t *misses,
+                             double *target_hz, uint64_t hist[8]) {
+    if (presents) *presents = s_rp_presents;
+    if (replays) *replays = s_rp_replays;
+    if (misses) *misses = s_rp_misses;
+    if (target_hz) *target_hz = s_rp_target_hz > 0.0 ? s_rp_target_hz
+                              : s_rp_target_hz < 0.0 ? 1000.0 : s_rp_host_hz;
+    if (hist) for (int i = 0; i < 8; i++) hist[i] = s_rp_interval_hist[i];
+}
+
+static int s_rp_last_presented = 0;
+static int s_rp_div = 1;
+void gl_renderer_set_replay_divisor(int d) { s_rp_div = d < 1 ? 1 : d > 16 ? 16 : d; }
+int gl_renderer_replay_divisor(void) { return s_rp_div; }
+static void rp_present_slot(int slot) {
+    int ww = 0, wh = 0, lx, ly, lw, lh;
+    if (!s_rp_valid[slot]) slot = 0;
+    if (!s_rp_valid[slot]) return;
+    s_rp_last_presented = slot;
+    SDL_GL_GetDrawableSize(s_win, &ww, &wh);
+    if (s_rp_force_4_3) letterbox_rect_aspect(ww, wh, 4, 3, &lx, &ly, &lw, &lh);
+    else letterbox_rect(ww, wh, &lx, &ly, &lw, &lh);
+    gs_bind_fb(PSXGL_DRAW_FRAMEBUFFER, 0);
+    gs_disable(GL_SCISSOR_TEST);
+    glViewport(0, 0, ww, wh);
+    if (lx != 0 || ly != 0 || lw != ww || lh != wh) {
+        glClearColor(0.f, 0.f, 0.f, 1.f);
+        glClear(GL_COLOR_BUFFER_BIT);
+    }
+    present_bezel(ww, wh, lx, ly, lw, lh);
+    present_target_quad(s_rp_tex[slot], s_rp_w, s_rp_h, 0, 0, s_rp_w, s_rp_h,
+                        s_rp_linear, lx, ly, lw, lh, 1);
+    pres_record(GL_PRES_INTERP, 0, 0, s_rp_w, s_rp_h, lx, ly, lw, lh);
+    latency_ring_mark(LAT_SWAP_BEGIN);
+    uint64_t swap0 = SDL_GetPerformanceCounter();
+    gl_swap_with_osd();
+    latency_ring_mark(LAT_SWAP_END);
+    {
+        uint64_t now = SDL_GetPerformanceCounter(), f = SDL_GetPerformanceFrequency();
+        if (f) {s_rp_swap_us += (now - swap0) * 1000000u / f;
+            s_rq_swap[s_rq_swaps++%256]=(double)(now-swap0)*1000.0/f;}
+        if (s_rp_last_swap && f) {
+            /* Present-interval histogram: <2, <4, <5, <6, <8, <12, <20, >=20 ms. */
+            double ms = (double)(now - s_rp_last_swap) * 1000.0 / (double)f;
+            int b = ms < 2.0 ? 0 : ms < 4.0 ? 1 : ms < 5.0 ? 2 : ms < 6.0 ? 3 :
+                    ms < 8.0 ? 4 : ms < 12.0 ? 5 : ms < 20.0 ? 6 : 7;
+            s_rp_interval_hist[b]++;
+        }
+        s_rp_last_swap = now;
+        s_rp_ring_t[s_rp_ring_n % RP_RING] = now;
+        s_rp_ring_kind[s_rp_ring_n % RP_RING] = slot >= 1 ? 2 : (s_rp_new_image ? 1 : 0);
+        {
+            const uint64_t ident = slot >= 1 ? ((uint64_t)slot << 32 | s_rp_gen[slot]) : (uint64_t)s_rp_real_gen;
+            if (ident != s_rp_last_ident) s_rp_distinct++;
+            s_rp_last_ident = ident;
+        }
+        s_rp_ring_n++;
+        s_rp_new_image = 0;
+        s_rp_last_present = now;
+    }
+    s_rp_presents++;
+}
+
+/* Debug dump of the real displayed frame (slot 0) and the last replayed frame
+ * (slot 1), requested by the debug server and written on the GL thread. */
+static char s_rp_dump_base[480];
+static volatile int s_rp_dump_req = 0, s_rp_dump_done = 0;
+void gl_replay_request_dump(const char *base) {
+    snprintf(s_rp_dump_base, sizeof s_rp_dump_base, "%s", base ? base : "");
+    s_rp_dump_done = 0;
+    s_rp_dump_req = 1;
+}
+int gl_replay_dump_done(void) { return s_rp_dump_done; }
+static int rp_dump_slot(int slot, const char *path) {
+    int w = s_rp_tw[slot], h = s_rp_th[slot], ok = 0;
+    if (!s_rp_valid[slot] || w <= 0 || h <= 0) return 0;
+    uint8_t *rows = (uint8_t *)malloc((size_t)w * h * 3);
+    uint8_t *flip = rows ? (uint8_t *)malloc((size_t)w * h * 3) : NULL;
+    if (rows && flip) {
+        gs_bind_fb(PSXGL_READ_FRAMEBUFFER, s_rp_fbo[slot]);
+        glPixelStorei(GL_PACK_ALIGNMENT, 1);
+        glReadPixels(0, 0, w, h, GL_RGB, GL_UNSIGNED_BYTE, rows);
+        gs_bind_fb(PSXGL_READ_FRAMEBUFFER, 0);
+        for (int y = 0; y < h; y++)
+            memcpy(flip + (size_t)y * w * 3, rows + (size_t)(h - 1 - y) * w * 3, (size_t)w * 3);
+        FILE *pf = fopen(path, "wb");
+        if (pf) { ok = png_write_rgb(pf, flip, (uint32_t)w, (uint32_t)h); fclose(pf); }
+    }
+    free(flip);
+    free(rows);
+    return ok;
+}
+/* Triple dump (path ends in "-trip"): the real image k, the first replay
+ * shown for it, and the real image k+1 at the next change. */
+static int s_rp_trip = 0;
+static void rp_dump_trip(int presented_slot) {
+    char path[512];
+    if (s_rp_trip == 1 && presented_slot >= 1) {
+        snprintf(path, sizeof path, "%s-k0.png", s_rp_dump_base);
+        int a = rp_dump_slot(0, path);
+        snprintf(path, sizeof path, "%s-mid.png", s_rp_dump_base);
+        int b = rp_dump_slot(presented_slot, path);
+        s_rp_trip = (a && b) ? 2 : 0;
+        if (!s_rp_trip) s_rp_dump_done = 1;
+    } else if (s_rp_trip == 2 && presented_slot == 0 && s_rp_ring_n &&
+               s_rp_ring_kind[(s_rp_ring_n - 1u) % RP_RING] == 1) {
+        snprintf(path, sizeof path, "%s-k1.png", s_rp_dump_base);
+        s_rp_dump_done = 1 + 3 * rp_dump_slot(0, path);
+        s_rp_trip = 0;
+    }
+}
+/* Sequence dump (path ends in "-seq"): the next 24 presented images, copied
+ * on the GPU as they are shown and written once all are collected (writing
+ * PNGs during the run would stall it). */
+#define RP_SEQ 24
+static int s_rp_seq = 0;
+static GLuint s_rp_seq_tex[RP_SEQ], s_rp_seq_fbo[RP_SEQ];
+static int s_rp_seq_kind[RP_SEQ], s_rp_seq_w, s_rp_seq_h;
+static void rp_dump_if_requested(void) {
+    char path[512];
+    if (s_rp_seq > 0) {
+        int n = RP_SEQ - s_rp_seq, slot = s_rp_last_presented;
+        int w = s_rp_tw[slot], h = s_rp_th[slot];
+        if (!s_rp_seq_tex[n] || s_rp_seq_w != w || s_rp_seq_h != h) {
+            if (s_rp_seq_fbo[n]) gs_delete_fbs(1, &s_rp_seq_fbo[n]);
+            if (s_rp_seq_tex[n]) glDeleteTextures(1, &s_rp_seq_tex[n]);
+            s_rp_seq_tex[n] = make_tex(GL_RGBA8, w, h, GL_RGBA, GL_UNSIGNED_BYTE);
+            make_fbo(&s_rp_seq_fbo[n], s_rp_seq_tex[n], 0);
+        }
+        gs_bind_fb(PSXGL_READ_FRAMEBUFFER, s_rp_fbo[slot]);
+        gs_bind_fb(PSXGL_DRAW_FRAMEBUFFER, s_rp_seq_fbo[n]);
+        p_glBlitFramebuffer(0, 0, w, h, 0, 0, w, h, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+        gs_bind_fb(PSXGL_READ_FRAMEBUFFER, 0);
+        gs_bind_fb(PSXGL_DRAW_FRAMEBUFFER, 0);
+        s_rp_seq_kind[n] = slot ? 2 : (s_rp_ring_kind[(s_rp_ring_n - 1u) % RP_RING] == 1 ? 1 : 0);
+        if (n == 0) { s_rp_seq_w = w; s_rp_seq_h = h; }
+        if (--s_rp_seq == 0) {
+            GLuint keep_tex = s_rp_tex[0], keep_fbo = s_rp_fbo[0];
+            int keep_valid = s_rp_valid[0], kw = s_rp_tw[0], kh = s_rp_th[0];
+            for (int i = 0; i < RP_SEQ; i++) {
+                s_rp_tex[0] = s_rp_seq_tex[i]; s_rp_fbo[0] = s_rp_seq_fbo[i];
+                s_rp_valid[0] = 1; s_rp_tw[0] = s_rp_seq_w; s_rp_th[0] = s_rp_seq_h;
+                snprintf(path, sizeof path, "%s-%02d-%s.png", s_rp_dump_base, i,
+                         s_rp_seq_kind[i] == 2 ? "redraw" : s_rp_seq_kind[i] == 1 ? "new" : "real");
+                rp_dump_slot(0, path);
+            }
+            s_rp_tex[0] = keep_tex; s_rp_fbo[0] = keep_fbo; s_rp_valid[0] = keep_valid;
+            s_rp_tw[0] = kw; s_rp_th[0] = kh;
+            s_rp_dump_done = 4;
+        }
