+static void rr_cow_wide(GLuint fbo, int y0, int y1) {
+    if (!s_rr_active || !rr_cow_enabled() || !fbo || g_wide_w <= 0) return;
+    int i = 0;
+    while (i < WIDE_MAX_SURF && s_wide_fbo[i] != fbo) i++;
+    if (i == WIDE_MAX_SURF) return;
+    if (!s_rr_wide_fbo[i] && !rr_alloc()) return;   /* surface created during the session */
+    if (!s_rr_wide_fbo[i]) return;
+    if (y0 < 0) y0 = 0; if (y1 > VRAM_H - 1) y1 = VRAM_H - 1;
+    if (y1 < y0) return;
+    if (!rr_cow_push(i, 0, y0, g_wide_w - 1, y1)) return;
+    const RrCow *c = &s_rr_cow[s_rr_cow_n - 1];
+    rr_rect_blit(s_wide_fbo[i], s_rr_wide_fbo[i], c->x0, c->y0, c->x1, c->y1);
