+static int rr_cow_push(int surf, int x0, int y0, int x1, int y1) {
+    for (int i = 0; i < s_rr_cow_n; i++) {
+        const RrCow *c = &s_rr_cow[i];
+        if (c->surf == surf && c->x0 <= x0 && c->y0 <= y0 && c->x1 >= x1 && c->y1 >= y1) return 0;
+    }
+    if (s_rr_cow_n >= RR_COW_MAX - 1 && !(x0 == 0 && y0 == 0)) {
+        /* Out of entries: save the whole surface once (contains everything). */
+        int full_x1 = surf < 0 ? VRAM_W - 1 : g_wide_w - 1;
+        return rr_cow_push(surf, 0, 0, full_x1, VRAM_H - 1);
+    }
+    if (s_rr_cow_n >= RR_COW_MAX) return 0;
+    s_rr_cow[s_rr_cow_n++] = (RrCow){ surf, x0, y0, x1, y1 };
+    s_rr_cow_rects++;
+    s_rr_cow_pixels += (uint64_t)(x1 - x0 + 1) * (uint64_t)(y1 - y0 + 1);
+    return 1;
+}
+static void rr_cow_hr(int x0, int y0, int x1, int y1) {
+    if (!s_rr_active || !rr_cow_enabled()) return;
+    if (x0 < 0) x0 = 0; if (y0 < 0) y0 = 0;
+    if (x1 > VRAM_W - 1) x1 = VRAM_W - 1; if (y1 > VRAM_H - 1) y1 = VRAM_H - 1;
+    if (x1 < x0 || y1 < y0) return;
+    if (!rr_cow_push(-1, x0, y0, x1, y1)) return;
+    const RrCow *c = &s_rr_cow[s_rr_cow_n - 1];
