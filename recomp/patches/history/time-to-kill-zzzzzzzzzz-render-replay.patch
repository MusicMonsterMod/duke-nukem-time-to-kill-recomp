+static void rp_ensure_tex(int slot, int tw, int th) {
+    if (s_rp_tex[slot] && s_rp_tw[slot] == tw && s_rp_th[slot] == th) return;
+    if (s_rp_fbo[slot]) { gs_delete_fbs(1, &s_rp_fbo[slot]); s_rp_fbo[slot] = 0; }
+    if (s_rp_tex[slot]) { glDeleteTextures(1, &s_rp_tex[slot]); s_rp_tex[slot] = 0; }
+    s_rp_tex[slot] = make_tex(GL_RGBA8, tw, th, GL_RGBA, GL_UNSIGNED_BYTE);
+    make_fbo(&s_rp_fbo[slot], s_rp_tex[slot], 0);
+    s_rp_tw[slot] = tw; s_rp_th[slot] = th;
+}
+
+static void wide_blit_center(GLuint wide_fbo, int base_x, int disp_y, int disp_h);
+
+/* Copy a displayed-frame rect (native coords) of the current present path into
+ * an rp texture. y is the top of the band to copy. */
+static int rp_copy_band(int slot, int y) {
+    int S = s_scale > 0 ? s_scale : 1;
+    GLuint src = 0;
+    int x = 0;
+    if (s_rp_path == GL_PRES_WIDE) {
+        for (int i = 0; i < WIDE_MAX_SURF; i++)
+            if (s_wide_fbo[i] && s_wide_base[i] == s_rp_base_x) src = s_wide_fbo[i];
+        if (!src) return 0;
+        rr_cow_wide(src, y, y + s_rp_h - 1);
+        wide_blit_center(src, s_rp_base_x, y, s_rp_h);
+    } else {
+        src = s_hr_fbo;
+        x = s_rp_base_x;
+    }
+    rp_ensure_tex(slot, s_rp_w * S, s_rp_h * S);
+    gs_bind_fb(PSXGL_READ_FRAMEBUFFER, src);
+    gs_bind_fb(PSXGL_DRAW_FRAMEBUFFER, s_rp_fbo[slot]);
+    gs_disable(GL_SCISSOR_TEST);
+    p_glBlitFramebuffer(x * S, y * S, (x + s_rp_w) * S, (y + s_rp_h) * S,
+                        0, 0, s_rp_w * S, s_rp_h * S, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    gs_bind_fb(PSXGL_READ_FRAMEBUFFER, 0);
+    gs_bind_fb(PSXGL_DRAW_FRAMEBUFFER, 0);
+    s_rp_valid[slot] = 1;
+    s_rp_gen[slot]++;
+    return 1;
+}
+
+int gl_replay_end(int capture) {
+    int ok = 0;
+    if (!s_rr_active) return 0;
+    flush_flat_batch();
+    flush_tex_batch();
+    flush_cpu_upload();
+    if (s_rr_areas > 1) {
+        /* Diagnostic: a replay whose primitives land in more than one draw area. */
+        int n = 0;
+        s_rr_multi++;
+        for (int i = 0; i < s_rr_areas && n < (int)sizeof s_rr_multi_last - 24; i++)
+            n += snprintf(s_rr_multi_last + n, sizeof s_rr_multi_last - n, "%d,%d:%d ",
+                          s_rr_area_x[i], s_rr_area_y[i], s_rr_area_n[i]);
+    }
+    if (capture && s_rr_areas > 0) {
+        int best = 0;
+        for (int i = 1; i < s_rr_areas; i++) if (s_rr_area_n[i] > s_rr_area_n[best]) best = i;
+        s_rr_last_x = s_rr_area_x[best]; s_rr_last_y = s_rr_area_y[best];
+        /* Present geometry is the real displayed frame's; the replay drew a
+         * frame of the same size whose top-left is its busiest draw area. */
+        if (s_rp_path == GL_PRES_WIDE || s_rr_area_x[best] == s_rp_base_x)
+            ok = rp_copy_band(s_rp_capture_slot, s_rr_area_y[best]);
+    }
+    if (rr_cow_enabled()) {
+        gs_disable(GL_SCISSOR_TEST);
+        rr_cow_restore();
+        rr_blit(s_rr_raw_fbo, s_raw_fbo, VRAM_W, VRAM_H, GL_COLOR_BUFFER_BIT);
+        gs_bind_fb(PSXGL_READ_FRAMEBUFFER, 0);
+        gs_bind_fb(PSXGL_DRAW_FRAMEBUFFER, 0);
+    } else {
+        rr_copy_surfaces(0);
+    }
+    if (rr_check_enabled()) {
+        s_rr_check_runs++;
+        if (rr_surfaces_hash() != s_rr_check_before) s_rr_check_bad++;
+    }
+    memcpy(s_vram, s_rr_cpu, (size_t)VRAM_W * VRAM_H * sizeof(uint16_t));
+    s_off_x = s_rr_st.off_x; s_off_y = s_rr_st.off_y;
+    s_area_x1 = s_rr_st.area_x1; s_area_y1 = s_rr_st.area_y1;
+    s_area_x2 = s_rr_st.area_x2; s_area_y2 = s_rr_st.area_y2;
+    s_semi_en = s_rr_st.semi_en; s_semi_mode = s_rr_st.semi_mode;
+    s_mod_r = s_rr_st.mod_r; s_mod_g = s_rr_st.mod_g; s_mod_b = s_rr_st.mod_b; s_mod_raw = s_rr_st.mod_raw;
+    s_mask_set = s_rr_st.mask_set; s_mask_check = s_rr_st.mask_check;
+    s_tw_mask_x = s_rr_st.tw_mask_x; s_tw_mask_y = s_rr_st.tw_mask_y;
+    s_tw_off_x = s_rr_st.tw_off_x; s_tw_off_y = s_rr_st.tw_off_y;
+    s_tex_filter = s_rr_st.tex_filter; s_stencil_valid = s_rr_st.stencil_valid;
+    s_gpu_dirty = s_rr_st.gpu_dirty; s_pc_valid = s_rr_st.pc_valid; s_pq_valid = s_rr_st.pq_valid;
+    s_wide_suppress = s_rr_st.wide_suppress;
+    g_wide_cur = s_rr_st.wide_cur; g_wide_cur_base = s_rr_st.wide_cur_base;
+    s_pack_dirty = s_rr_st.pack_dirty;
+    s_hz_clear_pending = s_rr_st.hz_clear_pending;
+    sw_set_draw_offset(s_off_x, s_off_y);
+    s_rr_active = 0;
+    rq_end();
+    return ok;
+}
