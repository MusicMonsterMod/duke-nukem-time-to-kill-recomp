+int gl_replay_begin(void) {
+    if (!s_ctx || !s_raster_ok || s_rr_active || s_cpu_auth_dual || s_rp_path < 0) return 0;
+    flush_flat_batch();
+    flush_tex_batch();
+    flush_cpu_upload();
