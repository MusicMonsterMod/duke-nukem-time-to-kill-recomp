+/* Copy-on-write save of what a replay session writes. Saving every surface
+ * whole (hr colour + stencil, each native-wide surface) in and out of every
+ * session moved about 300 MB per redraw at 4x and saturated the GPU's memory
+ * bus at 180 Hz. A session only writes its draw areas, fill/copy/upload
+ * destinations and the row bands of the wide surface it mirrors into, so each
+ * of those is saved the first time it is written and restored in reverse
+ * order at the end (an overlap is then restored from the earliest save, taken
+ * before any write). PSX_REPLAY_COW=0 keeps the whole-surface copies;
+ * PSX_REPLAY_COW_CHECK=1 (developer) reads the surfaces back before and after
+ * each session and counts any pixel the restore got wrong. */
+#define RR_COW_MAX 48
+typedef struct { int surf, x0, y0, x1, y1; } RrCow;   /* surf -1 = hr, else wide index */
+static RrCow    s_rr_cow[RR_COW_MAX];
+static int      s_rr_cow_n = 0, s_rr_cow_on = -1, s_rr_cow_check = -1;
+static uint64_t s_rr_cow_sessions = 0, s_rr_cow_rects = 0, s_rr_cow_pixels = 0;
+static uint64_t s_rr_check_runs = 0, s_rr_check_bad = 0;
+static uint8_t *s_rr_check_buf = NULL;
+
+static int rr_cow_enabled(void) {
+    if (s_rr_cow_on < 0) { const char *e = getenv("PSX_REPLAY_COW"); s_rr_cow_on = !(e && e[0] == '0'); }
+    return s_rr_cow_on;
+}
+static void rr_rect_blit(GLuint src, GLuint dst, int x0, int y0, int x1, int y1) {
+    int S = s_rr_scale;
+    gs_disable(GL_SCISSOR_TEST);
+    gs_bind_fb(PSXGL_READ_FRAMEBUFFER, src);
+    gs_bind_fb(PSXGL_DRAW_FRAMEBUFFER, dst);
+    p_glBlitFramebuffer(x0 * S, y0 * S, (x1 + 1) * S, (y1 + 1) * S,
+                        x0 * S, y0 * S, (x1 + 1) * S, (y1 + 1) * S,
+                        GL_COLOR_BUFFER_BIT | GL_STENCIL_BUFFER_BIT | GL_DEPTH_BUFFER_BIT, GL_NEAREST);
