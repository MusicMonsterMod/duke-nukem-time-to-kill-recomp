@@ -116,6 +116,39 @@ def main():
         raise SystemExit("dispatch table is not sorted by physical address; "
                          "the masked binary search would miss entries")
 
+    # Execute the emitted lookup, including repeated aliases and cache misses.
+    # The oracle is a simple scan of the immutable fixture table.
+    with tempfile.TemporaryDirectory() as tmp:
+        c = os.path.join(tmp, "lookup.c")
+        exe = os.path.join(tmp, "lookup")
+        table = ",".join("{0x%08Xu}" % (k | 0x80000000) for k in keys)
+        harness = """#include <stdint.h>
+#include <stddef.h>
+typedef struct { uint32_t addr; } PsxGameDispatchEntry;
+static const PsxGameDispatchEntry k_psx_game_dispatch[] = {@TABLE@};
+#define PSX_GAME_DISPATCH_COUNT @COUNT@
+static const PsxGameDispatchEntry* psx_game_find_entry(uint32_t addr) {@BODY@
+}
+int main(void) {
+ uint32_t seed=1;
+ for(unsigned i=0;i<100000;i++) {
+  seed=seed*1664525u+1013904223u;
+  uint32_t a=i%3 ? k_psx_game_dispatch[i%PSX_GAME_DISPATCH_COUNT].addr : seed;
+  if(i%4==0) a&=0x1fffffffu;
+  if(i%4==1) a=(a&0x1fffffffu)|0xa0000000u;
+  if(i%7==0) a+=1;
+  const PsxGameDispatchEntry *expected=0;
+  for(unsigned k=0;k<PSX_GAME_DISPATCH_COUNT;k++)
+   if((k_psx_game_dispatch[k].addr&0x1fffffffu)==(a&0x1fffffffu)) expected=&k_psx_game_dispatch[k];
+  if(psx_game_find_entry(a)!=expected) return 1;
+ }
+ return 0;
+}
+""".replace("@TABLE@", table).replace("@COUNT@", str(len(keys))).replace("@BODY@", body)
+        with open(c,"w") as out: out.write(harness)
+        subprocess.run([os.environ.get("CC","cc"),"-O2",c,"-o",exe],check=True)
+        subprocess.run([exe],check=True)
+
     print("KUSEG dispatch lookup test passed (%d entries, physical-keyed)" % len(keys))
 
 
