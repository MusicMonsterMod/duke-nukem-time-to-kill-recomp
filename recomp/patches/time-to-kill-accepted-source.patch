+        "{\"display\": \"%s\", \"fullscreen_mode\": \"%s\", \"window_width\": %d}\n",
+        fullscreen ? kind_name : "windowed", kind_name, width) > 0;
+    if (std::fclose(file) == 0 && ok)
+        std::rename(temporary.c_str(), s_presentation_state_path.c_str());
