+        gs_bind_fb(PSXGL_READ_FRAMEBUFFER, s_rp_fbo[fs]);
+        gs_bind_fb(PSXGL_DRAW_FRAMEBUFFER, s_rp_fbo[ts]);
+        gs_disable(GL_SCISSOR_TEST);
+        p_glBlitFramebuffer(0, 0, tw, th, 0, 0, tw, th, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+        gs_bind_fb(PSXGL_READ_FRAMEBUFFER, 0);
+        gs_bind_fb(PSXGL_DRAW_FRAMEBUFFER, 0);
+    }
+    s_rp_valid[ts] = 1;
+    s_rp_gen[ts]++;
+    return 1;
+}
