diff --git a/runtime/src/ttk_texture_sample.h b/runtime/src/ttk_texture_sample.h
new file mode 100644
index 00000000..c82c70d9
--- /dev/null
+++ b/runtime/src/ttk_texture_sample.h
@@ -0,0 +1,69 @@
+/* D16 local texture specimen. No guest writes, pack discovery or save payload.
+ * Wire: TTKTX01\0, 11 little-endian u32 fields, source words, CLUT words, RGB8.
+ * Location narrows candidates; exact source/CLUT bytes authorize replacement.
+ * This bounded first path supports one non-wrapping region, nearest RGB edits,
+ * and leaves original cutout/STP semantics authoritative. */
+#ifndef TTK_TEXTURE_SAMPLE_H
+#define TTK_TEXTURE_SAMPLE_H
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct TtkTextureSample {
+    unsigned depth, page_x, page_y, u, v, w, h, cx, cy, iw, ih;
+    unsigned x, y, words_w, palette_n;
+    uint16_t *source, *palette;
+    unsigned char *rgb;
+} TtkTextureSample;
+
+static void ttk_texture_sample_free(TtkTextureSample *s) {
+    free(s->source); free(s->palette); free(s->rgb); memset(s,0,sizeof(*s));
+}
+static int ttk_texture_sample_read32(FILE *f, unsigned *out) {
+    unsigned char b[4]; if(fread(b,1,4,f)!=4) return 0;
+    *out=(unsigned)b[0]|((unsigned)b[1]<<8)|((unsigned)b[2]<<16)|((unsigned)b[3]<<24);
+    return 1;
+}
+static int ttk_texture_sample_words(FILE *f, uint16_t *out, size_t n) {
+    for(size_t i=0;i<n;i++) {
+        int a=fgetc(f),b=fgetc(f); if(a<0||b<0) return 0;
+        out[i]=(uint16_t)(a|(b<<8));
+    }
+    return 1;
+}
+static int ttk_texture_sample_load(const char *path, TtkTextureSample *out) {
+    TtkTextureSample s={0}; unsigned char magic[8]; int ok=0;
+    FILE *f=fopen(path,"rb"); if(!f) return 0;
+    unsigned *fields[]={&s.depth,&s.page_x,&s.page_y,&s.u,&s.v,&s.w,&s.h,&s.cx,&s.cy,&s.iw,&s.ih};
+    if(fread(magic,1,8,f)!=8||memcmp(magic,"TTKTX01\0",8)) goto done;
+    for(unsigned i=0;i<11;i++) if(!ttk_texture_sample_read32(f,fields[i])) goto done;
+    if(s.depth>2 || s.page_x>960 || s.page_x%64 || (s.page_y!=0&&s.page_y!=256) ||
+       s.u>255||s.v>255||!s.w||!s.h||s.w>256-s.u||s.h>256-s.v||
+       s.cx>1023||s.cy>511||!s.iw||!s.ih||s.iw>1024||s.ih>1024||
+       s.iw%s.w||s.ih%s.h||s.iw/s.w!=s.ih/s.h) goto done;
+    unsigned ppw=4u>>s.depth;
+    if(s.u%ppw||s.w%ppw) goto done;
+    s.x=s.page_x+s.u/ppw; s.y=s.page_y+s.v; s.words_w=s.w/ppw;
+    s.palette_n=s.depth==0?16:s.depth==1?256:0;
+    if(s.x+s.words_w>1024||s.y+s.h>512||s.cx+s.palette_n>1024) goto done;
+    size_t n=(size_t)s.words_w*s.h, bytes=(size_t)s.iw*s.ih*3;
+    s.source=(uint16_t*)malloc(n*2);
+    s.palette=(uint16_t*)malloc((s.palette_n?s.palette_n:1)*2);
+    s.rgb=(unsigned char*)malloc(bytes);
+    if(!s.source||!s.palette||!s.rgb||!ttk_texture_sample_words(f,s.source,n)||
+       !ttk_texture_sample_words(f,s.palette,s.palette_n)||fread(s.rgb,1,bytes,f)!=bytes||fgetc(f)!=EOF) goto done;
+    *out=s; memset(&s,0,sizeof(s)); ok=1;
+done:
+    fclose(f); ttk_texture_sample_free(&s); return ok;
+}
+static int ttk_texture_sample_intersects(const TtkTextureSample *s,int x0,int y0,int x1,int y1) {
+    if(!s->source||x0>x1||y0>y1) return 0;
+    return (x0<(int)(s->x+s->words_w)&&x1>=(int)s->x&&y0<(int)(s->y+s->h)&&y1>=(int)s->y)||
+           (s->palette_n&&x0<(int)(s->cx+s->palette_n)&&x1>=(int)s->cx&&y0<=(int)s->cy&&y1>=(int)s->cy);
+}
+static int ttk_texture_sample_equal(const TtkTextureSample *s,const uint16_t *source,const uint16_t *palette) {
+    return !memcmp(s->source,source,(size_t)s->words_w*s->h*2)&&
+           (!s->palette_n||!memcmp(s->palette,palette,s->palette_n*2));
+}
+#endif
diff --git a/runtime/tests/test_dirty_text_restore.py b/runtime/tests/test_dirty_text_restore.py
new file mode 100644
index 00000000..7cf303c3
--- /dev/null
+++ b/runtime/tests/test_dirty_text_restore.py
@@ -0,0 +1,91 @@
+#!/usr/bin/env python3
+"""Execute the actual restore/native-range guards against bypassed RAM writes."""
+from pathlib import Path
+import os
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+src = (root / 'runtime/src/memory.c').read_text()
+a = src.index('void dirty_ram_text_guard_resync_after_restore(void) {')
+b = src.index('\nvoid overlay_watch_invalidate_after_ram_restore', a)
+restore = src[a:b]
+# D23G: the guard is now fronted by a positive-result cache.
+a = src.index('/* D23G: positive results')
+b = src.index('\n/* Preserve the generated-code ABI', a)
+guard = src[a:b]
+loader = (root / 'runtime/src/overlay_loader.c').read_text()
+a = loader.index('static int dispatch_cache_window_contains(')
+b = loader.index('\n}', a) + 2
+eligibility = loader[a:b]
+a = loader.index('int overlay_loader_prepare_address(')
+b = loader.index('\n}', a) + 2
+prepare = loader[a:b]
+code = r'''
+#include <stdint.h>
+#include <string.h>
+#include <assert.h>
+#include <stdlib.h>
+#define DIRTY_RAM_PAGE_SHIFT 12
+static uint8_t ram[12288], reference[5000];
+static uint8_t *text_ref_image=reference;
+static uint32_t text_ref_lo=100,text_ref_hi=5100;
+static uint32_t text_modified_bitmap[1],text_diverged_bitmap[1];
+static uint32_t g_text_diverged_pages,g_text_native_blocked,g_text_exact_mismatches;
+static uint32_t g_text_exact_last_range_lo,g_text_exact_last_range_len;
+static uint32_t g_text_exact_last_mismatch,g_text_exact_last_live,g_text_exact_last_ref;
+static uint32_t s_text_native_gen=1;
+uint32_t g_dirty_ram_code_gen=1,g_overlay_region_floor;
+static int aot_blocked(uint32_t x) {(void)x;return 0;}
+static int dirty_ram_is_dirty(uint32_t x) {(void)x;return 0;}
+''' + restore + guard + r'''
+static int overlay_cache_window_contains(uint32_t p) {return p>=8192 && p<12288;}
+uint32_t dirty_ram_text_modified_bitmap_word(uint32_t w) {return w<1?text_modified_bitmap[w]:0;}
+''' + eligibility + r'''
+static int s_active,prepared,attempts;
+static int idx_head(uint32_t p) {(void)p;return prepared?0:-1;}
+static int try_load_region(uint32_t p) {(void)p;++attempts;return 1;}
+''' + prepare + r'''
+int main(void) {
+ const uint32_t ranges[]={128,64,4100,128};
+ memset(ram,0xa5,sizeof ram);memset(reference,0xa5,sizeof reference);
+ dirty_ram_text_guard_resync_after_restore();
+ assert(dirty_ram_text_native_ok_ranges_from(ranges,2,128));
+ /* A memcpy/savestate write never ran the store observer. */
+ ram[130]^=1;
+ dirty_ram_text_guard_resync_after_restore();
+ assert(!dirty_ram_text_native_ok_ranges_from(ranges,2,128));
+ assert(g_text_exact_last_mismatch==130);
+ assert(dispatch_cache_window_contains(128));
+ assert(!overlay_loader_prepare_address(0x80000080));assert(!attempts);
+ s_active=1;assert(overlay_loader_prepare_address(0x80000080));assert(attempts==1);
+ prepared=1;assert(overlay_loader_prepare_address(0x80000080));assert(attempts==1);
+ assert(!dispatch_cache_window_contains(4096));
+ assert(dispatch_cache_window_contains(8192));
+ assert(!dispatch_cache_window_contains(0x1fc00000));
+ ram[130]^=1;text_diverged_bitmap[0]=~0u;
+ dirty_ram_text_guard_resync_after_restore();
+ assert(dirty_ram_text_native_ok_ranges_from(ranges,2,128));
+ assert(text_diverged_bitmap[0]==0);
+ assert(!dispatch_cache_window_contains(128));
+ /* Data on the same page must not invalidate this function's code ranges. */
+ ram[300]^=1;
+ dirty_ram_text_guard_resync_after_restore();
+ assert(dirty_ram_text_native_ok_ranges_from(ranges,2,128));
+ const uint32_t changed[]={300,4};
+ assert(!dirty_ram_text_native_ok_ranges_from(changed,1,300));
+ ram[300]^=1;ram[20]^=1;ram[6000]^=1;
+ dirty_ram_text_guard_resync_after_restore();
+ assert(text_modified_bitmap[0]==0); /* Outside the registered partial pages. */
+ ram[4150]^=1;
+ dirty_ram_text_guard_resync_after_restore();
+ assert(!dirty_ram_text_native_ok_ranges_from(ranges,2,128));
+ return 0;
+}
+'''
+with tempfile.TemporaryDirectory() as tmp:
+    path = Path(tmp)
+    (path / 'test.c').write_text(code)
+    subprocess.run([os.environ.get('CC', 'cc'), '-O2', str(path / 'test.c'), '-o', str(path / 'test')], check=True)
+    subprocess.run([str(path / 'test')], check=True)
+print('dirty-text restore guards: passed')
