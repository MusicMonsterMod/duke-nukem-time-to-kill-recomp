+        debug_console_say("  endlevel    Finish the level (statistics screen)");
+        debug_console_say("  fps         Toggle FPS statistics");
+        debug_console_say("  help        Show available commands");
+        debug_console_say("  history     List typed commands (Up/Down recall them)");
+        debug_console_say("  items       List items spawn can create here");
+        debug_console_say("  levels      List levels for level select");
+        debug_console_say("  level N     Travel to level N");
+        debug_console_say("  palfrom I R G B  Flash the screen, Duke3D units (alias flash)");
+        debug_console_say("  quickload   Load the last slot used (F9)");
+        debug_console_say("  quicksave   Save over the last slot used (F6)");
+        debug_console_say("  quit        Exit the game");
+        debug_console_say("  renderer R  Switch renderer: polymorph or classic (this session)");
+        debug_console_say("  spawn X     Spawn item X (name or type) in front of Duke");
+    } else if (!std::strcmp(s_console_line, "clear")) {
+        host_osd_console_clear();
