+/* The logical CPUs this process may run on (its affinity on Linux, else
+ * SDL's count); cached. Used for the render-thread count and, D23P, the
+ * AUTO frame rate's CPU budget (replay_rate.h). */
+int psx_host_cpus(void) {
+    static int cpus = -1;
+    if (cpus >= 0) return cpus;
+    int n = 0;
+#if defined(__linux__)
+    cpu_set_t set;
+    if (sched_getaffinity(0, sizeof set, &set) == 0) n = CPU_COUNT(&set);
+#endif
+#if defined(PSX_SDL3)
+    if (n <= 0) n = SDL_GetNumLogicalCPUCores();
+#else
+    if (n <= 0) n = SDL_GetCPUCount();
+#endif
+    cpus = n > 0 ? n : 1;
+    return cpus;
+}
