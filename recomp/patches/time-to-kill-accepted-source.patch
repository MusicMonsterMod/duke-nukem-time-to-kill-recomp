+    flush_tex_batch();
+    flush_cpu_upload();
+    ph_mark(2);
+    if (s_rr_areas > 1) {
+        /* Diagnostic: a replay whose primitives land in more than one draw area. */
+        int n = 0;
+        s_rr_multi++;
+        for (int i = 0; i < s_rr_areas && n < (int)sizeof s_rr_multi_last - 24; i++)
+            n += snprintf(s_rr_multi_last + n, sizeof s_rr_multi_last - n, "%d,%d:%d ",
+                          s_rr_area_x[i], s_rr_area_y[i], s_rr_area_n[i]);
+    }
+    if (capture && s_rr_areas > 0) {
+        int best = 0;
+        for (int i = 1; i < s_rr_areas; i++) if (s_rr_area_n[i] > s_rr_area_n[best]) best = i;
+        s_rr_last_x = s_rr_area_x[best]; s_rr_last_y = s_rr_area_y[best];
+        /* Present geometry is the real displayed frame's; the replay drew a
+         * frame of the same size whose top-left is its busiest draw area. */
+        if (s_rp_path == GL_PRES_WIDE || s_rr_area_x[best] == s_rp_base_x)
