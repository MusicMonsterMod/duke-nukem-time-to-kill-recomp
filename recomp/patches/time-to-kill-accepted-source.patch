+    s_off_x = s_rr_st.off_x; s_off_y = s_rr_st.off_y;
+    s_area_x1 = s_rr_st.area_x1; s_area_y1 = s_rr_st.area_y1;
+    s_area_x2 = s_rr_st.area_x2; s_area_y2 = s_rr_st.area_y2;
+    s_semi_en = s_rr_st.semi_en; s_semi_mode = s_rr_st.semi_mode;
+    s_mod_r = s_rr_st.mod_r; s_mod_g = s_rr_st.mod_g; s_mod_b = s_rr_st.mod_b; s_mod_raw = s_rr_st.mod_raw;
+    s_mask_set = s_rr_st.mask_set; s_mask_check = s_rr_st.mask_check;
+    s_tw_mask_x = s_rr_st.tw_mask_x; s_tw_mask_y = s_rr_st.tw_mask_y;
+    s_tw_off_x = s_rr_st.tw_off_x; s_tw_off_y = s_rr_st.tw_off_y;
+    s_tex_filter = s_rr_st.tex_filter; s_stencil_valid = s_rr_st.stencil_valid;
+    s_gpu_dirty = s_rr_st.gpu_dirty; s_pc_valid = s_rr_st.pc_valid; s_pq_valid = s_rr_st.pq_valid;
