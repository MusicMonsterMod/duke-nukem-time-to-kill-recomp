+            int d=0;for(int c=0;c<3;c++){int e=abs((int)first[i+c]-(int)next[i+c]);if(e>d)d=e;}
+            if(d){n++;if(d>maxd)maxd=d;const int px=(int)(i/4);const int x=px%w,y=px/w;if(x<x0)x0=x;if(x>x1)x1=x;if(y<y0)y0=y;if(y>y1)y1=y;}
+        }
+        fprintf(stderr,"[rt validate] %zu pixels differ (max %d levels), box %d,%d-%d,%d of %dx%d\n",n,maxd,x0,y0,x1,y1,w,s_rp_th[slot]);
+        static int dumps=0;const char *dd=getenv("PSX_RT_VALIDATE_DUMP");
+        if(dd && dumps<4) {char path[512];snprintf(path,sizeof path,"%s/rtval-%d-%dx%d.rgba",dd,dumps++,w,s_rp_th[slot]);
+            FILE *f=fopen(path,"wb");if(f){fwrite(first,1,bytes,f);fwrite(next,1,bytes,f);fclose(f);}}
+    }
+    return 0;
+}
