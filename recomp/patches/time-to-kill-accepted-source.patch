+/* gpu_snapshot_read re-applies GP0 draw area after gl_replay_end. That is
+ * renderer state synchronization, not a new guest frame. Undo only the
+ * synthetic clear request, preserving a genuine pending live-frame clear. */
+void gl_replay_resume(void) {
+    s_hz_clear_pending=s_rr_st.hz_clear_pending;
+}
+
+void gl_replay_last_area(int *x, int *y) { if (x) *x = s_rr_last_x; if (y) *y = s_rr_last_y; }
+uint64_t gl_replay_multi_area(const char **last) { if (last) *last = s_rr_multi_last; return s_rr_multi; }
+/* The provider's image cache: the next capture lands in cache entry c. */
+int gl_replay_set_capture_cache(int c) {
+    if (c < 0 || c >= RP_CACHE) return 0;
+    s_rp_capture_slot = c + 1;
+    s_rp_valid[c + 1] = 0;   /* the entry is being replaced */
+    return 1;
+}
+void gl_replay_reset_capture_cache(void) { s_rp_capture_slot = 1; }
+int gl_replay_cache_valid(int c) { return c >= 0 && c < RP_CACHE && s_rp_valid[c + 1]; }
+/* Developer oracle: redraw the identical recorded stream with/without ordered
+ * batching and compare the complete RGBA result. Never used during normal play. */
+int gl_replay_ordered_semi(int enabled) {
+    int old=s_ordered_semi_batch;
+    s_ordered_semi_batch=enabled;
+    return old;
+}
+int gl_replay_compare_cache(int cache, int second) {
+    static unsigned char *first=0,*next=0;
+    static size_t capacity=0,first_size=0;
+    if(!gl_replay_cache_valid(cache)) return 0;
+    int slot=cache+1;
+    size_t bytes=(size_t)s_rp_tw[slot]*s_rp_th[slot]*4;
+    if(bytes>capacity) {
+        free(first);free(next);first=malloc(bytes);next=malloc(bytes);capacity=bytes;
+    }
+    if(!first || !next) return 0;
+    gs_bind_fb(PSXGL_READ_FRAMEBUFFER,s_rp_fbo[slot]);
+    glReadPixels(0,0,s_rp_tw[slot],s_rp_th[slot],GL_RGBA,GL_UNSIGNED_BYTE,second?next:first);
+    gs_bind_fb(PSXGL_READ_FRAMEBUFFER,0);
+    if(!second) {first_size=bytes;return 1;}
+    return bytes==first_size && memcmp(first,next,bytes)==0;
+}
