new file mode 100644
index 00000000..06ec3fbd
--- /dev/null
+++ b/runtime/src/host_profiler.c
@@ -0,0 +1,151 @@
+/* host_profiler.c - developer sampling profiler for the emulation thread.
+ *
+ * PSX_PROF=FILE samples the thread that calls host_profiler_start() every 1 ms
+ * of its CPU time (SIGPROF from a thread CPU-clock timer) and, at exit, writes
+ * one line per sampled program counter: "count offset" where offset is
+ * relative to the executable's load base (symbolize with addr2line -f -e EXE).
+ * Inert unless the variable is set. Linux only. */
+#if defined(__linux__)
+#define _GNU_SOURCE 1
+#include <execinfo.h>
+#include <link.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <time.h>
+#include <ucontext.h>
+#include <unistd.h>
+
+#define PROF_SLOTS (1u << 16)
+static uintptr_t s_pc[PROF_SLOTS];
+static uint32_t  s_count[PROF_SLOTS];
+static volatile uint64_t s_samples = 0, s_dropped = 0;
+static uintptr_t s_base = 0;
+static const char *s_out = NULL;
+/* PSX_PROF_CALLERS=1: samples outside the executable (GL driver, libc, vDSO)
+ * are also attributed to the nearest executable frame on the stack. */
+static int s_callers = 0;
+/* PSX_PROF_REPLAY=1: only sample while a D17 redraw is being fed. */
+static int s_replay_only = 0;
+extern int g_render_replay_active;
+static uintptr_t s_exe_lo = 0, s_exe_hi = 0;
+#define CALLER_SLOTS (1u << 14)
+static uintptr_t s_cpc[CALLER_SLOTS];
+static uint32_t  s_ccount[CALLER_SLOTS];
+
+static void note_caller(uintptr_t pc) {
+    uint32_t h = (uint32_t)((pc >> 2) * 2654435761u) & (CALLER_SLOTS - 1u);
+    for (uint32_t i = 0; i < 64; i++) {
+        uint32_t k = (h + i) & (CALLER_SLOTS - 1u);
+        if (s_cpc[k] == pc) { s_ccount[k]++; return; }
+        if (s_cpc[k] == 0) { s_cpc[k] = pc; s_ccount[k] = 1; return; }
+    }
+}
+
+static uint64_t s_first_frame=0,s_last_frame=0;
+extern uint64_t s_frame_count;
+static void on_prof(int sig, siginfo_t *si, void *ctx) {
+    (void)sig; (void)si;
+    if(s_frame_count<s_first_frame || (s_last_frame && s_frame_count>s_last_frame)) return;
+    if (s_replay_only && !g_render_replay_active) return;
+    ucontext_t *uc = (ucontext_t *)ctx;
+#if defined(__x86_64__)
+    uintptr_t pc = (uintptr_t)uc->uc_mcontext.gregs[REG_RIP];
+#elif defined(__aarch64__)
+    uintptr_t pc = (uintptr_t)uc->uc_mcontext.pc;
+#else
+    uintptr_t pc = 0;
+#endif
+    if (s_callers && (pc < s_exe_lo || pc >= s_exe_hi)) {
+        void *bt[48];
+        int n = backtrace(bt, 48);
+        for (int i = 2; i < n; i++) {
+            uintptr_t f = (uintptr_t)bt[i];
+            if (f >= s_exe_lo && f < s_exe_hi) { note_caller(f); break; }
+        }
+    }
+    uint32_t h = (uint32_t)((pc >> 2) * 2654435761u) & (PROF_SLOTS - 1u);
+    for (uint32_t i = 0; i < 64; i++) {
+        uint32_t k = (h + i) & (PROF_SLOTS - 1u);
+        if (s_pc[k] == pc) { s_count[k]++; s_samples++; return; }
+        if (s_pc[k] == 0) { s_pc[k] = pc; s_count[k] = 1; s_samples++; return; }
+    }
+    s_dropped++;
+}
+
+static int find_base(struct dl_phdr_info *info, size_t size, void *data) {
+    (void)size; (void)data;
+    if (info->dlpi_name == NULL || info->dlpi_name[0] == 0) {
+        s_base = info->dlpi_addr;
+        for (int i = 0; i < info->dlpi_phnum; i++) {
+            const ElfW(Phdr) *ph = &info->dlpi_phdr[i];
+            if (ph->p_type != PT_LOAD || !(ph->p_flags & PF_X)) continue;
+            uintptr_t lo = s_base + ph->p_vaddr, hi = lo + ph->p_memsz;
+            if (!s_exe_lo || lo < s_exe_lo) s_exe_lo = lo;
+            if (hi > s_exe_hi) s_exe_hi = hi;
+        }
+        return 1;
+    }
+    return 0;
+}
+
+static void write_profile(void) {
+    if (!s_out) return;
+    FILE *f = fopen(s_out, "w");
+    if (!f) return;
+    fprintf(f, "# samples %llu dropped %llu base 0x%llx\n",
+            (unsigned long long)s_samples, (unsigned long long)s_dropped,
+            (unsigned long long)s_base);
+    for (uint32_t k = 0; k < PROF_SLOTS; k++)
+        if (s_pc[k]) fprintf(f, "%u 0x%llx 0x%llx\n", s_count[k], (unsigned long long)(s_pc[k] - s_base),
+                             (unsigned long long)s_pc[k]);
+    for (uint32_t k = 0; k < CALLER_SLOTS; k++)
+        if (s_cpc[k]) fprintf(f, "#caller %u 0x%llx\n", s_ccount[k], (unsigned long long)(s_cpc[k] - s_base));
+    /* Module map for samples outside the executable. */
+    FILE *m = fopen("/proc/self/maps", "r");
+    if (m) {
+        char line[512];
+        while (fgets(line, sizeof line, m)) fprintf(f, "#map %s", line);
+        fclose(m);
+    }
+    fclose(f);
+}
+
+void host_profiler_start(void) {
+    s_out = getenv("PSX_PROF");
+    if (!s_out || !*s_out) return;
+    memset(s_pc,0,sizeof s_pc);memset(s_count,0,sizeof s_count);
+    memset(s_cpc,0,sizeof s_cpc);memset(s_ccount,0,sizeof s_ccount);
+    s_samples=s_dropped=0;
+    const char *first=getenv("PSX_PROF_FIRST_FRAME"), *last=getenv("PSX_PROF_LAST_FRAME");
+    s_first_frame=first?strtoull(first,NULL,10):0;
+    s_last_frame=last?strtoull(last,NULL,10):0;
+    dl_iterate_phdr(find_base, NULL);
+    { const char *c = getenv("PSX_PROF_CALLERS"); s_callers = c && c[0] == '1'; }
+    { const char *c = getenv("PSX_PROF_REPLAY"); s_replay_only = c && c[0] == '1'; }
+    if (s_callers) { void *warm[4]; backtrace(warm, 4); }   /* load the unwinder now */
+    struct sigaction sa;
+    memset(&sa, 0, sizeof sa);
+    sa.sa_sigaction = on_prof;
+    sa.sa_flags = SA_SIGINFO | SA_RESTART;
+    sigaction(SIGPROF, &sa, NULL);
+    struct sigevent sev;
+    memset(&sev, 0, sizeof sev);
+    sev.sigev_notify = SIGEV_THREAD_ID;
+    sev.sigev_signo = SIGPROF;
+    sev._sigev_un._tid = (pid_t)syscall(SYS_gettid);
+    timer_t t;
