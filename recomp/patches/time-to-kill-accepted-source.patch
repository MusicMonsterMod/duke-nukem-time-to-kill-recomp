+static unsigned stores;
+static void gpu_host_vertex_store(uint32_t a,uint32_t w,int32_t x,int32_t y,float z,float u,float v,float d,float coverage) {
+ assert(a==0x80012340 && w==0xabcd && x==-123 && y==456);
+ got_z=z;got_depth=d;got_u=u;got_v=v;got_coverage=coverage;stores++;
+}
+static void gpu_set_gp0_source(uint32_t a) {(void)a;}
+static void gpu_write_gp0(uint32_t w) {(void)w;}
+static void gpu_ws_begin_linked_list(void) {}
+static void gpu_set_gp0_linked_list_node(uint32_t a,uint32_t b) {(void)a;(void)b;}
+static void gpu_ws_end_linked_list(void) {}
