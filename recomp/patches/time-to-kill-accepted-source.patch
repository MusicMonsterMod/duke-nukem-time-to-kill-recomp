+extern "C" void host_osd_console_scroll(int delta);
+static bool debug_console_event(const SDL_Event& ev) {
+#if defined(PSX_SDL3)
+    if (s_debug_console && ev.type == SDL_EVENT_MOUSE_WHEEL) {
+        const float wheel = ev.wheel.direction == SDL_MOUSEWHEEL_FLIPPED ? -ev.wheel.y : ev.wheel.y;
+#else
+    if (s_debug_console && ev.type == SDL_MOUSEWHEEL) {
+        const int wheel = ev.wheel.direction == SDL_MOUSEWHEEL_FLIPPED ? -ev.wheel.y : ev.wheel.y;
+#endif
+        if (wheel > 0) host_osd_console_scroll(3);
+        else if (wheel < 0) host_osd_console_scroll(-3);
+        return true;
+    }
+    /* D26J: focus/window events still reach input (focus loss releases). */
+#if defined(PSX_SDL3)
+    if (ev.type >= SDL_EVENT_WINDOW_FIRST && ev.type <= SDL_EVENT_WINDOW_LAST) return false;
+#else
+    if (ev.type == SDL_WINDOWEVENT) return false;
+#endif
+    if (ev.type != SDL_KEYDOWN) return s_debug_console;
+#if defined(PSX_SDL3)
+    SDL_Scancode scancode = ev.key.scancode;
+    const int key_repeat = ev.key.repeat ? 1 : 0;
+    const SDL_Keymod mod = ev.key.mod;
+#else
+    SDL_Scancode scancode = ev.key.keysym.scancode;
+    const int key_repeat = ev.key.repeat ? 1 : 0;
+    const Uint16 mod = ev.key.keysym.mod;
+#endif
+    if (!key_repeat && scancode == SDL_SCANCODE_GRAVE && !(mod & (KMOD_CTRL|KMOD_ALT|KMOD_GUI))) {
+        if (s_debug_console) debug_console_close();
+        else {
+            s_debug_console = true;
+            s_console_len = 0;
+            s_console_line[0] = 0;
+            s_console_recall = s_console_cmds.size();
