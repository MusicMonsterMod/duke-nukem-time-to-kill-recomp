+/* D23J: the render thread found a redraw identical to the image in cache entry
+ * `from` (same snapshot, same command stream): copy that image into `to`
+ * instead of drawing it again. */
+int gl_rt_copy_cache(int from, int to) {
+    const int fs = from + 1, ts = to + 1;
+    if (fs < 1 || fs > RP_CACHE || ts < 1 || ts > RP_CACHE || !s_rp_valid[fs] || !s_rp_tex[fs]) return 0;
+    if (fs == ts) return 1;
+    const int tw = s_rp_tw[fs], th = s_rp_th[fs];
+    rp_ensure_tex(ts, tw, th);
