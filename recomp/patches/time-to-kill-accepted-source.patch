+static void phc_collect(int i) {
+    for (int m = 0; m + 1 < s_phc_n[i]; m++) {
+        GLuint64 a = 0, b = 0;
+        p_glGetQueryObjectui64v(s_phc_q[i][m], GL_QUERY_RESULT, &a);
+        p_glGetQueryObjectui64v(s_phc_q[i][m + 1], GL_QUERY_RESULT, &b);
+        if (b > a) s_phc_sum[s_phc_cat[i][m]] += (double)(b - a) / 1e6;
+        if (s_phc_cat[i][m] != s_phc_cat[i][m + 1] || !m) s_phc_cnt[s_phc_cat[i][m + 1]]++;
+    }
