+/* Cadence over the last n presents: intervals in microseconds. */
+void gl_renderer_replay_cadence(int n, double out[8]) {
+    /* out: count, mean, p50, p95, p99, max, new-image share, replay share */
+    static double iv[RP_RING];
+    int have = (int)(s_rp_ring_n < RP_RING ? s_rp_ring_n : RP_RING);
+    if (n <= 0 || n > have - 1) n = have - 1;
+    for (int i = 0; i < 8; i++) out[i] = 0.0;
+    if (n <= 0) return;
+    uint64_t f = SDL_GetPerformanceFrequency();
+    int news = 0, reps = 0;
+    double sum = 0.0;
+    for (int i = 0; i < n; i++) {
+        uint32_t a = (s_rp_ring_n - 1u - (uint32_t)i) % RP_RING;
+        uint32_t b = (s_rp_ring_n - 2u - (uint32_t)i) % RP_RING;
+        iv[i] = f ? (double)(s_rp_ring_t[a] - s_rp_ring_t[b]) * 1e6 / (double)f : 0.0;
+        sum += iv[i];
+        if (s_rp_ring_kind[a] == 1) news++;
+        if (s_rp_ring_kind[a] == 2) reps++;
+    }
+    for (int i = 1; i < n; i++) {            /* insertion sort, n <= 2047 */
+        double v = iv[i]; int j = i - 1;
+        while (j >= 0 && iv[j] > v) { iv[j + 1] = iv[j]; j--; }
+        iv[j + 1] = v;
+    }
+    out[0] = n; out[1] = sum / n;
+    out[2] = iv[n / 2]; out[3] = iv[(int)(n * 0.95)]; out[4] = iv[(int)(n * 0.99)];
+    out[5] = iv[n - 1]; out[6] = (double)news / n; out[7] = (double)reps / n;
+}
