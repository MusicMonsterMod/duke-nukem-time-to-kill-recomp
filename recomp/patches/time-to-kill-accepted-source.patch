+/* render_replay.c - presentation-only guest render replay (Time to Kill D17).
+ * See render_replay.h. The MMIO policy below is the whole device contract of
+ * a replay: GP0 and GPU DMA execute synchronously into the (saved) VRAM, reads
+ * report an idle GPU and DMA, and every other device access is a no-op. */
+#include "render_replay.h"
+#include "pgxp.h"
+#include "gpu.h"
+#include "dma.h"
+#include "mod_memory.h"
+#include "psx_sdl.h"
+#include <string.h>
+#include <stdlib.h>
+
+extern uint32_t i_stat;
+extern uint32_t i_mask;
+extern uint32_t psx_read_word(uint32_t addr);
+
+int g_render_replay_active = 0;
+static RenderReplayStats s_stats;
+const RenderReplayStats *render_replay_stats(void) { return &s_stats; }
+RenderReplayStats *render_replay_stats_mut(void) { return &s_stats; }
+
+/* Replay-local GPU DMA channel registers (the live channel is never touched). */
+static uint32_t s_d2_madr, s_d2_bcr, s_d2_chcr;
+void render_replay_reset_channel(void) { s_d2_madr = s_d2_bcr = s_d2_chcr = 0; }
+
+/* Record mode (worker processes): GP0 traffic goes to a buffer instead of the
+ * GPU. Stream items: header (kind << 24 | count) then count words.
+ * kind 0 GP0 words, 1 linked list begin, 2 empty list node, 3 list end,
+ * 4 host precise vertex (addr, word, x16, y16, z, u, v, depth_z; floats as bits), 5 source address of
+ * the next run of GP0 words (emitted per list node once a session recorded
+ * host vertices, so the parent can match them to their packets). */
+int g_render_replay_record = 0;
+static uint32_t *s_rec = NULL;
+static uint32_t s_rec_cap = 0, s_rec_n = 0, s_rec_run = 0;
+static int s_rec_overflow = 0;
+static int s_rec_need_src = 0;
+void render_replay_record_begin(uint32_t *buf, uint32_t cap) {
+    s_rec = buf; s_rec_cap = cap; s_rec_n = 0; s_rec_run = UINT32_MAX; s_rec_overflow = 0;
+    s_rec_need_src = 0;
+    // Each frozen job starts with a new RAM image, never inherited precision.
+    if (g_pgxp_mesh_active) pgxp_invalidate_all();
+}
+uint32_t render_replay_record_end(int *overflow) {
+    if (overflow) *overflow = s_rec_overflow;
+    return s_rec_overflow ? 0u : s_rec_n;
+}
+static void rec_marker(uint32_t kind) {
+    if (s_rec_n + 1u > s_rec_cap) { s_rec_overflow = 1; return; }
+    s_rec[s_rec_n++] = kind << 24;
+    s_rec_run = UINT32_MAX;
+}
+static void rec_item(uint32_t kind, const uint32_t *payload, uint32_t n) {
+    if (s_rec_n + 1u + n > s_rec_cap) { s_rec_overflow = 1; return; }
+    s_rec[s_rec_n++] = kind << 24 | n;
+    for (uint32_t i = 0; i < n; i++) s_rec[s_rec_n++] = payload[i];
+    s_rec_run = UINT32_MAX;
+}
+void render_replay_record_host_vertex(uint32_t addr, uint32_t word, int32_t x16, int32_t y16, float z, float u, float v, float depth_z) {
+    uint32_t zb, ub, vb, db; memcpy(&db, &depth_z, 4); memcpy(&zb, &z, 4); memcpy(&ub, &u, 4); memcpy(&vb, &v, 4);
+    const uint32_t p[8] = { addr, word, (uint32_t)x16, (uint32_t)y16, zb, ub, vb, db };
+    rec_item(4u, p, 8);
+    s_rec_need_src = 1;
+}
+static void rec_word(uint32_t word) {
+    if (s_rec_run == UINT32_MAX || (s_rec[s_rec_run] & 0xFFFFFFu) == 0xFFFFFFu) {
+        if (s_rec_n + 1u > s_rec_cap) { s_rec_overflow = 1; return; }
+        s_rec_run = s_rec_n;
+        s_rec[s_rec_n++] = 0u;
+    }
+    if (s_rec_n + 1u > s_rec_cap) { s_rec_overflow = 1; return; }
+    s_rec[s_rec_n++] = word;
+    s_rec[s_rec_run]++;
+}
+
+static void gp0(uint32_t addr, uint32_t word) {
+    s_stats.gp0_words++;
+    if (g_render_replay_record) { rec_word(word); return; }
+    gpu_set_gp0_source(addr);
+    gpu_write_gp0(word);
+}
+
+/* Parent: execute a recorded stream into the GPU (inside a replay session). */
+extern void gpu_host_vertex_store(uint32_t addr, uint32_t word, int32_t x16, int32_t y16, float z, float u, float v, float depth_z);
+int render_replay_feed(const uint32_t *stream, uint32_t n) {
+    uint32_t i = 0, src = 0xFFFFFFFFu;
+    while (i < n) {
+        const uint32_t kind = stream[i] >> 24, count = stream[i] & 0xFFFFFFu;
+        i++;
+        if (count > n - i) return 0;
+        switch (kind) {
+        case 0:
+            for (uint32_t k = 0; k < count; k++) {
+                gpu_set_gp0_source(src);
+                gpu_write_gp0(stream[i + k]);
+                if (src != 0xFFFFFFFFu) src += 4u;
+            }
+            s_stats.gp0_words += count;
+            src = 0xFFFFFFFFu;
+            break;
+        case 1: gpu_ws_begin_linked_list(); break;
+        case 2: gpu_set_gp0_linked_list_node(0u, 0u); break;
+        case 3: gpu_ws_end_linked_list(); break;
+        case 4:
+            if (count == 7 || count == 8) {
+                float z, u, v; memcpy(&z, &stream[i + 4], 4); memcpy(&u, &stream[i + 5], 4); memcpy(&v, &stream[i + 6], 4);
