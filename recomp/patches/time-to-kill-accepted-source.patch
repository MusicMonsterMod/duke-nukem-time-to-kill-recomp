+                    gp0(w, psx_read_word(w));
+                    w = psx_mod_gpu_dma_resolve_address(w + 4u);
+                }
+            }
+            if ((header & 0x00800000u) || (header & 0x00FFFFFFu) == 0x00FFFFFFu) break;
