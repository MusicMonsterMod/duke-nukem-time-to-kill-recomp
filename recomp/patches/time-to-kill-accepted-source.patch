+                memset(s_phc_sum, 0, sizeof s_phc_sum); memset(s_phc_cnt, 0, sizeof s_phc_cnt);
+            }
+            s_ph_sum[0] = s_ph_sum[1] = s_ph_sum[2] = 0; s_ph_dsum = 0; s_ph_cnt = 0; s_ph_t0 = now;
+        }
+        s_ph_i = (s_ph_i + 1) % PH_N;
+        if (s_ph_pend[s_ph_i]) { s_ph_i = -1; return; }
+    }
+    if (s_ph_i < 0) return;
+    p_glQueryCounter(s_ph_q[s_ph_i][k], GL_TIMESTAMP);
+    if (s_ph_on == 2) {
+        if (k == 0) { s_phc_in = 1; s_phc_sp = 0; s_phc_n[s_ph_i] = 0; s_phc_cur = 11; phc_mark(11); }
+        else if (k == 1) { s_phc_sp = 0; s_phc_cur = 0; phc_mark(0); }
+        else if (k == 2) { s_phc_sp = 0; s_phc_cur = 12; phc_mark(12); }
+        else { phc_mark(12); s_phc_in = 0; s_phc_cur = 0; }
+    }
