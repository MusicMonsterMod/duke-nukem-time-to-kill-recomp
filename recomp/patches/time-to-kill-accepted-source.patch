+    code += function(sig) + '\n'
+code += r'''
+int main(void) {
+ uint32_t buf[16];int overflow;
+ render_replay_record_begin(buf,16);
+ render_replay_record_host_vertex(0x80012340,0xabcd,-123,456,1400.5f,0.25f,255.0f,1399.25f,0.375f);
+ uint32_t n=render_replay_record_end(&overflow);
+ assert(!overflow && n==10 && render_replay_feed(buf,n));
+ assert(stores==1 && got_z==1400.5f && got_depth==1399.25f && got_u==0.25f && got_v==255.0f && got_coverage==0.375f);
+ // Older eight-word entries keep independent depth and full coverage.
+ buf[0]=(4u<<24)|8;assert(render_replay_feed(buf,9));
