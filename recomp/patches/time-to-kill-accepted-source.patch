+#!/usr/bin/env python3
+"""Pin deadline boundaries and publication order for claimed render jobs."""
+from pathlib import Path
+import os,re,subprocess,tempfile
+src=(Path(__file__).resolve().parents[1]/'src/render_worker.c').read_text()
+assert re.search(r'_Atomic\s+uint64_t\s+start_ticks;',src)
+assert re.search(r'_Atomic\s+int32_t\s+worker;',src)
+a=src.index('const uint64_t started = atomic_load(&job->start_ticks);')
+a=src.index('if (',a)+4;b=src.index(') {',a);condition=src[a:b]
+submit=src[src.index('int psx_mod_replay_submit('):src.index('int psx_mod_replay_job_state(')]
+assert submit.index('atomic_store(&job->start_ticks, 0u)')<submit.index('atomic_store(&job->state, RW_QUEUED)')
+code='''#include <stdint.h>
+#include <assert.h>
+#define RW_JOB_DEADLINE_MS 250
+static int expired(uint64_t now,uint64_t started,uint64_t f) { return f && ('''+condition+'''); }
+int main(void) {
+ assert(!expired(1000000,0,1000)); /* Claimed but start not published. */
+ assert(!expired(1000,1001,1000)); /* Worker starts after parent's clock sample. */
+ assert(!expired(1000,1000,1000));
+ assert(!expired(1250,1000,1000));
+ assert(expired(1251,1000,1000));
+ assert(!expired(1251,1000,0));
+ assert(!expired(5000000000ull,5000000010ull,1000000000ull));
+ return 0;
+}
+'''
+with tempfile.TemporaryDirectory() as tmp:
+ p=Path(tmp);(p/'test.c').write_text(code)
+ subprocess.run([os.environ.get('CC','cc'),'-O2',str(p/'test.c'),'-o',str(p/'test')],check=True)
+ subprocess.run([str(p/'test')],check=True)
+print('render-worker deadline publication and boundaries: passed')
