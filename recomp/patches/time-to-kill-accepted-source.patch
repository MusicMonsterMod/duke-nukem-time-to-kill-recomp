+/* Present when a display deadline is due; returns the next deadline. Safe at
+ * any guest instruction boundary: batched draws are flushed first, as at a
+ * VBlank present. */
+uint64_t gl_renderer_rp_tick(uint64_t now) {
+    if (!s_ctx || !s_raster_ok || !s_rp_enabled || !s_rp_valid[0] || s_rr_active) return 0;
+    uint64_t f = SDL_GetPerformanceFrequency();
+    double target = s_rp_target_hz > 0.0 ? s_rp_target_hz
+                  : s_rp_target_hz < 0.0 ? 1000.0 : s_rp_host_hz;
+    if (target < 1.0) target = s_rp_source_hz > 0.0 ? s_rp_source_hz : 60.0;
+    /* Plugin-chosen divisor (late camera pacing): present every d-th display
+     * period, evenly, when fresh images cannot keep up with every refresh. */
+    if (s_rp_div > 1) target /= (double)s_rp_div;
+    uint64_t period = (uint64_t)((double)f / target);
+    if (period == 0) return 0;
+    if (s_rp_next_deadline == 0 || now > s_rp_next_deadline + period * 8u)
+        s_rp_next_deadline = now;               /* start, or resynchronise */
+    if (now < s_rp_next_deadline) {
+        /* Between deadlines the provider may prepare images (at most every
+         * 0.5 ms), so drawing them never delays a present. */
+        if (s_rp_provider && now - s_rp_last_prefetch >= f / 2000u) {
+            PSXModPresentInfo pre;
+            s_rp_last_prefetch = now;
+            pre.now = now; pre.frequency = f; pre.flips = s_rp_flips;
+            pre.last_flip = s_rp_last_flip_t; pre.flip_interval = s_rp_flip_interval;
+            pre.present_hz = target; pre.due = 0;
+            pre.slack_ms = frame_pacer_slack_ms();
+            pre.next_deadline = s_rp_next_deadline;
+            /* Polling/submission does not touch GL. A feed flushes at
+             * gl_replay_begin; do not split guest batches every 0.5 ms. */
+            (void)s_rp_provider(&pre, s_rp_user);
+        }
+        return s_rp_next_deadline;
+    }
+    /* Below the guest rate (30): only a new game image is worth presenting. */
+    if (s_rp_target_hz > 0.0 && s_rp_target_hz < s_rp_source_hz && !s_rp_new_image)
+        return now + period / 8u;
+    flush_flat_batch();
+    flush_tex_batch();
+    flush_cpu_upload();
+    int slot = 0;
+    PSXModPresentInfo info;
+    info.now = now; info.frequency = f; info.flips = s_rp_flips;
+    info.last_flip = s_rp_last_flip_t; info.flip_interval = s_rp_flip_interval;
+    info.present_hz = target; info.due = 1;
+    info.slack_ms = frame_pacer_slack_ms();
+    info.next_deadline = s_rp_next_deadline + period;
+    if (s_rp_provider) {
+        int pick = s_rp_provider(&info, s_rp_user);
+        if (pick >= 1 && pick <= RP_CACHE && s_rp_valid[pick]) {
+            slot = pick;
+            s_rp_replays++;
+        }
+    }
+    rp_present_slot(slot);
+    rp_dump_if_requested();
+    do s_rp_next_deadline += period; while (s_rp_next_deadline <= now);
+    return s_rp_next_deadline;
+}
