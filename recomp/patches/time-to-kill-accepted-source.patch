+        d->addr = a; d->word = word; d->seq = s_hpv_seq + 1; d->x16 = x16; d->y16 = y16; d->z = z; d->u = u; d->v = v; d->depth_z = depth_z; d->coverage = coverage; d->depth_mode = (uint32_t)depth_mode;
