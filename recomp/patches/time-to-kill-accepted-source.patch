+static void rp_ensure_tex(int slot, int tw, int th) {
+    if (s_rp_tex[slot] && s_rp_own[slot] && s_rp_tw[slot] == tw && s_rp_th[slot] == th) return;
+    if (s_rp_fbo[slot]) { gs_delete_fbs(1, &s_rp_fbo[slot]); s_rp_fbo[slot] = 0; }
+    /* An adopted texture belongs to the render thread: never draw into or
+     * delete it here (Time to Kill D17BC, renderer switch). */
+    if (s_rp_tex[slot] && s_rp_own[slot]) glDeleteTextures(1, &s_rp_tex[slot]);
+    s_rp_tex[slot] = make_tex(GL_RGBA8, tw, th, GL_RGBA, GL_UNSIGNED_BYTE);
+    s_rp_own[slot] = 1;
+    make_fbo(&s_rp_fbo[slot], s_rp_tex[slot], 0);
+    s_rp_tw[slot] = tw; s_rp_th[slot] = th;
+}
