+ * each presentation deadline inside a stock guest VBlank interval, with the
+ * deadline's phase (0..1) in that interval. fn may render an extra image by
+ * re-running guest drawing code between psx_mod_replay_begin() and
+ * psx_mod_replay_end(1); it returns non-zero when it did. The guest machine is
+ * frozen and fully restored around a replay (render_replay.h); fn owns any
+ * guest RAM it swaps. target_hz: 0 = the display's refresh rate, -1 =
+ * unlimited, otherwise 30..1000. Guest timing stays stock.
+ */
+typedef struct PSXModPresentInfo {
+    uint64_t now, frequency;   /* host performance counter */
+    uint64_t flips;            /* changes of the displayed guest image so far */
+    uint64_t last_flip;        /* counter value at the latest change */
+    double   flip_interval;    /* seconds between the last two changes */
+    double   present_hz;       /* presentation target */
+    int      due;              /* 1: choose the image to present now (return
+                                * cache index + 1, or 0 for the real image);
+                                * 0: a chance to prepare images between presents */
+    double   slack_ms;         /* recent idle time per guest field (pacer wait) */
+    uint64_t next_deadline;    /* counter value of the next present */
