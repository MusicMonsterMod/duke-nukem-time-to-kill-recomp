+static void rasterize_console(void) {
+#if HOST_OSD_VISUAL
+    s_console_w = CONSOLE_W;
+    s_console_h = CONSOLE_H;
+    for (int i = 0; i < CONSOLE_W * CONSOLE_H; ++i)
+        s_console_img[i] = 0xc0101418u;
+    for (int x = 0; x < CONSOLE_W; ++x) {
+        s_console_img[(CONSOLE_H - 2) * CONSOLE_W + x] = 0xe0506068u;
+        s_console_img[(CONSOLE_H - 1) * CONSOLE_W + x] = 0xa0080c10u;
+    }
+    int drew = 0;
+#if defined(TTK_CHEAT_OSD)
+    /* Bottom-up: prompt on the last row, older scrollback above. */
+    {
+        char prompt[CONSOLE_LINE + 4];
+        static uint32_t text_buf[CONSOLE_W * 64];
+        int tw = 0, th = 0;
+        snprintf(prompt, sizeof prompt, "> %s", s_console_line);
+        int y = CONSOLE_H - 12;
+        if (ttk_font_rasterize(prompt, 3, text_buf, CONSOLE_W, 64, CONSOLE_W - 16, &tw, &th) && tw > 0 && th > 0) {
+            y = CONSOLE_H - th - 10;
+            if (y < 4) y = 4;
+            for (int row = 0; row < th; ++row) for (int col = 0; col < tw; ++col) {
+                uint32_t c = text_buf[row * tw + col];
+                if (!(c >> 24)) continue;
+                int px = 8 + col, py = y + row;
+                if ((unsigned)px < (unsigned)CONSOLE_W && (unsigned)py < (unsigned)CONSOLE_H)
+                    s_console_img[py * CONSOLE_W + px] = c;
+            }
+            drew = 1;
+            y -= 2;
+        }
+        if (s_console_scroll > 0) {
+            /* Scrolled up: a marker above the prompt says newer lines are below. */
+            if (ttk_font_rasterize("-- MORE BELOW: PGDN / END --", 3, text_buf, CONSOLE_W, 64, CONSOLE_W - 16, &tw, &th) &&
+                tw > 0 && th > 0) {
+                y -= th;
+                for (int row = 0; row < th; ++row) for (int col = 0; col < tw; ++col) {
+                    uint32_t c = text_buf[row * tw + col];
+                    if (!(c >> 24)) continue;
+                    int px = 8 + col, py = y + row;
+                    if ((unsigned)px < (unsigned)CONSOLE_W && (unsigned)py < (unsigned)CONSOLE_H)
+                        s_console_img[py * CONSOLE_W + px] = c;
+                }
+                y -= 2;
+            }
+        }
+        for (int i = s_console_hist_n - 1 - s_console_scroll; i >= 0 && y > 6; --i) {
+            tw = th = 0;
+            if (!ttk_font_rasterize(s_console_hist[i], 3, text_buf, CONSOLE_W, 64, CONSOLE_W - 16, &tw, &th) ||
+                tw < 1 || th < 1) continue;
+            y -= th;
+            if (y < 4) break;
+            for (int row = 0; row < th; ++row) for (int col = 0; col < tw; ++col) {
+                uint32_t c = text_buf[row * tw + col];
+                if (!(c >> 24)) continue;
+                int px = 8 + col, py = y + row;
+                if ((unsigned)px < (unsigned)CONSOLE_W && (unsigned)py < (unsigned)CONSOLE_H)
+                    s_console_img[py * CONSOLE_W + px] = c;
+            }
+            drew = 1;
+            y -= 2;
+        }
+    }
+#endif
+    if (!drew) {
+        const char *msg = s_console_line[0] ? s_console_line : ">";
+        int n = (int)strlen(msg);
+        if (n > 60) n = 60;
+        for (int ci = 0; ci < n; ++ci) {
+            unsigned char ch = (unsigned char)msg[ci];
+            if (ch < 32 || ch > 126) ch = '?';
+            const uint8_t *g = FONT8X8[ch - 32];
+            for (int row = 0; row < 8; ++row) {
+                uint8_t bits = g[row];
+                for (int col = 0; col < 8; ++col) {
+                    if (!(bits & (1u << col))) continue;
+                    int x = 8 + ci * 7 + col, y = CONSOLE_H - 18 + row;
+                    if ((unsigned)x < (unsigned)CONSOLE_W && (unsigned)y < (unsigned)CONSOLE_H)
+                        s_console_img[y * CONSOLE_W + x] = 0xfffff0c0u;
+                }
+            }
+        }
+    }
+    s_console_dirty = 0;
+    s_console_gen++;
+#endif
+}
