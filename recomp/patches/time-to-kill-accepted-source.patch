+void gl_renderer_set_replay_provider(int (*fn)(const PSXModPresentInfo *info, void *user), void *user,
+                                     double target_hz, double host_hz, double source_hz) {
+    s_rp_provider = fn;
+    s_rp_user = user;
+    s_rp_target_hz = target_hz;
+    s_rp_host_hz = host_hz;
+    s_rp_source_hz = source_hz;
+    s_rp_enabled = fn != NULL && source_hz >= 1.0;
+    frame_interpolation_schedule_reset(&s_rp_schedule);
+    /* D19G1: also switched while the game runs. No image captured under the
+     * previous setting is presented again. */
+    memset(s_rp_valid, 0, sizeof s_rp_valid);
+    rp_note_foreign_present();
+    if (s_rp_enabled)
+        fprintf(stdout, "psxrecomp: replay presentation enabled: target %s%.1f Hz "
+                "(host %.1f Hz, guest %.3f Hz)\n",
+                target_hz == -2.0 ? "auto " : target_hz < 0.0 ? "unlimited, cap " : target_hz == 0.0 ? "display " : "",
+                replay_resolved_hz(target_hz, host_hz),
+                host_hz, source_hz);
+}
+
+static uint64_t s_rp_next_deadline = 0, s_rp_last_prefetch = 0;
+void gl_renderer_set_replay_host_hz(double host_hz) {
+    s_rp_host_hz = host_hz;
+    if (s_rp_target_hz == -2.0 || s_rp_target_hz == 0.0) {
+        s_rp_next_deadline = s_rp_last_prefetch = 0;
+        frame_interpolation_schedule_reset(&s_rp_schedule);
+        fprintf(stdout, "psxrecomp: display-aware replay target %.3f Hz\n",
+                replay_resolved_hz(s_rp_target_hz, host_hz));
+    }
+}
+void gl_renderer_set_replay_target_hz(double target_hz) {
+    s_rp_target_hz = target_hz;
+    s_rp_next_deadline = s_rp_last_prefetch = 0;
+    frame_interpolation_schedule_reset(&s_rp_schedule);
+}
+
+int gl_renderer_replay_available(void) { return s_ctx && s_raster_ok; }
+int gl_renderer_replay_owns_cadence(void) {
+    return s_ctx && s_raster_ok && s_rp_enabled;
+}
+
+void gl_renderer_replay_diag(uint64_t *presents, uint64_t *replays, uint64_t *misses,
+                             double *target_hz, uint64_t hist[8]) {
+    if (presents) *presents = s_rp_presents;
+    if (replays) *replays = s_rp_replays;
+    if (misses) *misses = s_rp_misses;
+    if (target_hz) *target_hz = replay_resolved_hz(s_rp_target_hz, s_rp_host_hz);
+    if (hist) for (int i = 0; i < 8; i++) hist[i] = s_rp_interval_hist[i];
+}
+
+static int s_rp_last_presented = 0;
+/* Redraw-only live frames (psx_mod_live_draw_skip_*). A live list that drew
+ * no primitives leaves a stale image. The plugin's arm call marks each frame
+ * boundary (the flip, after which that frame's lists are sent); the image of
+ * the lists between two boundaries is displayed at the display change after
+ * the second one. If any of them skipped, that real image is "blind": it is
+ * not captured, and a present that would show it keeps the screen as it is
+ * (the last image presented). A savestate load restores VRAM
+ * that may hold such an image, so it is blind too until a fully drawn image
+ * is displayed. */
+static int s_rp_live_enabled = 0, s_rp_list_blind = 0, s_rp_window_blind = 0, s_rp_real_blind = 0;
+static uint64_t s_rp_held = 0;
+void gl_renderer_live_skip_enable(int enabled) {
+    s_rp_live_enabled = enabled != 0;
+}
+void gl_renderer_note_live_list(int skipped) { if (s_rp_live_enabled && skipped) s_rp_list_blind = 1; }
+void gl_renderer_live_window(void) { s_rp_window_blind = s_rp_list_blind; s_rp_list_blind = 0; }
+int gl_renderer_live_blind(void) { return s_rp_real_blind; }
+uint64_t gl_renderer_live_held(void) { return s_rp_held; }
+static void rp_live_after_load(void) {
+    if (!s_rp_live_enabled) return;
+    s_rp_list_blind = s_rp_window_blind = s_rp_real_blind = 1;
+    s_rp_last_presented = 0;   /* its cache entry may be redrawn over the new VRAM */
+}
+/* The last presented replay image as a w x h ARGB picture (top row first),
+ * for savestate thumbnails while the displayed real image is blind. */
+int gl_renderer_grab_presented_argb(uint32_t *out, int w, int h) {
+    static GLuint tex = 0, fbo = 0;
+    static int tw = 0, th = 0;
+    const int slot = s_rp_last_presented;
+    if (!out || w <= 0 || h <= 0 || !s_ctx || !s_rp_real_blind || slot < 1 || slot > RP_CACHE || !s_rp_valid[slot]) return 0;
+    if (!tex || tw != w || th != h) {
+        if (fbo) gs_delete_fbs(1, &fbo);
+        if (tex) glDeleteTextures(1, &tex);
+        tex = make_tex(GL_RGBA8, w, h, GL_RGBA, GL_UNSIGNED_BYTE);
+        make_fbo(&fbo, tex, 0);
+        tw = w; th = h;
+    }
+    uint8_t *rgba = (uint8_t *)malloc((size_t)w * h * 4);
+    if (!rgba) return 0;
+    gs_bind_fb(PSXGL_READ_FRAMEBUFFER, s_rp_fbo[slot]);
+    gs_bind_fb(PSXGL_DRAW_FRAMEBUFFER, fbo);
+    gs_disable(GL_SCISSOR_TEST);
+    /* The centre 4:3, as the displayed VRAM picture a thumbnail otherwise has. */
+    int sw = s_rp_th[slot] * 4 / 3;
+    if (sw > s_rp_tw[slot]) sw = s_rp_tw[slot];
+    const int sx = (s_rp_tw[slot] - sw) / 2;
+    p_glBlitFramebuffer(sx, 0, sx + sw, s_rp_th[slot], 0, 0, w, h, GL_COLOR_BUFFER_BIT, GL_LINEAR);
+    gs_bind_fb(PSXGL_READ_FRAMEBUFFER, fbo);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, rgba);
+    glPixelStorei(GL_PACK_ALIGNMENT, 4);
+    gs_bind_fb(PSXGL_READ_FRAMEBUFFER, 0);
+    gs_bind_fb(PSXGL_DRAW_FRAMEBUFFER, 0);
+    for (int y = 0; y < h; y++)
+        for (int x = 0; x < w; x++) {
+            const uint8_t *p = rgba + ((size_t)y * w + x) * 4;   /* rp images are top row first */
+            out[(size_t)y * w + x] = 0xFF000000u | (uint32_t)p[0] << 16 | (uint32_t)p[1] << 8 | p[2];
+        }
+    free(rgba);
+    return 1;
+}
+static int s_rp_div = 1;
+void gl_renderer_set_replay_divisor(int d) { s_rp_div = d < 1 ? 1 : d > 16 ? 16 : d; }
+int gl_renderer_replay_divisor(void) { return s_rp_div; }
+static void rp_present_slot(int slot) {
+    int ww = 0, wh = 0, lx, ly, lw, lh;
+    if (!s_rp_valid[slot]) slot = 0;
+    /* The screen keeps what it shows: a cache entry may already hold another
+     * image (a later redraw, or after a load one drawn over the new VRAM). */
+    if (slot == 0 && s_rp_real_blind) { s_rp_held++; return; }
+    if (!s_rp_valid[slot]) return;
+    s_rp_last_presented = slot;
+    SDL_GL_GetDrawableSize(s_win, &ww, &wh);
+    if (s_rp_force_4_3) letterbox_rect_aspect(ww, wh, 4, 3, &lx, &ly, &lw, &lh);
+    else letterbox_rect(ww, wh, &lx, &ly, &lw, &lh);
+    gs_bind_fb(PSXGL_DRAW_FRAMEBUFFER, 0);
+    gs_disable(GL_SCISSOR_TEST);
+    glViewport(0, 0, ww, wh);
+    if (lx != 0 || ly != 0 || lw != ww || lh != wh) {
+        glClearColor(0.f, 0.f, 0.f, 1.f);
+        glClear(GL_COLOR_BUFFER_BIT);
+    }
+    present_bezel(ww, wh, lx, ly, lw, lh);
+    present_target_quad(s_rp_tex[slot], s_rp_w, s_rp_h, 0, 0, s_rp_w, s_rp_h,
+                        s_rp_linear, lx, ly, lw, lh, 1);
+    pres_record(GL_PRES_INTERP, 0, 0, s_rp_w, s_rp_h, lx, ly, lw, lh);
+    latency_ring_mark(LAT_SWAP_BEGIN);
+    uint64_t swap0 = SDL_GetPerformanceCounter();
+    s_tint_slot = slot;
+    gl_swap_with_osd();
+    s_tint_slot = -1;
+    latency_ring_mark(LAT_SWAP_END);
+    {
+        uint64_t now = SDL_GetPerformanceCounter(), f = SDL_GetPerformanceFrequency();
+        if (f) {s_rp_swap_us += (now - swap0) * 1000000u / f;
+            s_rq_swap[s_rq_swaps++%256]=(double)(now-swap0)*1000.0/f;}
+        if (s_rp_last_swap && f) {
+            /* Present-interval histogram: <2, <4, <5, <6, <8, <12, <20, >=20 ms. */
+            double ms = (double)(now - s_rp_last_swap) * 1000.0 / (double)f;
+            int b = ms < 2.0 ? 0 : ms < 4.0 ? 1 : ms < 5.0 ? 2 : ms < 6.0 ? 3 :
+                    ms < 8.0 ? 4 : ms < 12.0 ? 5 : ms < 20.0 ? 6 : 7;
+            s_rp_interval_hist[b]++;
+        }
+        s_rp_last_swap = now;
+        s_rp_ring_t[s_rp_ring_n % RP_RING] = now;
+        s_rp_ring_kind[s_rp_ring_n % RP_RING] = slot >= 1 ? 2 : (s_rp_new_image ? 1 : 0);
+        {
+            const uint64_t ident = slot >= 1 ? ((uint64_t)slot << 32 | s_rp_gen[slot]) : (uint64_t)s_rp_real_gen;
+            if (ident != s_rp_last_ident) s_rp_distinct++;
+            s_rp_last_ident = ident;
+        }
+        s_rp_ring_n++;
+        s_rp_new_image = 0;
+        s_rp_last_present = now;
+    }
+    s_rp_presents++;
+    if (slot >= 1) psx_rt_after_present(slot);   /* the render thread may redraw it next */
+}
+
+/* Debug dump of the real displayed frame (slot 0) and the last replayed frame
+ * (slot 1), requested by the debug server and written on the GL thread. */
+static char s_rp_dump_base[480];
+static volatile int s_rp_dump_req = 0, s_rp_dump_done = 0;
+void gl_replay_request_dump(const char *base) {
+    snprintf(s_rp_dump_base, sizeof s_rp_dump_base, "%s", base ? base : "");
+    s_rp_dump_done = 0;
+    s_rp_dump_req = 1;
+}
+int gl_replay_dump_done(void) { return s_rp_dump_done; }
+static int rp_dump_slot(int slot, const char *path) {
+    int w = s_rp_tw[slot], h = s_rp_th[slot], ok = 0;
+    if (!s_rp_valid[slot] || w <= 0 || h <= 0) return 0;
+    uint8_t *rows = (uint8_t *)malloc((size_t)w * h * 3);
+    uint8_t *flip = rows ? (uint8_t *)malloc((size_t)w * h * 3) : NULL;
+    if (rows && flip) {
+        gs_bind_fb(PSXGL_READ_FRAMEBUFFER, s_rp_fbo[slot]);
+        glPixelStorei(GL_PACK_ALIGNMENT, 1);
+        glReadPixels(0, 0, w, h, GL_RGB, GL_UNSIGNED_BYTE, rows);
+        gs_bind_fb(PSXGL_READ_FRAMEBUFFER, 0);
+        for (int y = 0; y < h; y++)
+            memcpy(flip + (size_t)y * w * 3, rows + (size_t)(h - 1 - y) * w * 3, (size_t)w * 3);
+        FILE *pf = fopen(path, "wb");
+        if (pf) { ok = png_write_rgb(pf, flip, (uint32_t)w, (uint32_t)h); fclose(pf); }
+    }
+    free(flip);
+    free(rows);
+    return ok;
+}
+/* Triple dump (path ends in "-trip"): the real image k, the first replay
+ * shown for it, and the real image k+1 at the next change. */
+static int s_rp_trip = 0;
+static void rp_dump_trip(int presented_slot) {
+    char path[512];
+    if (s_rp_trip == 1 && presented_slot >= 1) {
+        snprintf(path, sizeof path, "%s-k0.png", s_rp_dump_base);
+        int a = rp_dump_slot(0, path);
+        snprintf(path, sizeof path, "%s-mid.png", s_rp_dump_base);
+        int b = rp_dump_slot(presented_slot, path);
+        s_rp_trip = (a && b) ? 2 : 0;
+        if (!s_rp_trip) s_rp_dump_done = 1;
+    } else if (s_rp_trip == 2 && presented_slot == 0 && s_rp_ring_n &&
+               s_rp_ring_kind[(s_rp_ring_n - 1u) % RP_RING] == 1) {
+        snprintf(path, sizeof path, "%s-k1.png", s_rp_dump_base);
+        s_rp_dump_done = 1 + 3 * rp_dump_slot(0, path);
+        s_rp_trip = 0;
+    }
+}
+/* Sequence dump (path ends in "-seq"): the next 24 presented images, copied
+ * on the GPU as they are shown and written once all are collected (writing
+ * PNGs during the run would stall it). Writing them stalls the run about a
+ * second afterwards, so back-to-back sequences straddle a host stall. A path
+ * ending in "-seq96" keeps 96 presents at a quarter size in one sequence. */
+#define RP_SEQ 96
+static int s_rp_seq_n = 24, s_rp_seq_div = 1;
+static int s_rp_seq = 0;
+static GLuint s_rp_seq_tex[RP_SEQ], s_rp_seq_fbo[RP_SEQ];
+static int s_rp_seq_kind[RP_SEQ], s_rp_seq_tw[RP_SEQ], s_rp_seq_th[RP_SEQ], s_rp_seq_w, s_rp_seq_h;
+static void rp_dump_if_requested(void) {
+    char path[512];
+    if (s_rp_seq > 0) {
+        int n = s_rp_seq_n - s_rp_seq, slot = s_rp_last_presented;
+        int sw = s_rp_tw[slot], sh = s_rp_th[slot];
+        int w = sw / s_rp_seq_div, h = sh / s_rp_seq_div;
+        if (!s_rp_seq_tex[n] || s_rp_seq_tw[n] != w || s_rp_seq_th[n] != h) {
+            if (s_rp_seq_fbo[n]) gs_delete_fbs(1, &s_rp_seq_fbo[n]);
+            if (s_rp_seq_tex[n]) glDeleteTextures(1, &s_rp_seq_tex[n]);
+            s_rp_seq_tex[n] = make_tex(GL_RGBA8, w, h, GL_RGBA, GL_UNSIGNED_BYTE);
+            make_fbo(&s_rp_seq_fbo[n], s_rp_seq_tex[n], 0);
+            s_rp_seq_tw[n] = w; s_rp_seq_th[n] = h;
+        }
+        gs_bind_fb(PSXGL_READ_FRAMEBUFFER, s_rp_fbo[slot]);
+        gs_bind_fb(PSXGL_DRAW_FRAMEBUFFER, s_rp_seq_fbo[n]);
+        p_glBlitFramebuffer(0, 0, sw, sh, 0, 0, w, h, GL_COLOR_BUFFER_BIT, s_rp_seq_div > 1 ? GL_LINEAR : GL_NEAREST);
+        gs_bind_fb(PSXGL_READ_FRAMEBUFFER, 0);
+        gs_bind_fb(PSXGL_DRAW_FRAMEBUFFER, 0);
+        s_rp_seq_kind[n] = slot ? 2 : (s_rp_ring_kind[(s_rp_ring_n - 1u) % RP_RING] == 1 ? 1 : 0);
+        if (n == 0) { s_rp_seq_w = w; s_rp_seq_h = h; }
+        if (--s_rp_seq == 0) {
+            GLuint keep_tex = s_rp_tex[0], keep_fbo = s_rp_fbo[0];
+            int keep_valid = s_rp_valid[0], kw = s_rp_tw[0], kh = s_rp_th[0];
+            for (int i = 0; i < s_rp_seq_n; i++) {
+                s_rp_tex[0] = s_rp_seq_tex[i]; s_rp_fbo[0] = s_rp_seq_fbo[i];
+                s_rp_valid[0] = 1; s_rp_tw[0] = s_rp_seq_w; s_rp_th[0] = s_rp_seq_h;
+                snprintf(path, sizeof path, "%s-%02d-%s.png", s_rp_dump_base, i,
+                         s_rp_seq_kind[i] == 2 ? "redraw" : s_rp_seq_kind[i] == 1 ? "new" : "real");
+                rp_dump_slot(0, path);
+            }
+            s_rp_tex[0] = keep_tex; s_rp_fbo[0] = keep_fbo; s_rp_valid[0] = keep_valid;
+            s_rp_tw[0] = kw; s_rp_th[0] = kh;
+            s_rp_dump_done = 4;
+        }
+        return;
+    }
+    if (s_rp_dump_req && strstr(s_rp_dump_base, "-seq")) {
+        s_rp_dump_req = 0;
+        s_rp_seq_div = strstr(s_rp_dump_base, "-seq96") ? 4 : 1;
+        s_rp_seq_n = s_rp_seq_div > 1 ? RP_SEQ : 24;
+        s_rp_seq = s_rp_seq_n;
+        return;
+    }
+    if (s_rp_trip) { rp_dump_trip(s_rp_last_presented); return; }
+    if (s_rp_dump_req && strstr(s_rp_dump_base, "-trip")) {
+        s_rp_dump_req = 0;
+        s_rp_trip = 1;
+        return;
+    }
+    if (!s_rp_dump_req) return;
+    s_rp_dump_req = 0;
+    snprintf(path, sizeof path, "%s-real.png", s_rp_dump_base);
+    int a = rp_dump_slot(0, path);
+    snprintf(path, sizeof path, "%s-replay.png", s_rp_dump_base);
+    int b = rp_dump_slot(s_rp_last_presented > 0 ? s_rp_last_presented : s_rp_capture_slot, path);
+    s_rp_dump_done = 1 + a + 2 * b;
+}
+
+/* Called by the real present paths: record the displayed frame. */
+static void rp_present_real(int path, GLuint src_fbo_unused, int base_x, int disp_y,
+                            int w, int h, int linear, int force_4_3) {
+    (void)src_fbo_unused;
+    s_rp_calls++;
+    s_rp_path = path; s_rp_base_x = base_x; s_rp_w = w; s_rp_h = h;
+    s_rp_linear = linear; s_rp_force_4_3 = force_4_3;
+    if (disp_y != s_rp_last_disp_y) s_rp_real_blind = s_rp_window_blind;
+    if (!s_rp_real_blind) {
+        s_rp_valid[0] = 0;
+        rp_copy_band(0, disp_y);
+    }
+    if (disp_y != s_rp_last_disp_y) {
+        uint64_t t = SDL_GetPerformanceCounter(), f = SDL_GetPerformanceFrequency();
+        if (s_rp_last_flip_t && f) s_rp_flip_interval = (double)(t - s_rp_last_flip_t) / (double)f;
+        s_rp_last_flip_t = t;
+        s_rp_last_disp_y = disp_y;
+        s_rp_new_image = 1, s_rp_real_gen++;
+        s_rp_flips++;
+    }
+    /* Presents happen on their own deadlines (gl_renderer_rp_tick), from the
+     * guest's device-service edges and from the frame pacer's wait, so they are
+     * evenly spaced whatever the guest is doing. */
+    (void)gl_renderer_rp_tick(SDL_GetPerformanceCounter());
+}
+
+
+uint64_t gl_renderer_replay_flips(void) { return s_rp_flips; }
+/* A frame presented by another path (24-bit movies, CPU readout, blank): the
+ * captured image is no longer what is on screen, so display deadlines must not
+ * re-present it until the next VRAM/wide present captures a fresh one. */
+static void rp_note_foreign_present(void) {
+    s_rp_valid[0] = 0;
+    s_rp_last_disp_y = -1;
+    s_rp_next_deadline = 0;
+}
+int gl_renderer_replay_display_y(void) { return s_rp_last_disp_y; }
+
+/* Present when a display deadline is due; returns the next deadline. Safe at
+ * any guest instruction boundary: batched draws are flushed first, as at a
+ * VBlank present. */
+uint64_t gl_renderer_rp_tick(uint64_t now) {
+    if (!s_ctx || !s_raster_ok || !s_rp_enabled || !s_rp_valid[0] || s_rr_active) return 0;
+    psx_rt_poll();   /* images the render thread finished (D17AW) */
+    uint64_t f = SDL_GetPerformanceFrequency();
+    double target = replay_resolved_hz(s_rp_target_hz, s_rp_host_hz);
+    if (target < 1.0) target = s_rp_source_hz > 0.0 ? s_rp_source_hz : 60.0;
+    /* Plugin-chosen divisor (late camera pacing): present every d-th display
+     * period, evenly, when fresh images cannot keep up with every refresh. */
+    if (s_rp_div > 1) target /= (double)s_rp_div;
+    uint64_t period = (uint64_t)((double)f / target);
+    if (period == 0) return 0;
+    if (s_rp_next_deadline == 0 || now > s_rp_next_deadline + period * 8u)
+        s_rp_next_deadline = now;               /* start, or resynchronise */
+    if (now < s_rp_next_deadline) {
+        /* Between deadlines the provider may prepare images (at most every
+         * 0.5 ms), so drawing them never delays a present. */
+        if (s_rp_provider && now - s_rp_last_prefetch >= f / 2000u) {
+            PSXModPresentInfo pre;
+            s_rp_last_prefetch = now;
+            pre.now = now; pre.frequency = f; pre.flips = s_rp_flips;
+            pre.last_flip = s_rp_last_flip_t; pre.flip_interval = s_rp_flip_interval;
+            pre.present_hz = target; pre.due = 0;
+            pre.slack_ms = frame_pacer_slack_ms();
+            pre.next_deadline = s_rp_next_deadline;
+            /* Polling/submission does not touch GL. A feed flushes at
+             * gl_replay_begin; do not split guest batches every 0.5 ms. */
+            (void)s_rp_provider(&pre, s_rp_user);
+        }
+        return s_rp_next_deadline;
+    }
+    /* Below the guest rate (30): only a new game image is worth presenting. */
+    if (s_rp_target_hz > 0.0 && s_rp_target_hz < s_rp_source_hz && !s_rp_new_image)
+        return now + period / 8u;
+    flush_flat_batch();
+    flush_tex_batch();
+    flush_cpu_upload();
+    int slot = 0;
+    PSXModPresentInfo info;
+    info.now = now; info.frequency = f; info.flips = s_rp_flips;
+    info.last_flip = s_rp_last_flip_t; info.flip_interval = s_rp_flip_interval;
+    info.present_hz = target; info.due = 1;
