+/* Opt-in replay timing: timestamp pairs never block for a GPU result.
+ * Unlike frame_perf's whole-field query, these bracket one redraw only.
+ * GPU span includes command-stream bubbles; it is not GPU utilization. */
+#define RQ_N 32
+static struct { GLuint q[2]; int pending; uint64_t cpu; } s_rq[RQ_N];
+static int s_rq_on=-1, s_rq_next, s_rq_open=-1;
+static double s_rq_gpu[256], s_rq_cpu[256];
+static unsigned s_rq_count;
+static double s_rq_swap[256];static unsigned s_rq_swaps;
+static uint64_t s_rq_dropped;
+static void rq_begin(void) {
+    if (s_rq_on<0) {
+        const char *e=getenv("PSX_REPLAY_PROFILE");
+        s_rq_on=e && e[0]=='1' && p_glQueryCounter && p_glGetQueryObjectiv && p_glGetQueryObjectui64v;
+        if(s_rq_on) for(int i=0;i<RQ_N;i++) p_glGenQueries(2,s_rq[i].q);
+    }
+    if(!s_rq_on) return;
+    for(int i=0;i<RQ_N;i++) if(s_rq[i].pending) {
+        GLint ready=0;
+        p_glGetQueryObjectiv(s_rq[i].q[1],GL_QUERY_RESULT_AVAILABLE,&ready);
+        if(!ready) continue;
+        GLuint64 a=0,b=0;
+        p_glGetQueryObjectui64v(s_rq[i].q[0],GL_QUERY_RESULT,&a);
+        p_glGetQueryObjectui64v(s_rq[i].q[1],GL_QUERY_RESULT,&b);
+        unsigned k=s_rq_count++%256;
+        s_rq_gpu[k]=b>=a?(double)(b-a)/1e6:0;
+        s_rq_cpu[k]=(double)s_rq[i].cpu*1000.0/SDL_GetPerformanceFrequency();
+        s_rq[i].pending=0;
+    }
+    int i=s_rq_next++%RQ_N;
+    if(s_rq[i].pending) {s_rq_dropped++;return;}
+    s_rq_open=i; s_rq[i].cpu=SDL_GetPerformanceCounter();
+    p_glQueryCounter(s_rq[i].q[0],GL_TIMESTAMP);
+}
+static void rq_end(void) {
+    if(s_rq_open<0) return;
+    int i=s_rq_open; s_rq_open=-1;
+    p_glQueryCounter(s_rq[i].q[1],GL_TIMESTAMP);
+    s_rq[i].cpu=SDL_GetPerformanceCounter()-s_rq[i].cpu;
+    s_rq[i].pending=1;
+}
+static int rq_cmp(const void *a,const void *b) {
+    double x=*(const double*)a,y=*(const double*)b;return (x>y)-(x<y);
+}
