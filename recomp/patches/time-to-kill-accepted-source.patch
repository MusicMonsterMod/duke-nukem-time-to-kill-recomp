+    int n = s_ph_dn[s_ph_i];
+    if (n >= PH_DRAWS * 2) return;
+    if (!s_ph_dq[s_ph_i][0]) p_glGenQueries(PH_DRAWS * 2, s_ph_dq[s_ph_i]);
