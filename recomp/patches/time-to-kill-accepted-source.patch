+    }
+    if (!s_ph_on) return;
+    if (k == 0) {
+        for (int i = 0; i < PH_N; i++) if (s_ph_pend[i]) {
+            GLint ok = 0; p_glGetQueryObjectiv(s_ph_q[i][3], GL_QUERY_RESULT_AVAILABLE, &ok);
+            if (!ok) continue;
