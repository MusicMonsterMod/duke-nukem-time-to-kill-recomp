diff --git a/runtime/src/render_copy/gen_names.py b/runtime/src/render_copy/gen_names.py
new file mode 100644
index 00000000..cf4c5f6d
--- /dev/null
+++ b/runtime/src/render_copy/gen_names.py
@@ -0,0 +1,42 @@
+#!/usr/bin/env python3
+"""Generate rc_names.h and rc2_names.h in this directory (Time to Kill D17AW).
+
+Each render thread runs its own, independent instance of the GPU emulator and
+GL renderer: the same sources compiled again (runtime/src/render_copy/rc_*.c,
+rc2_*.c) with every global symbol they define renamed to rc_<name> (rc2_). File-scope statics
+are per translation unit and so already separate. This script lists the global
+symbols the original objects define and writes the rename header.
+
+Usage: gen_names.py <object dir of the original runtime objects>
+A symbol missing from the header makes the link fail with a duplicate
+definition, so a stale header can never share state silently: rerun this
+script after adding a global to one of the copied sources.
+"""
+import subprocess, sys
+from pathlib import Path
+
+SOURCES = ["gpu.c", "gpu_gl_renderer.c", "gpu_sw_renderer.c", "gpu_render.c",
+           "gpu_vram_dirty.c", "render_replay.c"]
+
+def main():
+    objdir = Path(sys.argv[1])
+    names = set()
+    for s in SOURCES:
+        out = subprocess.run(["nm", "--defined-only", "-g", str(objdir / f"{s}.o")],
+                             capture_output=True, text=True, check=True).stdout
+        for line in out.splitlines():
+            parts = line.split()
+            if len(parts) == 3 and parts[1] in "TDBRCVW":
+                names.add(parts[2])
+    for prefix in ("rc", "rc2"):
+        out = Path(__file__).resolve().parent / f"{prefix}_names.h"
+        guard = f"{prefix.upper()}_NAMES_H"
+        lines = ["/* Generated by gen_names.py - do not edit. */",
+                 f"#ifndef {guard}", f"#define {guard}"]
+        lines += [f"#define {n} {prefix}_{n}" for n in sorted(names)]
+        lines += ["#endif", ""]
+        out.write_text("\n".join(lines))
+        print(f"{out}: {len(names)} symbols")
+
+if __name__ == "__main__":
+    main()
