+/* Written once at exit so the launcher can restore the window as it was left:
+ * fullscreen or windowed after any F11 toggle, the fullscreen kind, and width. */
+static void psx_write_presentation_state(SDL_Window* window) {
+    if (!window || s_presentation_state_path.empty()) return;
+    psx_note_windowed_geometry(window);
+    const bool fullscreen = (SDL_GetWindowFlags(window) & SDL_WINDOW_FULLSCREEN) != 0;
+    int kind = g_fullscreen ? g_fullscreen : s_fullscreen_target;
+#if defined(PSX_SDL3)
+    if (fullscreen) kind = SDL_GetWindowFullscreenMode(window) ? 2 : 1;
+#endif
+    const char* kind_name = kind == 2 ? "exclusive" : "borderless";
+    const int width = s_last_windowed_w >= 0 ? s_last_windowed_w
