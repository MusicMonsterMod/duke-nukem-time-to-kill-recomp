diff --git a/runtime/include/render_replay.h b/runtime/include/render_replay.h
new file mode 100644
index 00000000..e34ef18e
--- /dev/null
+++ b/runtime/include/render_replay.h
@@ -0,0 +1,66 @@
+/* render_replay.h - presentation-only guest render replay (Time to Kill D17).
+ *
+ * A title plugin can re-run the game's own view composition between two real
+ * guest frames to produce extra presented images (high refresh rates). While a
+ * replay is active the machine is frozen: no device advances or is written, no
+ * interrupt is taken, guest time is restored afterwards, and the GPU draws into
+ * VRAM whose previous contents (and every GPU register) are restored at the
+ * end. GP0 words and GPU DMA run synchronously. The caller owns guest RAM: it
+ * must swap in the state it wants rendered and swap the live state back. */
+#ifndef PSX_RENDER_REPLAY_H
+#define PSX_RENDER_REPLAY_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+extern int g_render_replay_active;
+
+/* Begin/end one replay session. begin returns 0 (and changes nothing) when
+ * replays are unavailable (no OpenGL pipeline, nested call). end restores
+ * everything; with capture != 0 the image the replay drew is kept for the
+ * presenter (gl_renderer_replay_*). */
+int render_replay_begin(void);
+int render_replay_end(int capture);
+void render_replay_reset_channel(void);
+
+/* Record mode (render worker processes, no GPU): GP0 traffic is appended to
+ * buf instead of being drawn; render_replay_feed() executes such a stream
+ * into the GPU inside a parent replay session. */
+extern int g_render_replay_record;
+void     render_replay_record_begin(uint32_t *buf, uint32_t cap);
+uint32_t render_replay_record_end(int *overflow);
+int      render_replay_feed(const uint32_t *stream, uint32_t n);
+
+/* Guest memory image: RAM, scratchpad and allocated mod memory (memory.c). */
+size_t render_replay_image_bytes(void);
+void   render_replay_image_save(uint8_t *dst);
+void   render_replay_image_load(const uint8_t *src);
+
+/* MMIO policy while g_render_replay_active (memory.c). */
+uint32_t render_replay_mmio_read(uint32_t addr, int size);
+void     render_replay_mmio_write(uint32_t addr, uint32_t val, int size);
+
+/* Counters for diagnostics (debug server render_replay). */
+typedef struct RenderReplayStats {
+    uint64_t sessions, captured, failed;
+    uint64_t gp0_words, dma_lists, dma_blocks, dma_nodes;
+    uint64_t dropped_writes, faked_reads, dropped_reads;
+    uint32_t last_drop_addr, last_drop_val, last_fake_addr;
+    uint64_t last_us, max_us, total_us;
+    uint64_t begin_us, guest_us, end_us;   /* accumulated phases */
+    uint64_t guest_cycles;                 /* emulated cycles run by replays */
+    uint64_t gpu_us;                       /* host time in GP0/DMA processing */
+    int32_t  last_x, last_y, last_w, last_h;
+} RenderReplayStats;
+const RenderReplayStats *render_replay_stats(void);
+const char *render_replay_plugin_status(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/runtime/include/render_thread.h b/runtime/include/render_thread.h
new file mode 100644
index 00000000..e0623109
--- /dev/null
+++ b/runtime/include/render_thread.h
@@ -0,0 +1,92 @@
+/* render_thread.h - redraws on a host render thread (Time to Kill D17AW).
+ *
+ * The emulation thread used to draw every finished worker redraw into the GL
+ * renderer itself (render_replay.h), about 5 ms each in the heaviest views.
+ * With the render threads on, independent instances of the GPU emulator and
+ * GL renderer (render_copy/, every global renamed rc_* and rc2_*) run on
+ * their own threads with GL contexts shared with the emulation thread's:
+ *
+ *   - at each worker publish the emulation thread snapshots its renderer
+ *     (VRAM surfaces as GPU copies, the CPU VRAM array, GPU emulator and
+ *     widescreen state) into a small ring (gl_rt_capture);
+ *   - psx_mod_replay_render_job queues the redraw instead of drawing it;
+ *   - the render thread loads the snapshot into its instance (gl_rt_load),
+ *     feeds the stream, and captures the image into the shared cache texture;
+ *   - the emulation thread adopts finished images (fenced) and presents them.
+ *
+ * PSX_RENDER_THREAD=0 keeps the single-thread path; any render-thread
+ * failure falls back to it. */
+#ifndef PSX_RENDER_THREAD_H
+#define PSX_RENDER_THREAD_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define RT_WIDE_SURF 4
+#define RT_INSTANCES 2   /* render threads, each with its own renderer instance */
+
+/* One renderer snapshot. GL names are share-group objects created by the
+ * emulation thread's instance; FBOs are per context and kept per side. */
+typedef struct GlRtSnap {
+    /* Shared textures and renderbuffers (emulation thread creates). */
+    unsigned hr_tex, hr_rb, raw_tex;
+    unsigned wide_tex[RT_WIDE_SURF], wide_rb[RT_WIDE_SURF];
+    int      alloc_scale, alloc_wide_w, alloc_wide[RT_WIDE_SURF];
+    unsigned m_hr_fbo, m_raw_fbo, m_wide_fbo[RT_WIDE_SURF];   /* emulation context */
+    /* Per render thread (its context): FBOs and the textures they wrap. */
+    unsigned c_hr_fbo[RT_INSTANCES], c_raw_fbo[RT_INSTANCES], c_wide_fbo[RT_INSTANCES][RT_WIDE_SURF];
+    unsigned c_hr_tex[RT_INSTANCES], c_raw_tex[RT_INSTANCES], c_wide_tex[RT_INSTANCES][RT_WIDE_SURF];
+    /* Renderer state at capture. */
+    int scale, wide_w, wide_off, wide_base[RT_WIDE_SURF];
+    int wide_cur_on, wide_cur_base, wide_suppress, wide_fast, ws_ablate;
+    int off_x, off_y, area_x1, area_y1, area_x2, area_y2;
+    int semi_en, semi_mode, mod_r, mod_g, mod_b, mod_raw, mask_set, mask_check;
+    int tw_mask_x, tw_mask_y, tw_off_x, tw_off_y, tex_filter, stencil_valid;
+    int gpu_dirty, hz_clear_pending, aspect_num, aspect_den;
+    int pack_dirty[5];              /* set, x0, y0, x1, y1 */
+    int rp_path, rp_w, rp_h, rp_base_x, rp_linear, rp_force_4_3;
+    /* CPU-side state. */
+    uint16_t *cpu;                  /* VRAM array copy (1 MB) */
+    uint8_t  gpu[1024];             /* gpu_snapshot_write */
+    uint32_t gpu_len;
+    uint8_t *ws;                    /* gpu_rt_ws_export */
+    uint32_t ws_len;
+    /* Synchronisation. */
+    void    *fence;                 /* GLsync: emulation thread's copies done (it deletes it) */
+    void    *read_fence[RT_INSTANCES];   /* GLsync: each render thread's reads done */
+    uint64_t gen;                   /* bumped at every capture */
+    int      valid;
+} GlRtSnap;
+
+/* Emulation thread. */
+int  psx_rt_enabled(void);               /* switch on and the thread ready */
+void psx_rt_publish(int slot);           /* at a worker publish */
+int  psx_rt_render(int job, const uint32_t *stream, uint32_t words, int slot, int cache);
+int  psx_rt_job_held(int job);           /* the thread still reads the job's stream */
+int  psx_rt_cache_pending(int cache);    /* a redraw for the cache entry is queued or drawing */
+void psx_rt_poll(void);                  /* adopt finished images */
+int  psx_rt_wait(int cache, double max_ms);   /* wait for a queued image */
+void psx_rt_after_present(int slot);     /* a cache image was drawn to the screen */
+void psx_rt_drop(void);                  /* savestate load, mode change: forget work */
+void psx_rt_shutdown(void);
+double psx_rt_latency_ms(void);          /* queue to finished, recent mean */
+const char *psx_rt_status_json(void);
+
+/* The renderer instances (gpu_gl_renderer.c; the render thread's copy is
+ * rc_*). Emulation-thread side: */
+int  gl_rt_capture(GlRtSnap *s);
+void gl_rt_adopt(int cache, unsigned tex, int tw, int th, void *fence);
+int  gl_rt_forget_cache(void);
+/* Render-thread side: */
+int  gl_rt_init_shared(void *window, void *context);
+int  gl_rt_load(GlRtSnap *s, int surfaces, int instance);
+int  gl_rt_cache_image(int cache, unsigned *tex, int *tw, int *th);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/runtime/include/replay_rate.h b/runtime/include/replay_rate.h
new file mode 100644
index 00000000..2159820f
--- /dev/null
+++ b/runtime/include/replay_rate.h
@@ -0,0 +1,39 @@
+#ifndef PSX_REPLAY_RATE_H
+#define PSX_REPLAY_RATE_H
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+/* AUTO uses a whole number of display refreshes per image, capped at 240:
+ * every refresh up to 240 Hz, an even fraction above it (Time to Kill D17AR3
+ * part 4; the title's pacing drops to every 2nd or 3rd refresh, evenly, where
+ * a scene cannot keep up). Keep fractional refresh (119.88, 239.76, etc.).
+ * Unknown/invalid display modes fall back to 60 without assuming VRR. */
+/* D23P (Time to Kill): AUTO also stays within what the CPUs can redraw. A
+ * redraw is re-run by a worker process and drawn by a render thread beside
+ * the emulation thread; measured (note 450): 8 or more logical CPUs hold the
+ * display rate up to 240, 4 hold 180 in light views but about 110 in the
+ * heaviest (the level 3 corridor), 2 slow the game itself. So AUTO takes at
+ * most 120 images a second with 4-7 CPUs and 60 (no redraws) below 4, as a
+ * whole number of refreshes as before. Developer PSX_AUTO_CPUS=N assumes N
+ * CPUs. A fixed rate is never changed. */
+extern int psx_host_cpus(void);   /* render_thread.c */
+static inline double replay_auto_cap(void) {
+    static double cap = -1.0;
+    if (cap < 0.0) {
+        const char *e = getenv("PSX_AUTO_CPUS");
+        const int n = e && atoi(e) > 0 ? atoi(e) : psx_host_cpus();
+        cap = n >= 8 ? 240.0 : n >= 4 ? 120.0 : 60.0;
+        fprintf(stdout, "psxrecomp: AUTO frame rate: at most %.0f images a second (%d CPUs; PSX_AUTO_CPUS overrides)\n", cap, n);
+    }
+    return cap;
+}
+static inline double replay_resolved_hz(double requested, double host) {
+    if (requested == -2.0) {
+        if (!isfinite(host) || host < 1.0 || host > 1000.0) return 60.0;
+        return host / ceil(host / replay_auto_cap());
+    }
+    if (requested > 0.0) return requested;
+    if (requested < 0.0) return 1000.0;
+    return host;
+}
+#endif
