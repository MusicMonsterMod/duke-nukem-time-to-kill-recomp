+/* ---- Render replay (Time to Kill D17) ------------------------------------
+ * render_replay.c freezes the guest while a title plugin re-runs the game's
+ * view composition. Everything the GPU can mutate is saved here first and put
+ * back afterwards: the hr FBO (colour + mask stencil), the raw texture mirror,
+ * every native-wide surface, the CPU VRAM array, the coherence bookkeeping and
+ * the mirrored draw state. The replayed frame is copied out before the
+ * restore, so presenting it never touches guest-visible VRAM. */
+static GLuint s_rr_hr_tex, s_rr_hr_rb, s_rr_hr_fbo;
+static GLuint s_rr_raw_tex, s_rr_raw_fbo;
+static GLuint s_rr_wide_tex[WIDE_MAX_SURF], s_rr_wide_rb[WIDE_MAX_SURF], s_rr_wide_fbo[WIDE_MAX_SURF];
+static int    s_rr_scale = 0, s_rr_wide_w = 0;
+static int    s_rr_last_x = -1, s_rr_last_y = -1;
+static uint16_t *s_rr_cpu = NULL;
+/* D17AR5: the CPU VRAM array is saved for a session only when something is
+ * about to write it (uploads, point writes, a readback); most redraws write
+ * none, and the two full copies showed in every redraw. */
+/* D23O part 2: by row. A redraw's uploads and point writes touch a few rows;
+ * saving the whole 1 MB array for them (and putting it back) cost the render
+ * thread about 3%. Each row is saved before its first write in a session and
+ * only the saved rows are put back. */
+static int s_rr_cpu_saved = 0;                 /* rows saved this session */
+static uint8_t  s_rr_row_saved[VRAM_H];
+static uint16_t s_rr_row_list[VRAM_H];
+void gl_replay_cpu_vram_touch_rows(int y, int h) {
+    if (!s_rr_active) return;
+    if (h > VRAM_H) h = VRAM_H;
+    for (int i = 0; i < h; i++) {
+        const int r = (y + i) & (VRAM_H - 1);
+        if (s_rr_row_saved[r]) continue;
+        memcpy(s_rr_cpu + (size_t)r * VRAM_W, s_vram + (size_t)r * VRAM_W, VRAM_W * sizeof(uint16_t));
+        s_rr_row_saved[r] = 1; s_rr_row_list[s_rr_cpu_saved++] = (uint16_t)r;
+    }
+}
+void gl_replay_cpu_vram_touch(void) { gl_replay_cpu_vram_touch_rows(0, VRAM_H); }
+static void rr_cpu_restore(void) {
