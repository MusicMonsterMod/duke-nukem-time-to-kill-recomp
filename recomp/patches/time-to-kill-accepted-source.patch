+        psx_rt_drop();
+        const int released = gl_rt_forget_cache();
+        fprintf(stdout, "psxrecomp: render thread off: %d queued redraw(s) dropped, %d cache image(s) released\n",
+                queued, released);
+    }
+}
+
+/* The request thread k takes next: one for the snapshot already in its
+ * surfaces (a full load copies every VRAM surface), else the oldest. */
+static int pick_request(int k) {
+    const RtThread *t = &s_th[k];
+    /* D23O: the second instance helps only while the first is drawing
+     * (a backlog); in lighter views it stays idle and loads nothing. */
+    if (k > 0 && s_th[0].busy_t0 == 0) return -1;
+    for (int i = 0; i < s_q_n; i++)
+        if (s_q[i].snap == t->loaded_snap && s_snap[s_q[i].snap].gen == t->loaded_gen) return i;
+    return s_q_n ? 0 : -1;
+}
+
+/* D23O part 2: a redraw identical to the thread's last one is reused (D23J).
+ * The check kept a copy of the whole stream and compared it (a copy and a
+ * compare of 100-400 KB a redraw); a 128-bit hash of four independent lanes
+ * reads it once instead. */
+static void stream_hash(const uint32_t *w, uint32_t words, uint64_t out[2]) {
+    uint64_t a = 0x9e3779b97f4a7c15ull, b = 0xc2b2ae3d27d4eb4full, c = 0x165667b19e3779f9ull, d = 0x27d4eb2f165667c5ull;
+    const uint64_t K1 = 0x87c37b91114253d5ull, K2 = 0x4cf5ad432745937full;
+    uint32_t i = 0;
+    for (; i + 8 <= words; i += 8) {
+        uint64_t x0, x1, x2, x3;
+        memcpy(&x0, w + i, 8); memcpy(&x1, w + i + 2, 8); memcpy(&x2, w + i + 4, 8); memcpy(&x3, w + i + 6, 8);
+        a = (a ^ x0) * K1; a ^= a >> 29;
+        b = (b ^ x1) * K2; b ^= b >> 31;
+        c = (c ^ x2) * K1; c ^= c >> 27;
+        d = (d ^ x3) * K2; d ^= d >> 33;
+    }
+    for (; i < words; i++) { a = (a ^ w[i]) * K1; a ^= a >> 29; }
+    a ^= (uint64_t)words; b ^= (uint64_t)words * K1;
+    out[0] = (a ^ (c * K2)) * K1; out[0] ^= out[0] >> 32;
+    out[1] = (b ^ (d * K1)) * K2; out[1] ^= out[1] >> 31;
+    out[1] ^= out[0] * 0x9e3779b97f4a7c15ull;
+}
+static void *thread_main(void *arg) {
+    const int k = (int)(intptr_t)arg;
+    RtThread *t = &s_th[k];
+    const RtApi *api = &RT_APIS[k];
+#if defined(__linux__)
+    pthread_setname_np(pthread_self(), k ? "psx-render1" : "psx-render0");   /* for profiles and /proc */
+#endif
+    if (SDL_GL_MakeCurrent(t->hidden, t->ctx) != 0) {
+        fprintf(stdout, "psxrecomp: render thread %d: MakeCurrent failed (%s)\n", k, SDL_GetError());
+        atomic_store(&s_state, -1);
+        return NULL;
+    }
+    api->set_backend(GR_BACKEND_OPENGL);
+    api->gpu_init();
+    api->set_scale(gr_scale());
+    api->set_texture_filter(gr_texture_filter());
+    if (!api->init_shared(t->hidden, t->ctx)) {
+        fprintf(stdout, "psxrecomp: render thread %d: renderer init failed\n", k);
+        atomic_store(&s_state, -1);
+        return NULL;
+    }
+    t->loaded_snap = -1;
+    /* PSX_PROF_RT=1 (developer, with PSX_PROF): profile render thread 0
+     * instead of the emulation thread (main.cpp skips its start). */
+    if (k == 0) { const char *e = getenv("PSX_PROF_RT"); if (e && e[0] == '1') { extern void host_profiler_start(void); host_profiler_start(); } }
+    if (atomic_fetch_add(&s_ready_n, 1) + 1 == s_threads && atomic_load(&s_state) == 1) {
+        atomic_store(&s_state, 2);
+        fprintf(stdout, "psxrecomp: %d render thread(s) ready (shared GL contexts)\n", s_threads);
+    }
+    pthread_mutex_lock(&s_mu);
+    while (atomic_load(&s_running)) {
+        const int qi = pick_request(k);
+        if (qi < 0) { pthread_cond_wait(&s_cv, &s_mu); continue; }
+        RtReq r = s_q[qi];
+        memmove(&s_q[qi], &s_q[qi + 1], (size_t)(s_q_n - qi - 1) * sizeof(RtReq));
+        s_q_n--;
+        if (s_res[r.cache].epoch == r.epoch) s_res[r.cache].drawing = 1;
+        t->busy_t0 = SDL_GetPerformanceCounter();
+        if (k == 0 && s_q_n > 0 && s_threads > 1) pthread_cond_broadcast(&s_cv);   /* the helper may take the rest */
+        GlRtSnap *sn = &s_snap[r.snap];
+        const int surfaces = t->loaded_snap != r.snap || t->loaded_gen != sn->gen;
+        const uint64_t tl = SDL_GetPerformanceCounter();
+        int ok = sn->valid && api->load(sn, surfaces, k);
+        if (ok && surfaces) { t->loaded_snap = r.snap; t->loaded_gen = sn->gen; t->surface_loads++; s_surface_loads++; }
+        if (!ok) t->loaded_snap = -1;
+        s_load_ms += (ms_since(tl) - s_load_ms) * 0.1;
+        pthread_mutex_unlock(&s_mu);
+
+        unsigned tex = 0; int tw = 0, th = 0; void *fence = NULL;
+        if (r.read_fence) { p_WaitSync(r.read_fence, 0, RT_TIMEOUT_IGNORED); p_DeleteSync(r.read_fence); }
+        const uint64_t ts = SDL_GetPerformanceCounter();
+        const int edges = __atomic_load_n(&g_psx_shadow_edges, __ATOMIC_RELAXED);
+        int reused = 0;
+        uint64_t sh[2] = { 0, 0 };
+        if (ok && reuse_on()) stream_hash(r.stream, r.words, sh);
+        if (ok && reuse_on() && t->last_have && t->last_snap == r.snap && t->last_gen == sn->gen &&
+            t->last_edges == edges && t->last_words == r.words && t->last_hash[0] == sh[0] && t->last_hash[1] == sh[1])
+            reused = api->copy_cache(t->last_cache, r.cache);
+        /* D23O part 2: the snapshot's GPU and widescreen state go straight into
+         * this instance (one copy, outside s_mu; the reference keeps the
+         * snapshot from being recaptured meanwhile), and not at all for a reuse.
+         * D23M: the reference is held until the session ends, since the
+         * session puts back what it overwrites from the snapshot's textures. */
+        if (!reused && ok) ok = api->import(sn->gpu, sn->gpu_len, sn->ws);
+        if (!reused) {
+            t->last_snap = -1;
+            if (ok) ok = api->session(r.stream, r.words, r.cache);
+        }
+        if (ok) ok = api->cache_image(r.cache, &tex, &tw, &th);
+        if (ok && !reused && reuse_on()) {
+            {
+                t->last_hash[0] = sh[0]; t->last_hash[1] = sh[1]; t->last_have = 1;
+                t->last_words = r.words; t->last_snap = r.snap; t->last_gen = sn->gen; t->last_edges = edges;
+            }
+        }
+        if (ok) t->last_cache = r.cache;
+        if (reused) { t->reused++; }
+        if (ok) { fence = p_FenceSync(RT_SYNC_GPU_COMMANDS_COMPLETE, 0); p_Flush(); }
+        const double session = ms_since(ts);
+
+        pthread_mutex_lock(&s_mu);
+        s_snap_refs[r.snap]--;
+        s_held[r.job] = 0;
+        s_sessions++;
+        if (reused) s_reused++;
+        t->sessions++;
+        if (!ok) s_failed++;
+        s_session_ms += (session - s_session_ms) * 0.1;
+        {
+            const double lat = ms_since(r.queued);
+            s_lat_ms += (lat - s_lat_ms) * 0.1;
+            s_lat_ring[s_lat_n++ % 64u] = lat;
+        }
+        t->busy_ms += ms_since(t->busy_t0);
+        t->busy_t0 = 0;
+        RtResult *res = &s_res[r.cache];
+        res->drawing = 0;
+        if (res->state == 1 && res->epoch == r.epoch) {
+            if (res->fence) p_DeleteSync(res->fence);
+            res->state = ok ? 2 : 3; res->tex = tex; res->tw = tw; res->th = th; res->fence = fence;
+        } else if (fence) {
+            p_DeleteSync(fence);   /* dropped while it was drawn */
+        }
+        pthread_cond_broadcast(&s_done_cv);
+    }
+    pthread_mutex_unlock(&s_mu);
+    SDL_GL_MakeCurrent(t->hidden, NULL);
+    return NULL;
+}
+
+/* Emulation thread, GL current: create the shared contexts and the threads. */
+static void start(void) {
+    atomic_store(&s_state, 1);
+    {
+        /* D23O (Time to Kill): one render thread draws every redraw; in heavy
+         * views (the level 3 corridor at 180 Hz) it ran at about 90% and
+         * missed 125-824 finished redraws a run, which switched redraw-only
+         * off for a quarter second at a time. Both instances held every
+         * redraw there. They cost about 0.75 core more, so they are used
+         * where the CPUs allow (8 or more this process may run on). */
+        const int cpus = psx_host_cpus();
+        s_threads = cpus >= 8 ? 2 : 1;
+        const char *e = getenv("PSX_RENDER_THREADS");
+        if (e && (e[0] == '1' || e[0] == '2') && !e[1]) s_threads = e[0] - '0';
+        fprintf(stdout, "psxrecomp: render threads: %d (%d CPUs; PSX_RENDER_THREADS=1|2 overrides)\n", s_threads, cpus);
+    }
+    SDL_Window *main_win = SDL_GL_GetCurrentWindow();
+    SDL_GLContext main_ctx = SDL_GL_GetCurrentContext();
+    p_FenceSync  = (PFN_rtFenceSync)SDL_GL_GetProcAddress("glFenceSync");
+    p_WaitSync   = (PFN_rtWaitSync)SDL_GL_GetProcAddress("glWaitSync");
+    p_DeleteSync = (PFN_rtDeleteSync)SDL_GL_GetProcAddress("glDeleteSync");
+    p_Flush      = (PFN_rtFlush)SDL_GL_GetProcAddress("glFlush");
+    if (!main_win || !main_ctx || !p_FenceSync || !p_WaitSync || !p_DeleteSync || !p_Flush) {
+        atomic_store(&s_state, -1);
+        return;
+    }
+    for (int k = 0; k < s_threads; k++) {
+        RtThread *t = &s_th[k];
+        t->hidden = SDL_CreateWindow("psxrecomp render thread", 0, 0, 16, 16,
+                                     SDL_WINDOW_OPENGL | SDL_WINDOW_HIDDEN);
+        if (t->hidden) {
+            SDL_GL_SetAttribute(SDL_GL_SHARE_WITH_CURRENT_CONTEXT, 1);
+            SDL_GL_MakeCurrent(main_win, main_ctx);   /* share with the emulation context */
+            t->ctx = SDL_GL_CreateContext(t->hidden);
+            SDL_GL_SetAttribute(SDL_GL_SHARE_WITH_CURRENT_CONTEXT, 0);
+        }
+        SDL_GL_MakeCurrent(main_win, main_ctx);
+        if (!t->ctx) {
+            fprintf(stdout, "psxrecomp: render thread %d: shared context failed (%s)\n", k, SDL_GetError());
+            atomic_store(&s_state, -1);
+            return;
+        }
+        SDL_GL_MakeCurrent(t->hidden, NULL);   /* release it for its thread */
+        SDL_GL_MakeCurrent(main_win, main_ctx);
+    }
+    atomic_store(&s_running, 1);
+    /* exit() (debug quit, fatal paths) must stop the threads before the GL
+     * driver's own exit handlers, registered earlier, tear it down. */
+    atexit(psx_rt_shutdown);
+    for (int k = 0; k < s_threads; k++) {
+        if (pthread_create(&s_th[k].thread, NULL, thread_main, (void *)(intptr_t)k) != 0) {
+            atomic_store(&s_state, -1);
+            break;
+        }
+        s_th[k].started = 1;
+    }
+}
+
+int psx_rt_enabled(void) {
+    if (!switch_on()) return 0;
+    const int st = atomic_load(&s_state);
+    if (st == 0) start();
+    return atomic_load(&s_state) == 2;
+}
+
+void psx_rt_publish(int slot) {
+    if (!psx_rt_enabled() || slot < 0 || slot >= RT_SLOTS) return;
+    pthread_mutex_lock(&s_mu);
+    int pick = -1;
+    for (int i = 0; i < RT_SNAPS; i++) {
+        if (s_snap_refs[i]) continue;
+        if (pick < 0 || s_snap[i].gen < s_snap[pick].gen) pick = i;
+    }
+    if (pick < 0) { s_publish_busy++; pthread_mutex_unlock(&s_mu); return; }   /* all in use: keep the old one */
+    GlRtSnap *s = &s_snap[pick];
+    const uint32_t ws_len = gpu_rt_ws_bytes(), gpu_len = gpu_snapshot_bytes();
+    if (!s->ws) s->ws = (uint8_t *)malloc(ws_len);
+    s->valid = 0;
+    if (s->ws && gpu_len <= sizeof s->gpu && gl_rt_capture(s)) {
+        gpu_snapshot_write(s->gpu);
+        s->gpu_len = gpu_len;
+        gpu_rt_ws_export(s->ws);
+        s->ws_len = ws_len;
+        s->gen = ++s_snap_gen;
+        s->valid = 1;
+        s_slot_snap[slot] = pick;
+        s_captures++;
+    } else {
+        s_capture_fail++;
+        for (int i = 0; i < RT_SLOTS; i++) if (s_slot_snap[i] == pick) s_slot_snap[i] = -1;
+    }
+    pthread_mutex_unlock(&s_mu);
+}
+
+int psx_rt_render(int job, const uint32_t *stream, uint32_t words, int slot, int cache) {
+    if (atomic_load(&s_state) != 2 || job < 0 || job >= RT_JOBS || cache < 0 || cache >= RT_CACHE ||
+        slot < 0 || slot >= RT_SLOTS)
+        return 0;
+    pthread_mutex_lock(&s_mu);
+    const int snap = s_slot_snap[slot];
+    if (snap < 0 || !s_snap[snap].valid) { pthread_mutex_unlock(&s_mu); return 0; }
+    if (s_q_n >= RT_QUEUE || s_res[cache].state == 1 || s_held[job]) {
+        s_refused++;
+        pthread_mutex_unlock(&s_mu);
+        return -1;
+    }
+    RtReq *r = &s_q[s_q_n];
+    r->job = job; r->slot = slot; r->cache = cache; r->snap = snap;
+    r->stream = stream; r->words = words;
+    r->read_fence = s_main_read[cache]; s_main_read[cache] = NULL;   /* the thread deletes it */
+    r->epoch = s_epoch;
+    r->queued = SDL_GetPerformanceCounter();
+    s_q_n++;
+    if ((uint64_t)s_q_n > s_q_max) s_q_max = (uint64_t)s_q_n;
+    s_snap_refs[snap]++;
+    s_held[job] = 1;
+    RtResult *res = &s_res[cache];
+    if (res->fence) { p_DeleteSync(res->fence); res->fence = NULL; }
+    res->state = 1; res->epoch = s_epoch; res->drawing = 0;
+    pthread_cond_broadcast(&s_cv);
+    pthread_mutex_unlock(&s_mu);
+    return 1;
+}
+
+int psx_rt_job_held(int job) {
+    if (atomic_load(&s_state) != 2 || job < 0 || job >= RT_JOBS) return 0;
+    pthread_mutex_lock(&s_mu);
+    const int held = s_held[job];
+    pthread_mutex_unlock(&s_mu);
+    return held;
+}
+
+int psx_rt_cache_pending(int cache) {
+    if (atomic_load(&s_state) != 2 || cache < 0 || cache >= RT_CACHE) return 0;
+    pthread_mutex_lock(&s_mu);
+    const int pending = s_res[cache].state == 1;
+    pthread_mutex_unlock(&s_mu);
+    return pending;
+}
+
+/* Emulation thread: a present is due and wants the image queued for `cache`.
+ * Wait for it up to max_ms (the single-thread path drew it right then), but
+ * only while a render thread is already drawing it, and within a budget of
+ * 30 ms of waiting per second: when the render threads fall behind, waiting
+ * would take the time the game itself needs. */
+static uint64_t s_waits = 0, s_wait_hits = 0, s_wait_skips = 0, s_wait_t = 0;
+static double s_wait_ms = 0.0, s_wait_tokens = 30.0;
+int psx_rt_wait(int cache, double max_ms) {
+    if (atomic_load(&s_state) != 2 || cache < 0 || cache >= RT_CACHE || max_ms <= 0.0) return 0;
+    const uint64_t t0 = SDL_GetPerformanceCounter();
+    if (s_wait_t) {
+        const double f = (double)SDL_GetPerformanceFrequency();
+        s_wait_tokens += (double)(t0 - s_wait_t) / f * 30.0;
+        if (s_wait_tokens > 30.0) s_wait_tokens = 30.0;
+    }
+    s_wait_t = t0;
+    if (max_ms > s_wait_tokens) max_ms = s_wait_tokens;
+    pthread_mutex_lock(&s_mu);
+    const int drawing = s_res[cache].state == 1 && s_res[cache].drawing;
+    pthread_mutex_unlock(&s_mu);
+    if (!drawing || max_ms < 0.25) { s_wait_skips++; return 0; }
+    struct timespec until;
+    clock_gettime(CLOCK_REALTIME, &until);
+    long ns = until.tv_nsec + (long)(max_ms * 1e6);
+    until.tv_sec += ns / 1000000000L; until.tv_nsec = ns % 1000000000L;
+    pthread_mutex_lock(&s_mu);
+    s_waits++;
+    while (s_res[cache].state == 1)
+        if (pthread_cond_timedwait(&s_done_cv, &s_mu, &until) != 0) break;
+    const int done = s_res[cache].state == 2;
+    if (done) s_wait_hits++;
+    const double waited = ms_since(t0);
+    s_wait_ms += waited;
+    s_wait_tokens -= waited;
+    pthread_mutex_unlock(&s_mu);
+    if (done) psx_rt_poll();
+    return done;
+}
+
+void psx_rt_poll(void) {
+    if (atomic_load(&s_state) != 2) return;
+    RtResult done[RT_CACHE];
+    int n = 0, which[RT_CACHE];
+    pthread_mutex_lock(&s_mu);
+    for (int c = 0; c < RT_CACHE; c++) {
+        RtResult *r = &s_res[c];
+        if (r->state != 2 && r->state != 3) continue;
+        if (r->epoch == s_epoch && r->state == 2) { done[n] = *r; which[n++] = c; }
+        else if (r->fence) { p_DeleteSync(r->fence); s_stale++; }
+        r->state = 0; r->fence = NULL;
+    }
+    pthread_mutex_unlock(&s_mu);
+    for (int i = 0; i < n; i++) {
+        gl_rt_adopt(which[i], done[i].tex, done[i].tw, done[i].th, done[i].fence);
+        s_adopted++;
+    }
+}
+
+void psx_rt_after_present(int slot) {
+    const int cache = slot - 1;
+    if (atomic_load(&s_state) != 2 || cache < 0 || cache >= RT_CACHE) return;
+    void *f = p_FenceSync(RT_SYNC_GPU_COMMANDS_COMPLETE, 0);
+    p_Flush();
+    pthread_mutex_lock(&s_mu);
+    if (s_main_read[cache]) p_DeleteSync(s_main_read[cache]);
+    s_main_read[cache] = f;
+    pthread_mutex_unlock(&s_mu);
+}
+
+void psx_rt_drop(void) {
+    if (atomic_load(&s_state) != 2) return;
+    pthread_mutex_lock(&s_mu);
+    for (int i = 0; i < s_q_n; i++) {
+        RtReq *r = &s_q[i];
+        s_snap_refs[r->snap]--;
+        s_held[r->job] = 0;
+        if (r->read_fence) p_DeleteSync(r->read_fence);
+    }
+    s_q_n = 0;
+    s_epoch++;
+    for (int c = 0; c < RT_CACHE; c++) {
+        if (s_res[c].fence) p_DeleteSync(s_res[c].fence);
+        s_res[c].fence = NULL;
+        if (s_res[c].state != 1) s_res[c].state = 0;   /* a drawn one is discarded on return */
+    }
+    for (int i = 0; i < RT_SLOTS; i++) s_slot_snap[i] = -1;
+    pthread_mutex_unlock(&s_mu);
+}
+
+void psx_rt_shutdown(void) {
+    if (!atomic_load(&s_running)) return;
+    pthread_mutex_lock(&s_mu);
+    atomic_store(&s_running, 0);
+    pthread_cond_broadcast(&s_cv);
+    pthread_mutex_unlock(&s_mu);
+    for (int k = 0; k < RT_INSTANCES; k++)
+        if (s_th[k].started) { pthread_join(s_th[k].thread, NULL); s_th[k].started = 0; }
+    atomic_store(&s_state, 0);
+}
+
+static int cmp_double(const void *a, const void *b) {
+    const double x = *(const double *)a, y = *(const double *)b;
+    return (x > y) - (x < y);
+}
+double psx_rt_latency_ms(void) {
+    if (atomic_load(&s_state) != 2) return 0.0;
+    double v[64];
+    pthread_mutex_lock(&s_mu);
+    const unsigned n = s_lat_n < 64u ? s_lat_n : 64u;
+    memcpy(v, s_lat_ring, n * sizeof(double));
+    pthread_mutex_unlock(&s_mu);
+    if (!n) return 0.0;
+    qsort(v, n, sizeof(double), cmp_double);
+    return v[(n * 9u) / 10u];
+}
+
+extern void rc_gl_renderer_batch_diag(uint64_t out[8]);
+extern void rc2_gl_renderer_batch_diag(uint64_t out[8]);
+const char *psx_rt_status_json(void) {
+    static char out[1100];
+    uint64_t b0[8], b1[8];
+    rc_gl_renderer_batch_diag(b0); rc2_gl_renderer_batch_diag(b1);   /* plain counters, read racily */
+    pthread_mutex_lock(&s_mu);
+    double busy[RT_INSTANCES];
+    for (int k = 0; k < RT_INSTANCES; k++)
+        busy[k] = s_th[k].busy_ms + (s_th[k].busy_t0 ? ms_since(s_th[k].busy_t0) : 0.0);
+    snprintf(out, sizeof out,
+             "{\"switch\":%d,\"state\":%d,\"sessions\":%llu,\"failed\":%llu,\"refused\":%llu,"
+             "\"captures\":%llu,\"capture_fail\":%llu,\"adopted\":%llu,\"stale\":%llu,"
+             "\"surface_loads\":%llu,\"queue\":%d,\"queue_max\":%llu,\"latency_ms\":%.3f,"
+             "\"session_ms\":%.3f,\"load_ms\":%.3f,\"threads\":%d,\"busy_ms\":[%.1f,%.1f],"
+             "\"thread_sessions\":[%llu,%llu],\"thread_loads\":[%llu,%llu],"
+             "\"validate\":{\"exact\":%llu,\"bad\":%llu,\"skipped\":%llu},"
+             "\"waits\":%llu,\"wait_hits\":%llu,\"wait_skips\":%llu,\"wait_ms\":%.1f,\"reused\":%llu,\"batches\":[%llu,%llu],\"publish_busy\":%llu}",
+             switch_on(), atomic_load(&s_state), (unsigned long long)s_sessions,
+             (unsigned long long)s_failed, (unsigned long long)s_refused,
+             (unsigned long long)s_captures, (unsigned long long)s_capture_fail,
+             (unsigned long long)s_adopted, (unsigned long long)s_stale,
+             (unsigned long long)s_surface_loads, s_q_n, (unsigned long long)s_q_max,
+             s_lat_ms, s_session_ms, s_load_ms, s_threads, busy[0], busy[1],
+             (unsigned long long)s_th[0].sessions, (unsigned long long)s_th[1].sessions,
+             (unsigned long long)s_th[0].surface_loads, (unsigned long long)s_th[1].surface_loads,
+             (unsigned long long)s_val_exact, (unsigned long long)s_val_bad, (unsigned long long)s_val_skip,
+             (unsigned long long)s_waits, (unsigned long long)s_wait_hits, (unsigned long long)s_wait_skips, s_wait_ms, (unsigned long long)s_reused,
+             (unsigned long long)b0[0], (unsigned long long)b1[0], (unsigned long long)s_publish_busy);
+    pthread_mutex_unlock(&s_mu);
+    return out;
+}
+
+#else  /* no POSIX threads: the single-thread path only */
+
+void psx_mod_set_render_thread(int on) { (void)on; }
+int psx_rt_wait(int cache, double max_ms) { (void)cache; (void)max_ms; return 0; }
+int psx_rt_enabled(void) { return 0; }
+void psx_rt_publish(int slot) { (void)slot; }
+int psx_rt_render(int job, const uint32_t *stream, uint32_t words, int slot, int cache) {
+    (void)job; (void)stream; (void)words; (void)slot; (void)cache; return 0;
+}
+int psx_rt_job_held(int job) { (void)job; return 0; }
+int psx_rt_cache_pending(int cache) { (void)cache; return 0; }
+void psx_rt_poll(void) {}
+void psx_rt_after_present(int slot) { (void)slot; }
+void psx_rt_drop(void) {}
+void psx_rt_shutdown(void) {}
+double psx_rt_latency_ms(void) { return 0.0; }
+const char *psx_rt_status_json(void) { return "{\"switch\":0,\"state\":0}"; }
+void psx_rt_note_validation(int exact) { (void)exact; }
+
+#endif
diff --git a/runtime/src/render_worker.c b/runtime/src/render_worker.c
new file mode 100644
index 00000000..40de1df7
--- /dev/null
+++ b/runtime/src/render_worker.c
@@ -0,0 +1,615 @@
+/* render_worker.c - render replay worker processes (Time to Kill D17).
+ *
+ * Re-running a game's view composition costs as much host time as the game's
+ * own frame, which the emulation thread cannot spare. Workers are forked
+ * copies of this process that run replays on other cores. A worker never
+ * touches the GPU, audio, SDL or the live machine: the parent publishes a
+ * guest memory image plus CPU state into shared memory, a worker loads it into
+ * its own (copy-on-write) memory, runs the title plugin's draw callback with
+ * the frozen-machine MMIO policy in record mode (render_replay.c), and returns
+ * the GP0 stream. The parent executes that stream into the GPU inside a normal
+ * replay session, so VRAM and GPU state are still restored afterwards.
+ *
+ * Workers are re-forked when guest code overlays change (their host-side
+ * dispatch state is a fork-time copy) and when the plugin asks. A worker that
+ * dies or overruns its job deadline is killed and replaced; the parent never
+ * waits on one. POSIX only; elsewhere the API reports "unavailable". */
+#include "render_replay.h"
+#include "cpu_state.h"
+#include "mod_plugins.h"
+#include "psx_cycles.h"
+#include "psx_sdl.h"
+#include "render_thread.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+
+#if defined(__linux__) || defined(__APPLE__)
+#define RW_POSIX 1
+#include <errno.h>
+#include <signal.h>
+#include <stdatomic.h>
+#include <sys/mman.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+#if defined(__linux__)
+#include <sys/prctl.h>
+#endif
+#endif
+
+static int s_visual_timing = 0;
+void psx_mod_replay_workers_visual_timing(int enabled) {
+    if(!g_render_replay_active) s_visual_timing=enabled!=0;
+}
+
+#define RW_MAX_WORKERS 8
+#define RW_SLOTS       8
+#define RW_JOBS        32
+#define RW_PARAMS      65536
+/* A redraw's GP0 stream. Host precise vertices take ten words each, so a
+ * frame drawn by a title's own renderer (Time to Kill host visibility: about
+ * 220K words at the castle) overflowed the former 192K and the redraw was
+ * dropped. Pages are touched only as far as a stream reaches. */
+#define RW_OUT_WORDS   (1024u * 1024u)
+#define RW_JOB_DEADLINE_MS 250
+
+enum { RW_FREE = 0, RW_QUEUED = 1, RW_RUNNING = 2, RW_DONE = 3, RW_FAILED = 4 };
+
+#if RW_POSIX
+typedef struct RwJob {
+    _Atomic uint32_t state;
+    _Atomic uint32_t discard;   /* released while queued/running: free on completion */
+    _Atomic uint32_t loaded;    /* the worker has copied the slot image */
+    _Atomic int32_t worker;
+    uint32_t slot, params_len, out_words, ok, overflow;
+    uint64_t tag, done_ticks;
+    _Atomic uint64_t start_ticks;
+    uint8_t  params[RW_PARAMS];
+} RwJob;
+
+typedef struct RwShared {
+    uint32_t magic;
+    _Atomic uint32_t shutdown;
+    RwJob jobs[RW_JOBS];
+    CPUState slot_cpu[RW_SLOTS];
+    int32_t  slot_ws_margin[RW_SLOTS];   /* widescreen reveal at publish time */
+    _Atomic uint32_t slot_ready[RW_SLOTS];
+} RwShared;
+
+static RwShared *s_sh = NULL;
+static uint8_t  *s_images = NULL;     /* RW_SLOTS images */
+static uint32_t *s_out = NULL;        /* RW_JOBS output streams */
+static size_t    s_image_bytes = 0, s_map_bytes = 0;
+static pid_t     s_pids[RW_MAX_WORKERS];
+static int       s_count = 0, s_wanted = 0;
+static pid_t     s_parent = 0;
+static PSXModReplayDrawFn s_draw = NULL;
+static uint32_t  s_overlay_loads = 0, s_mod_used = 0;
+extern uint32_t  psx_mod_memory_used_bytes(void);
+static uint64_t  s_spawns = 0, s_deaths = 0, s_kills = 0, s_jobs_done = 0, s_jobs_failed = 0, s_jobs_overflow = 0;
+static uint64_t  s_job_us_total = 0, s_job_us_max = 0;
+
+extern void overlay_loader_get_counters(uint32_t *loads, uint32_t *invalidations,
+                                        uint32_t *unregistered,
+                                        uint64_t *disp_native, uint64_t *disp_interp,
+                                        uint64_t *stale_blocked,
+                                        uint32_t *last_write_pc,
+                                        uint32_t *last_write_addr,
+                                        uint32_t *last_write_size,
+                                        int *regions, uint32_t *revalidations);
+extern void debug_server_set_fmv_quiet(int quiet);
+extern int  psx_ws_x_margin(void);
+extern void gpu_ws_set_margin_override(int v);
+
+static uint32_t overlay_loads_now(void) {
+    uint32_t loads = 0, inval = 0, unreg = 0, pc = 0, addr = 0, size = 0, reval = 0;
+    uint64_t dn = 0, di = 0, stale = 0;
+    int regions = 0;
+    overlay_loader_get_counters(&loads, &inval, &unreg, &dn, &di, &stale,
+                                &pc, &addr, &size, &regions, &reval);
+    // Only a newly mapped DLL changes the host functions inherited at fork.
+    // Code invalidations are guest-image changes: image_load reconstructs the
+    // text guards and invalidates all native/interpreter validation caches.
+    // Reforking for each retired movie candidate stalls the first gameplay
+    // frames even though the existing workers can validate their own image.
+    static uint32_t last_loads=~0u,last_inval=~0u;
+    static int profile=-1;
+    if(profile<0) profile=getenv("PSX_REPLAY_PROFILE")!=NULL;
+    if (profile && (loads!=last_loads || inval!=last_inval)) {
+        fprintf(stderr,"[replay code] dlls=%u invalidations=%u\n",loads,inval);
+        last_loads=loads;last_inval=inval;
+    }
+    return loads;
+}
+
+static uint8_t *slot_image(uint32_t slot) { return s_images + (size_t)slot * s_image_bytes; }
+static uint32_t *job_out(uint32_t job) { return s_out + (size_t)job * RW_OUT_WORDS; }
+
+static uint64_t ticks(void) { return SDL_GetPerformanceCounter(); }
+static uint64_t ticks_us(uint64_t t) {
+    const uint64_t f = SDL_GetPerformanceFrequency();
+    return f ? t * 1000000u / f : 0u;
+}
+
+/* ---- worker side -------------------------------------------------------- */
+static void worker_main(int index) {
+#if defined(__linux__)
+    (void)prctl(PR_SET_PDEATHSIG, SIGKILL);
+#endif
+    if (getppid() != s_parent) _exit(0);
+    signal(SIGINT, SIG_IGN);
+    signal(SIGTERM, SIG_DFL);
+    /* A frozen machine for good: no device, interrupt, idle-skip or debug
+     * observer runs here, and GP0 traffic is recorded, never drawn. */
+    g_render_replay_active = 1;
+    g_render_replay_record = 1;
+    psx_in_device_service = 1;
+    const char *untimed=getenv("PSX_REPLAY_UNTIMED");
+    if(untimed ? untimed[0]=='1' : s_visual_timing) {
+        extern int g_psx_load_delay, g_psx_icache_active;
+        g_psx_render_untimed=1;
+        g_psx_load_delay=0; /* timing only; architectural load values unchanged */
+        g_psx_icache_active=0;
+    }
+    debug_server_set_fmv_quiet(1);
+    const int visual_timing=g_psx_render_untimed;
+    const int validate_timing=getenv("PSX_REPLAY_VALIDATE_TIMING")!=NULL;
+    uint32_t *reference=validate_timing ? malloc(RW_OUT_WORDS*sizeof(uint32_t)) : NULL;
+    uint8_t *verify_image=reference ? malloc(s_image_bytes) : NULL;
+    unsigned validated=0;
+    const char *profile=getenv("PSX_PROF_WORKERS");
+    unsigned profile_jobs=0;
+    if(profile && *profile) {
+        char path[512];snprintf(path,sizeof path,"%s-%ld",profile,(long)getpid());
+        setenv("PSX_PROF",path,1);
+        extern void host_profiler_start(void);host_profiler_start();
+    }
+    for (;;) {
+        if (atomic_load(&s_sh->shutdown) || getppid() != s_parent) _exit(0);
+        int claimed = -1;
+        for (int j = 0; j < RW_JOBS; j++) {
+            uint32_t expect = RW_QUEUED;
+            if (atomic_compare_exchange_strong(&s_sh->jobs[j].state, &expect, RW_RUNNING)) {
+                claimed = j;
+                break;
+            }
+        }
+        if (claimed < 0) {
+            struct timespec ts = {0, 250000};
+            nanosleep(&ts, NULL);
+            continue;
+        }
+        RwJob *job = &s_sh->jobs[claimed];
+        job->worker = index;
+        job->start_ticks = ticks();
+        render_replay_image_load(slot_image(job->slot));
+        CPUState cpu = s_sh->slot_cpu[job->slot];
+        const CPUState original_cpu=cpu;
+        if(verify_image) memcpy(verify_image,slot_image(job->slot),s_image_bytes);
+        gpu_ws_set_margin_override(s_sh->slot_ws_margin[job->slot]);
+        atomic_store(&job->loaded, 1u);
+        render_replay_reset_channel();
+        render_replay_record_begin(job_out((uint32_t)claimed), RW_OUT_WORDS);
+        const uint64_t cycle_before=psx_cycle_count;
+        int ok = s_draw ? s_draw(&cpu, job->params, job->params_len) : 0;
+        int overflow = 0;
+        uint32_t n = render_replay_record_end(&overflow);
+        if(reference && verify_image && visual_timing && ok && !overflow) {
+            extern int g_psx_load_delay, g_psx_icache_active;
+            render_replay_image_load(verify_image);
+            CPUState exact=original_cpu;
+            psx_cycle_count=cycle_before;
+            g_psx_render_untimed=0;g_psx_load_delay=1;g_psx_icache_active=1;
+            render_replay_reset_channel();
+            render_replay_record_begin(reference,RW_OUT_WORDS);
+            const int exact_ok=s_draw(&exact,job->params,job->params_len);
+            int exact_overflow=0;const uint32_t nr=render_replay_record_end(&exact_overflow);
+            const int equal=exact_ok && !exact_overflow && nr==n && memcmp(reference,job_out((uint32_t)claimed),n*sizeof(uint32_t))==0;
+            if(!equal) {
+                uint32_t at=0;while(at<n && at<nr && reference[at]==job_out((uint32_t)claimed)[at]) ++at;
+                fprintf(stderr,"[replay timing] FAIL words=%u/%u first=%u\n",n,nr,at);ok=0;
+            }
+            if(++validated%16==0) fprintf(stderr,"[replay timing] checked=%u last=%s\n",validated,equal?"exact":"FAIL");
+            g_psx_render_untimed=1;g_psx_load_delay=0;g_psx_icache_active=0;
+        }
+        job->out_words = n;
+        job->ok = (ok && !overflow && n > 0) ? 1u : 0u;
+        job->done_ticks = ticks();
+        job->overflow = overflow ? 1u : 0u;
+        if(!job->ok && getenv("PSX_REPLAY_PROFILE"))
+            fprintf(stderr,"[replay fail] ok=%d overflow=%d words=%u us=%llu\n",ok,overflow,n,
+                    (unsigned long long)ticks_us(job->done_ticks-job->start_ticks));
+        if(profile && *profile && ++profile_jobs%128==0) {
+            extern void host_profiler_flush(void);host_profiler_flush();
+        }
+        if (atomic_load(&job->discard)) atomic_store(&job->state, RW_FREE);
+        else atomic_store(&job->state, job->ok ? RW_DONE : RW_FAILED);
+    }
+}
+
+/* ---- parent side -------------------------------------------------------- */
+static int spawn(int index) {
+    fflush(stdout);
+    fflush(stderr);
+    pid_t pid = fork();
+    if (pid < 0) return 0;
+    if (pid == 0) worker_main(index);   /* never returns */
+    s_pids[index] = pid;
+    s_spawns++;
+    return 1;
+}
+
+static void stop_workers(void) {
+    if (!s_sh) return;
+    for (int i = 0; i < s_count; i++) {
+        if (s_pids[i] > 0) {
+            kill(s_pids[i], SIGKILL);
+            (void)waitpid(s_pids[i], NULL, 0);
+            s_pids[i] = 0;
+        }
+    }
+    for (int j = 0; j < RW_JOBS; j++) {
+        uint32_t st = atomic_load(&s_sh->jobs[j].state);
+        if (st == RW_QUEUED || st == RW_RUNNING) atomic_store(&s_sh->jobs[j].state, RW_FAILED);
+    }
+    s_count = 0;
+}
+
+static void start_workers(void) {
+    s_overlay_loads = overlay_loads_now();
+    s_mod_used = psx_mod_memory_used_bytes();
+    for (int i = 0; i < s_wanted; i++)
+        if (spawn(i)) s_count = i + 1;
+}
+
+int psx_mod_replay_workers_start(int count, PSXModReplayDrawFn draw) {
+    if (s_sh || count <= 0 || !draw) return 0;
+    if (count > RW_MAX_WORKERS) count = RW_MAX_WORKERS;
+    s_image_bytes = (render_replay_image_bytes() + 4095u) & ~(size_t)4095u;
+    size_t head = (sizeof(RwShared) + 4095u) & ~(size_t)4095u;
+    s_map_bytes = head + s_image_bytes * RW_SLOTS + (size_t)RW_JOBS * RW_OUT_WORDS * 4u;
+    void *m = mmap(NULL, s_map_bytes, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_ANONYMOUS, -1, 0);
+    if (m == MAP_FAILED) return 0;
+    memset(m, 0, head);
+    s_sh = (RwShared *)m;
+    s_images = (uint8_t *)m + head;
+    s_out = (uint32_t *)(s_images + s_image_bytes * RW_SLOTS);
+    s_sh->magic = 0x52575231u;
+    s_parent = getpid();
+    s_draw = draw;
+    s_wanted = count;
+    start_workers();
+    fprintf(stdout, "psxrecomp: %d render replay worker(s) started (%.1f MB shared)\n",
+            s_count, (double)s_map_bytes / 1048576.0);
+    return s_count;
+}
+
+void psx_mod_replay_workers_refresh(void) {
+    if (!s_sh) return;
+    stop_workers();
+    start_workers();
+}
+
+/* D17AW: a finished job the render thread is still reading is released once
+ * it is done (maintain), so no worker can reuse its stream before. */
+static uint8_t s_rt_release[RW_JOBS];
+/* PSX_RT_VALIDATE=1 (developer): every 8th render-thread image is compared
+ * with the same job drawn here, the single-thread path (exact RGBA match). */
+static uint8_t s_rt_val_hold[RW_JOBS];
+static int s_rt_val_on = -1, s_rt_val_cache = -1, s_rt_val_job = -1;
+static uint64_t s_rt_val_n = 0, s_rt_val_t = 0;
+/* Reap dead workers, kill overrunning ones, refork on overlay changes. */
+void psx_mod_replay_release(int job);
+static void maintain(void) {
+    int status;
+    for (int j = 0; j < RW_JOBS; j++)
+        if (s_rt_release[j] && !psx_rt_job_held(j) && !s_rt_val_hold[j]) psx_mod_replay_release(j);
+    for (int i = 0; i < s_count; i++) {
+        if (s_pids[i] <= 0) continue;
+        pid_t r = waitpid(s_pids[i], &status, WNOHANG);
+        if (r == s_pids[i]) {
+            s_deaths++;
+            s_pids[i] = 0;
+            for (int j = 0; j < RW_JOBS; j++) {
+                RwJob *job = &s_sh->jobs[j];
+                if (atomic_load(&job->state) == RW_RUNNING && job->worker == i)
+                    atomic_store(&job->state, RW_FAILED);
+            }
+            spawn(i);
+        }
+    }
+    const uint64_t now = ticks(), f = SDL_GetPerformanceFrequency();
+    for (int j = 0; j < RW_JOBS; j++) {
+        RwJob *job = &s_sh->jobs[j];
+        if (atomic_load(&job->state) != RW_RUNNING || !f) continue;
+        // RUNNING claims ownership before the worker publishes its start.
+        // Do not time an unpublished/stale start, or subtract a timestamp that
+        // became newer than maintain()'s cached clock sample.
+        const uint64_t started = atomic_load(&job->start_ticks);
+        if (started && now >= started &&
+            (now - started) * 1000u / f > RW_JOB_DEADLINE_MS) {
+            int w = job->worker;
+            if (w >= 0 && w < s_count && s_pids[w] > 0) {
+                kill(s_pids[w], SIGKILL);
+                (void)waitpid(s_pids[w], NULL, 0);
+                s_pids[w] = 0;
+                s_kills++;
+                spawn(w);
+            }
+            atomic_store(&job->state, RW_FAILED);
+        }
+    }
+    for (int j = 0; j < RW_JOBS; j++) {
+        RwJob *job = &s_sh->jobs[j];
+        uint32_t st = atomic_load(&job->state);
+        if ((st == RW_DONE || st == RW_FAILED) && atomic_load(&job->discard))
+            atomic_store(&job->state, RW_FREE);
+    }
+    /* New code overlays, or plugin allocations of mod memory (their host
+     * pointers exist only in processes forked after the allocation). */
+    if (overlay_loads_now() != s_overlay_loads || psx_mod_memory_used_bytes() != s_mod_used) {
+        if (getenv("PSX_REPLAY_PROFILE"))
+            fprintf(stderr,"[replay refresh] overlays=%u/%u mod_bytes=%u/%u ticks=%llu\n",
+                    s_overlay_loads,overlay_loads_now(),s_mod_used,psx_mod_memory_used_bytes(),
+                    (unsigned long long)ticks());
+        stop_workers();
+        start_workers();
+    }
+}
+
+int psx_mod_replay_publish(int slot, const CPUState *cpu) {
+    if (!s_sh || slot < 0 || slot >= RW_SLOTS || !cpu) return 0;
+    maintain();
+    for (int j = 0; j < RW_JOBS; j++) {
+        RwJob *job = &s_sh->jobs[j];
+        if (job->slot != (uint32_t)slot) continue;
+        uint32_t st = atomic_load(&job->state);
+        if (st == RW_QUEUED) {           /* would read the new image: drop it */
+            uint32_t expect = RW_QUEUED;
+            if (atomic_compare_exchange_strong(&job->state, &expect, RW_FREE)) continue;
+            st = atomic_load(&job->state);
+        }
+        if (st == RW_RUNNING && !atomic_load(&job->loaded))
+            return 0;   /* still being read */
+    }
+    atomic_store(&s_sh->slot_ready[slot], 0u);
+    render_replay_image_save(slot_image((uint32_t)slot));
+    s_sh->slot_cpu[slot] = *cpu;
+    /* The margin follows the presenter's frame classification, which a worker
+     * never runs (it records GP0 instead of drawing): pin the parent's value. */
+    s_sh->slot_ws_margin[slot] = psx_ws_x_margin();
+    atomic_store(&s_sh->slot_ready[slot], 1u);
+    psx_rt_publish(slot);   /* the render thread draws this slot's redraws (D17AW) */
+    return 1;
+}
+
+int psx_mod_replay_submit(int slot, const void *params, uint32_t len, uint64_t tag) {
+    if (!s_sh || slot < 0 || slot >= RW_SLOTS || len > RW_PARAMS ||
+        !atomic_load(&s_sh->slot_ready[slot]))
+        return -1;
+    maintain();
+    for (int j = 0; j < RW_JOBS; j++) {
+        RwJob *job = &s_sh->jobs[j];
+        uint32_t st = atomic_load(&job->state);
+        if (st != RW_FREE) continue;
+        job->slot = (uint32_t)slot;
+        job->params_len = len;
+        if (len) memcpy(job->params, params, len);
+        job->tag = tag;
+        job->worker = -1;
+        atomic_store(&job->start_ticks, 0u);
+        job->out_words = 0;
+        job->ok = 0;
+        job->overflow = 0;
+        atomic_store(&job->discard, 0u);
+        atomic_store(&job->loaded, 0u);
+        atomic_store(&job->state, RW_QUEUED);
+        return j;
+    }
+    return -1;
+}
+
+int psx_mod_replay_job_state(int job, uint64_t *tag) {
+    if (!s_sh || job < 0 || job >= RW_JOBS) return -1;
+    if (tag) *tag = s_sh->jobs[job].tag;
+    return (int)atomic_load(&s_sh->jobs[job].state);
+}
+
+void psx_mod_replay_release(int job) {
+    if (!s_sh || job < 0 || job >= RW_JOBS) return;
+    if (psx_rt_job_held(job) || s_rt_val_hold[job]) { s_rt_release[job] = 1; return; }
+    s_rt_release[job] = 0;
+    RwJob *j = &s_sh->jobs[job];
+    uint32_t st = atomic_load(&j->state);
+    if (st == RW_QUEUED) {
+        uint32_t expect = RW_QUEUED;
+        if (atomic_compare_exchange_strong(&j->state, &expect, RW_FREE)) return;
+        st = atomic_load(&j->state);
+    }
+    if (st == RW_RUNNING) {
+        atomic_store(&j->discard, 1u);
+        /* It may have finished between the two loads. */
+        st = atomic_load(&j->state);
+        if (st != RW_DONE && st != RW_FAILED) return;
+    }
