+        return true;
+    }
+    if (mod & (KMOD_CTRL|KMOD_ALT|KMOD_GUI)) return true;
+    char ch = 0;
+    if (scancode >= SDL_SCANCODE_A && scancode <= SDL_SCANCODE_Z) ch = char('a' + (scancode - SDL_SCANCODE_A));
+    else if (scancode >= SDL_SCANCODE_1 && scancode <= SDL_SCANCODE_9) ch = char('1' + (scancode - SDL_SCANCODE_1));
+    else if (scancode == SDL_SCANCODE_0) ch = '0';
+    else if (scancode == SDL_SCANCODE_SPACE) ch = ' ';
+    else if (scancode == SDL_SCANCODE_MINUS) ch = '-';
+    else if (scancode == SDL_SCANCODE_EQUALS) ch = '=';
+    if (ch && !key_repeat && s_console_len + 1 < sizeof s_console_line) {
+        s_console_line[s_console_len++] = ch;
+        s_console_line[s_console_len] = 0;
+        debug_console_refresh();
+    }
+    return true;
 }
 
