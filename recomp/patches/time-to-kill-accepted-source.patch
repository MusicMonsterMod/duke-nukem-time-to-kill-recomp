diff --git a/runtime/src/lightmap_store.c b/runtime/src/lightmap_store.c
new file mode 100644
index 00000000..6b0be373
--- /dev/null
+++ b/runtime/src/lightmap_store.c
@@ -0,0 +1,94 @@
+/* lightmap_store.c - the shared baked lamp light (Time to Kill D41M).
+ * The title sets it on any thread once a bake is ready; every renderer
+ * instance (the emulation thread's and the render threads' copies,
+ * render_copy/) takes it when the generation changes and uploads it to its
+ * own context a few rows at a time. Not a copied source: one store for all
+ * instances. The data is one immutable, reference-counted copy: taking it
+ * copies nothing (a 90 MB copy per instance was a frame-sized stall). */
+#include "mod_plugins.h"
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct { PSXModLightmap m; int refs; } LmBlob;
+static pthread_mutex_t s_mu = PTHREAD_MUTEX_INITIALIZER;
+static LmBlob *s_cur = NULL;
+static uint32_t s_gen = 0;
+
+static void blob_unref_locked(LmBlob *b) {
+    if (!b || --b->refs > 0) return;
+    free((void *)b->m.steady); free((void *)b->m.channels); free((void *)b->m.charts); free(b);
+}
+
+static LmBlob *blob_make(const PSXModLightmap *src) {
+    if (!src || src->width <= 0 || src->height <= 0 || !src->nsurf) return NULL;
+    const size_t px = (size_t)src->width * (size_t)src->height;
+    LmBlob *b = (LmBlob *)calloc(1, sizeof *b);
+    uint32_t *s = (uint32_t *)malloc(px * 4u), *c = (uint32_t *)malloc(px * 4u);
+    float *ch = (float *)malloc((size_t)src->nsurf * 16u * sizeof(float));
+    if (!b || !s || !c || !ch) { free(b); free(s); free(c); free(ch); return NULL; }
+    memcpy(s, src->steady, px * 4u); memcpy(c, src->channels, px * 4u);
+    memcpy(ch, src->charts, (size_t)src->nsurf * 16u * sizeof(float));
+    b->m.width = src->width; b->m.height = src->height; b->m.nsurf = src->nsurf;
+    b->m.steady = s; b->m.channels = c; b->m.charts = ch; b->refs = 1;
+    return b;
+}
+
+void psx_mod_gpu_set_lightmap(const PSXModLightmap *lm) {
+    LmBlob *n = blob_make(lm);   /* the copy, outside the lock */
+    pthread_mutex_lock(&s_mu);
+    blob_unref_locked(s_cur);
+    s_cur = n;
+    if (++s_gen == 0) s_gen = 1;
+    pthread_mutex_unlock(&s_mu);
+}
+
+uint32_t psx_lightmap_generation(void) {
+    pthread_mutex_lock(&s_mu);
+    const uint32_t g = s_gen;
+    pthread_mutex_unlock(&s_mu);
+    return g;
+}
+
+/* *out shares the store's data (no copy); hand it back with
+ * psx_lightmap_release. An empty store gives width 0. */
+int psx_lightmap_take(uint32_t have, uint32_t *gen, PSXModLightmap *out) {
+    int r = 0;
+    pthread_mutex_lock(&s_mu);
+    if (s_gen != have) {
+        *gen = s_gen;
+        memset(out, 0, sizeof *out);
+        if (s_cur) { s_cur->refs++; *out = s_cur->m; out->handle = s_cur; }
+        r = 1;
+    }
+    pthread_mutex_unlock(&s_mu);
+    return r;
+}
+
+void psx_lightmap_release(PSXModLightmap *m) {
+    if (!m || !m->handle) return;
+    pthread_mutex_lock(&s_mu);
+    blob_unref_locked((LmBlob *)m->handle);
+    pthread_mutex_unlock(&s_mu);
+    memset(m, 0, sizeof *m);
+}
+
+/* D41M full build: the emulation thread renderer's textures, shared. */
+static PSXLightmapGL s_gl;
+static int s_gl_have = 0;
+void psx_lightmap_gl_publish(const PSXLightmapGL *g) {
+    pthread_mutex_lock(&s_mu);
+    s_gl = *g; s_gl_have = 1;
+    pthread_mutex_unlock(&s_mu);
+}
+int psx_lightmap_gl_adopt(uint32_t have, PSXLightmapGL *out, void (*wait)(void *fence)) {
+    int r = 0;
+    pthread_mutex_lock(&s_mu);
+    if (s_gl_have && s_gl.gen != have) {
+        *out = s_gl;
+        if (s_gl.fence && wait) wait(s_gl.fence);
+        r = 1;
+    }
+    pthread_mutex_unlock(&s_mu);
+    return r;
+}
