diff --git a/runtime/src/render_replay.c b/runtime/src/render_replay.c
new file mode 100644
index 00000000..3de85826
--- /dev/null
+++ b/runtime/src/render_replay.c
@@ -0,0 +1,520 @@
+/* render_replay.c - presentation-only guest render replay (Time to Kill D17).
+ * See render_replay.h. The MMIO policy below is the whole device contract of
+ * a replay: GP0 and GPU DMA execute synchronously into the (saved) VRAM, reads
+ * report an idle GPU and DMA, and every other device access is a no-op. */
+#include "render_replay.h"
+#include "pgxp.h"
+#include "gpu.h"
+#include "dma.h"
+#include "mod_memory.h"
+#include "mod_plugins.h"
+#include "psx_sdl.h"
+#include <string.h>
+#include <stdlib.h>
+
+extern uint32_t i_stat;
+extern uint32_t i_mask;
+extern uint32_t psx_read_word(uint32_t addr);
+
+int g_render_replay_active = 0;
+static RenderReplayStats s_stats;
+const RenderReplayStats *render_replay_stats(void) { return &s_stats; }
+RenderReplayStats *render_replay_stats_mut(void) { return &s_stats; }
+
+/* Replay-local GPU DMA channel registers (the live channel is never touched). */
+static uint32_t s_d2_madr, s_d2_bcr, s_d2_chcr;
+void render_replay_reset_channel(void) { s_d2_madr = s_d2_bcr = s_d2_chcr = 0; }
+
+/* Record mode (worker processes): GP0 traffic goes to a buffer instead of the
+ * GPU. Stream items: header (kind << 24 | count) then count words.
+ * kind 0 GP0 words, 1 linked list begin, 2 empty list node, 3 list end,
+ * 4 host precise vertex (addr, word, x16, y16, z, u, v, depth_z; floats as bits), 5 source address of
+ * the next run of GP0 words (emitted per list node once a session recorded
+ * host vertices, so the parent can match them to their packets). */
+int g_render_replay_record = 0;
+static uint32_t *s_rec = NULL;
+static uint32_t s_rec_cap = 0, s_rec_n = 0, s_rec_run = 0;
+static int s_rec_overflow = 0;
+static int s_rec_need_src = 0;
+/* Vertex words a plugin described during this job. The live path prefers a
+ * plugin's host vertex over PGXP metadata; the DMA walk below must not record
+ * PGXP metadata after it for the same word, which would replace it. */
+#define REC_HV_CAP 32768u
+static uint32_t s_rec_hv_addr[REC_HV_CAP], s_rec_hv_word[REC_HV_CAP], s_rec_hv_job[REC_HV_CAP], s_rec_job = 0;
+static inline uint32_t rec_hv_slot(uint32_t addr) { return ((addr >> 2) * 2654435761u) >> 17; }
+static void rec_hv_mark(uint32_t addr, uint32_t word) {
+    addr &= 0x00FFFFFCu;
+    for (uint32_t k = 0, i = rec_hv_slot(addr); k < 16u; k++, i = (i + 1u) & (REC_HV_CAP - 1u)) {
+        if (s_rec_hv_job[i] != s_rec_job || s_rec_hv_addr[i] == addr) {
+            s_rec_hv_job[i] = s_rec_job; s_rec_hv_addr[i] = addr; s_rec_hv_word[i] = word; return;
+        }
+    }
+}
+static int rec_hv_marked(uint32_t addr, uint32_t word) {
+    addr &= 0x00FFFFFCu;
+    for (uint32_t k = 0, i = rec_hv_slot(addr); k < 16u; k++, i = (i + 1u) & (REC_HV_CAP - 1u)) {
+        if (s_rec_hv_job[i] != s_rec_job) return 0;
+        if (s_rec_hv_addr[i] == addr) return s_rec_hv_word[i] == word;
+    }
+    return 0;
+}
+void render_replay_record_begin(uint32_t *buf, uint32_t cap) {
+    s_rec = buf; s_rec_cap = cap; s_rec_n = 0; s_rec_run = UINT32_MAX; s_rec_overflow = 0;
+    s_rec_need_src = 0;
+    if (++s_rec_job == 0) { memset(s_rec_hv_job, 0, sizeof s_rec_hv_job); s_rec_job = 1; }
+    // Each frozen job starts with a new RAM image, never inherited precision.
+    if (g_pgxp_mesh_active) pgxp_invalidate_all();
+}
+uint32_t render_replay_record_end(int *overflow) {
+    if (overflow) *overflow = s_rec_overflow;
+    return s_rec_overflow ? 0u : s_rec_n;
+}
+static void rec_marker(uint32_t kind) {
+    if (s_rec_n + 1u > s_rec_cap) { s_rec_overflow = 1; return; }
+    s_rec[s_rec_n++] = kind << 24;
+    s_rec_run = UINT32_MAX;
+}
+static void rec_item(uint32_t kind, const uint32_t *payload, uint32_t n) {
+    if (s_rec_n + 1u + n > s_rec_cap) { s_rec_overflow = 1; return; }
+    s_rec[s_rec_n++] = kind << 24 | n;
+    for (uint32_t i = 0; i < n; i++) s_rec[s_rec_n++] = payload[i];
+    s_rec_run = UINT32_MAX;
+}
+void render_replay_record_host_vertex(uint32_t addr, uint32_t word, int32_t x16, int32_t y16, float z, float u, float v, float depth_z, float coverage, int depth_mode) {
+    uint32_t cb; memcpy(&cb, &coverage, 4);
+    uint32_t zb, ub, vb, db; memcpy(&db, &depth_z, 4); memcpy(&zb, &z, 4); memcpy(&ub, &u, 4); memcpy(&vb, &v, 4);
+    /* A tenth word, the depth mode, only for a test-only or depth-only vertex. */
+    const uint32_t p[10] = { addr, word, (uint32_t)x16, (uint32_t)y16, zb, ub, vb, db, cb, (uint32_t)depth_mode };
+    rec_item(4u, p, depth_mode ? 10 : 9);
+    s_rec_need_src = 1;
+    if (depth_z > 0.0f) rec_hv_mark(addr, word);
+}
+/* D41A: kind 6 world position of a host vertex (addr, word, wx, wy, wz),
+ * kind 7 the frame's lights (ambient, then 8 words a light). */
+void render_replay_record_host_world(uint32_t addr, uint32_t word, float wx, float wy, float wz, const float *n) {
+    uint32_t p[8] = { addr, word, 0, 0, 0, 0, 0, 0 };
+    memcpy(&p[2], &wx, 4); memcpy(&p[3], &wy, 4); memcpy(&p[4], &wz, 4);
+    if (n) memcpy(&p[5], n, 12); /* D41H: with its shading normal */
+    rec_item(6u, p, n ? 8 : 5);
+}
+/* D41M: kind 6 with a sixth word, the baked surface; kind 9 the lamp
+ * levels (eye xyz, steady gain, then 3 words a lamp). */
+void render_replay_record_host_world_surface(uint32_t addr, uint32_t word, float wx, float wy, float wz, uint32_t surf) {
+    uint32_t p[6] = { addr, word, 0, 0, 0, surf };
+    memcpy(&p[2], &wx, 4); memcpy(&p[3], &wy, 4); memcpy(&p[4], &wz, 4);
+    rec_item(6u, p, 6);
+}
+void render_replay_record_lamp_levels(const float eye[3], float gain, const float *rgb, int n) {
+    uint32_t p[4 + PSX_MOD_BAKE_LAMPS * 3];
+    if (n < 0) n = 0;
+    if (n > PSX_MOD_BAKE_LAMPS) n = PSX_MOD_BAKE_LAMPS;
+    memcpy(&p[0], eye, 12); memcpy(&p[3], &gain, 4);
+    if (n) memcpy(&p[4], rgb, sizeof(float) * 3u * (size_t)n);
+    rec_item(9u, p, 4u + (uint32_t)n * 3u);
+}
+void render_replay_record_lights(const PSXModLight *lights, int n, float ambient) {
+    uint32_t p[1 + PSX_MOD_MAX_LIGHTS * 8];
+    if (n < 0) n = 0;
+    if (n > PSX_MOD_MAX_LIGHTS) n = PSX_MOD_MAX_LIGHTS;
+    memcpy(&p[0], &ambient, 4);
+    if (n) memcpy(&p[1], lights, sizeof(PSXModLight) * (size_t)n);
+    rec_item(7u, p, 1u + (uint32_t)n * 8u);
+}
+/* D41F: kind 8 the image's shadowed lights (6 words each). */
+void render_replay_record_shadows(const PSXModShadow *s, int n) {
+    uint32_t p[PSX_MOD_SHADOW_SLOTS * 6 + 1];
+    if (n < 0) n = 0;
+    if (n > PSX_MOD_SHADOW_SLOTS) n = PSX_MOD_SHADOW_SLOTS;
+    p[0] = 0;
+    if (n) memcpy(&p[1], s, sizeof(PSXModShadow) * (size_t)n);
+    rec_item(8u, p, 1u + (uint32_t)n * 6u);
+}
+static void rec_word(uint32_t word) {
+    if (s_rec_run == UINT32_MAX || (s_rec[s_rec_run] & 0xFFFFFFu) == 0xFFFFFFu) {
+        if (s_rec_n + 1u > s_rec_cap) { s_rec_overflow = 1; return; }
+        s_rec_run = s_rec_n;
+        s_rec[s_rec_n++] = 0u;
+    }
+    if (s_rec_n + 1u > s_rec_cap) { s_rec_overflow = 1; return; }
+    s_rec[s_rec_n++] = word;
+    s_rec[s_rec_run]++;
+}
+
+static void gp0(uint32_t addr, uint32_t word) {
+    s_stats.gp0_words++;
+    if (g_render_replay_record) { rec_word(word); return; }
+    gpu_set_gp0_source(addr);
+    gpu_write_gp0(word);
+}
+
+/* Parent: execute a recorded stream into the GPU (inside a replay session). */
+extern void gpu_host_vertex_store(uint32_t addr, uint32_t word, int32_t x16, int32_t y16, float z, float u, float v, float depth_z, float coverage, int depth_mode);
+extern void gpu_write_gp0_words(uint32_t src, const uint32_t *w, uint32_t n);
+extern void gpu_host_vertex_world_store(uint32_t addr, uint32_t word, float wx, float wy, float wz, const float *n);
+extern void gpu_host_vertex_world_store_surface(uint32_t addr, uint32_t word, float wx, float wy, float wz, const float *n, uint32_t surf);
+extern void gl_set_lamp_levels(const float eye[3], float gain, const float *rgb, int n);
+extern void gl_set_lights(const void *lights, int n, float ambient);
+extern void gl_set_shadows(const void *s, int n);
+extern void gpu_display_info_hold(int hold);
+static int feed_stream(const uint32_t *stream, uint32_t n);
+int render_replay_feed(const uint32_t *stream, uint32_t n) {
+    gpu_display_info_hold(1);
+    const int ok = feed_stream(stream, n);
+    gpu_display_info_hold(0);
+    return ok;
+}
+static int feed_stream(const uint32_t *stream, uint32_t n) {
+    uint32_t i = 0, src = 0xFFFFFFFFu;
+    while (i < n) {
+        const uint32_t kind = stream[i] >> 24, count = stream[i] & 0xFFFFFFu;
+        i++;
+        if (count > n - i) return 0;
+        switch (kind) {
+        case 0:
+            gpu_write_gp0_words(src, &stream[i], count);
+            s_stats.gp0_words += count;
+            src = 0xFFFFFFFFu;
+            break;
+        case 1: gpu_ws_begin_linked_list(); break;
+        case 2: gpu_set_gp0_linked_list_node(0u, 0u); break;
+        case 3: gpu_ws_end_linked_list(); break;
+        case 4:
+            if (count >= 7 && count <= 10) {
+                float z, u, v; memcpy(&z, &stream[i + 4], 4); memcpy(&u, &stream[i + 5], 4); memcpy(&v, &stream[i + 6], 4);
+                float depth_z = z; if (count >= 8) memcpy(&depth_z, &stream[i + 7], 4);
+                float coverage = 1.0f; if (count >= 9) memcpy(&coverage, &stream[i + 8], 4);
+                gpu_host_vertex_store(stream[i], stream[i + 1], (int32_t)stream[i + 2], (int32_t)stream[i + 3], z, u, v, depth_z, coverage, count == 10 ? (int)stream[i + 9] : 0);
+            }
+            break;
+        case 5: if (count == 1) src = stream[i]; break;
+        case 6:
+            if (count == 5 || count == 8) {
+                float w[6]; memcpy(w, &stream[i + 2], count == 8 ? 24 : 12);
+                gpu_host_vertex_world_store(stream[i], stream[i + 1], w[0], w[1], w[2], count == 8 ? &w[3] : NULL);
+            } else if (count == 6) {
+                float w[3]; memcpy(w, &stream[i + 2], 12);
+                gpu_host_vertex_world_store_surface(stream[i], stream[i + 1], w[0], w[1], w[2], NULL, stream[i + 5]);
+            }
+            break;
+        case 9:
+            if (count >= 4 && (count - 4) % 3 == 0 && (count - 4) / 3 <= PSX_MOD_BAKE_LAMPS) {
+                float eye[3], gain; memcpy(eye, &stream[i], 12); memcpy(&gain, &stream[i + 3], 4);
+                gl_set_lamp_levels(eye, gain, (const float *)&stream[i + 4], (int)((count - 4) / 3));
+            }
+            break;
+        case 7:
+            if (count >= 1 && (count - 1) % 8 == 0 && (count - 1) / 8 <= PSX_MOD_MAX_LIGHTS) {
+                float amb; memcpy(&amb, &stream[i], 4);
+                PSXModLight l[PSX_MOD_MAX_LIGHTS];
+                const int n = (int)((count - 1) / 8);
+                if (n) memcpy(l, &stream[i + 1], sizeof(PSXModLight) * (size_t)n);
+                gl_set_lights(l, n, amb);
+            }
+            break;
+        case 8:
+            if (count >= 1 && (count - 1) % 6 == 0 && (count - 1) / 6 <= PSX_MOD_SHADOW_SLOTS) {
+                PSXModShadow sh[PSX_MOD_SHADOW_SLOTS];
+                const int n = (int)((count - 1) / 6);
+                if (n) memcpy(sh, &stream[i + 1], sizeof(PSXModShadow) * (size_t)n);
+                gl_set_shadows(sh, n);
+            }
+            break;
+        default: return 0;
+        }
+        i += count;
+    }
+    gpu_set_gp0_source(0xFFFFFFFFu);
+    return 1;
+}
+
+static void run_gpu_dma_body(void);
+static void run_gpu_dma(void) {
+    const uint64_t t = SDL_GetPerformanceCounter(), f = SDL_GetPerformanceFrequency();
+    run_gpu_dma_body();
+    if (f) s_stats.gpu_us += (SDL_GetPerformanceCounter() - t) * 1000000u / f;
+}
+static void run_gpu_dma_body(void) {
+    const uint32_t chcr = s_d2_chcr;
+    const uint32_t sync_mode = (chcr >> 9) & 3u;
+    const int32_t step = (chcr & 2u) ? -4 : 4;
+    if (!(chcr & 1u)) {           /* VRAM -> RAM read: nothing to present */
+        s_stats.dropped_writes++;
+        return;
+    }
+    if (sync_mode == 2u) {
+        uint32_t addr = psx_mod_gpu_dma_resolve_address(s_d2_madr);
+        if (g_render_replay_record) rec_marker(1u);
+        else {
+            gpu_ws_begin_linked_list();
+            gpu_ws_prepass_linked_list(addr);
+        }
+        for (uint32_t nodes = 0; nodes < 0x40000u; nodes++) {
+            const uint32_t header = psx_read_word(addr);
+            const uint32_t count = header >> 24;
+            s_stats.dma_nodes++;
+            if (!count) {
+                if (g_render_replay_record) rec_marker(2u);
+                else gpu_set_gp0_linked_list_node(addr, 0u);
+            }
+            if (count) {
+                if (!g_render_replay_record) gpu_set_gp0_linked_list_node(addr, count);
+                uint32_t w = psx_mod_gpu_dma_resolve_address(addr + 4u);
+                if (g_render_replay_record && g_pgxp_mesh_active) {
+                    // Resolve exact native positions in the worker that produced
+                    // them. Parent replay remains suppressed and receives only
+                    // this job's immutable metadata, before its GP0 packet.
+                    extern int gp0_command_word_count(uint8_t opcode);
+                    for (uint32_t offset=0; offset<count;) {
+                        const uint32_t a=psx_mod_gpu_dma_resolve_address(w+4*offset);
+                        const uint32_t first=psx_read_word(a),op=first>>24;
+                        const int length=gp0_command_word_count((uint8_t)op);
+                        // Variable transfers/polylines cannot be guessed from
+                        // packet contents. No metadata for partial commands.
+                        if(length<=0 || offset+(uint32_t)length>count || (op>=0x80 && op<0xe0)) break;
+                        if(op>=0x20 && op<=0x3f) {
+                            uint32_t words[12];int32_t x[4],y[4];uint16_t z[4];
+                            for(int k=0;k<length;++k) words[k]=psx_read_word(a+4*k);
+                            const int corners=pgxp_mesh_polygon(a,words,length,x,y,z);
+                            const unsigned step=1+((op&4)!=0)+((op&16)!=0);
+                            const int texture=pgxp_mesh_textures();
+                            for(int k=0;k<corners;++k) {
+                                const unsigned index=1+k*step;const uint32_t value=words[index];
+                                if(rec_hv_marked(a+4*index,value)) continue;
+                                render_replay_record_host_vertex(a+4*index,value,
+                                    pgxp_mesh_geometry()?x[k]:(int32_t)(int16_t)value*65536,
+                                    pgxp_mesh_geometry()?y[k]:(int32_t)(int16_t)(value>>16)*65536,
+                                    texture?(float)z[k]:1.0f,-1.0f,-1.0f,-1.0f,1.0f,0);
+                            }
+                        }
+                        offset+=(uint32_t)length;
+                    }
+                }
+                if (g_render_replay_record && s_rec_need_src) rec_item(5u, &w, 1);
+                for (uint32_t i = 0; i < count; i++) {
+                    gp0(w, psx_read_word(w));
+                    w = psx_mod_gpu_dma_resolve_address(w + 4u);
+                }
+            }
+            /* End as the live walker does (dma_gpu_ll.c): at 0xFFFFFF, or a
+             * bit-23 link that is not an allocated GPU DMA aperture packet
+             * (mod_memory.h; every aperture address has bit 23 set). */
+            const uint32_t next = header & 0x00FFFFFFu;
+            if (next == 0x00FFFFFFu) break;
+            if ((next & 0x00800000u) && psx_mod_gpu_dma_resolve_address(next) != (next & 0x00FFFFFCu)) break;
+            addr = psx_mod_gpu_dma_resolve_address(next);
+        }
+        if (g_render_replay_record) rec_marker(3u);
+        else gpu_ws_end_linked_list();
+        s_d2_madr = 0x00FFFFFFu;
+        s_stats.dma_lists++;
+    } else {
+        uint32_t words = sync_mode == 1u
+            ? (s_d2_bcr & 0xFFFFu) * ((s_d2_bcr >> 16) & 0xFFFFu)
+            : ((s_d2_bcr & 0xFFFFu) ? (s_d2_bcr & 0xFFFFu) : 0x10000u);
+        uint32_t addr = s_d2_madr & 0x1FFFFCu;
+        for (uint32_t i = 0; i < words; i++) {
+            gp0(addr, psx_read_word(addr));
+            addr = (addr + (uint32_t)step) & 0x1FFFFCu;
+        }
+        s_d2_madr = addr;
+        s_stats.dma_blocks++;
+    }
+}
+
+static void drop(uint32_t addr, uint32_t val) {
+    s_stats.dropped_writes++;
+    s_stats.last_drop_addr = addr;
+    s_stats.last_drop_val = val;
+}
+
+uint32_t render_replay_mmio_read(uint32_t addr, int size) {
+    (void)size;
+    addr &= ~3u;
+    switch (addr) {
+    case 0x1F801814u:   /* GPUSTAT: idle, ready for commands, DMA and VRAM */
+        s_stats.faked_reads++;
+        s_stats.last_fake_addr = addr;
+        return gpu_read_gpustat() | 0x1C000000u;
+    case 0x1F801810u:   /* GPUREAD */
+        s_stats.faked_reads++;
+        s_stats.last_fake_addr = addr;
+        return 0;
+    case 0x1F8010A0u: return s_d2_madr;
+    case 0x1F8010A4u: return s_d2_bcr;
+    case 0x1F8010A8u: return s_d2_chcr;
+    case 0x1F801070u: return i_stat;
+    case 0x1F801074u: return i_mask;
+    default: break;
+    }
+    if (addr >= 0x1F801080u && addr <= 0x1F8010FFu) return dma_read(addr);
+    s_stats.dropped_reads++;
+    s_stats.last_fake_addr = addr;
+    return 0;
+}
+
+void render_replay_mmio_write(uint32_t addr, uint32_t val, int size) {
+    const uint32_t a = addr & ~3u;
+    if (size != 4 && a != 0x1F8010A8u) { drop(addr, val); return; }
+    switch (a) {
+    case 0x1F801810u: gp0(0, val); return;
+    case 0x1F8010A0u: s_d2_madr = val & 0x00FFFFFFu; return;
+    case 0x1F8010A4u: s_d2_bcr = val; return;
+    case 0x1F8010A8u:
+        s_d2_chcr = val;
+        if (val & 0x01000000u) {
+            run_gpu_dma();
+            s_d2_chcr &= ~0x11000000u;
+        }
+        return;
+    default: drop(addr, val); return;
+    }
+}
+
+/* ---- Session: freeze guest time and GPU state around one replay ---------- */
+#include "psx_cycles.h"
+#include "pgxp.h"
+#include "cpu_state.h"
+#include "host_time.h"
+#include "psx_sdl.h"
+
+extern uint32_t gpu_snapshot_bytes(void);
+extern void     gpu_snapshot_write(uint8_t *p);
+extern int      gpu_snapshot_read(const uint8_t *p, uint32_t len);
+extern int      gl_replay_begin(void);
+extern int      gl_replay_end(int capture);
+extern void     gl_replay_resume(void);
+extern void     debug_server_set_fmv_quiet(int quiet);
+extern int      debug_server_fmv_quiet(void);
+
+static struct {
+    uint64_t cycle_count, next_service;
+    uint32_t batch, batch_limit, local_value;
+    uint32_t *local_acc;
+    int in_service, quiet;
+    uint64_t t0, t1;
+    uint32_t gpu_len;
+    uint8_t gpu[1024];
+} s_saved;
+
+int render_replay_begin(void) {
+    if (g_render_replay_active) return 0;
+    s_saved.gpu_len = gpu_snapshot_bytes();
+    if (s_saved.gpu_len == 0 || s_saved.gpu_len > sizeof(s_saved.gpu)) return 0;
+    s_saved.t0 = SDL_GetPerformanceCounter();
+    if (!gl_replay_begin()) { s_stats.failed++; return 0; }
+    gpu_snapshot_write(s_saved.gpu);
+    { extern void gpu_host_replay_begin(void); gpu_host_replay_begin(); }
+    s_saved.cycle_count = psx_cycle_count;
+    s_saved.next_service = psx_next_service_cycle;
+    s_saved.batch = g_psx_cyc_batch;
+    s_saved.batch_limit = g_psx_cyc_batch_limit;
+    s_saved.local_acc = g_psx_cyc_local_acc;
+    s_saved.local_value = g_psx_cyc_local_acc ? *g_psx_cyc_local_acc : 0u;
+    s_saved.in_service = psx_in_device_service;
+    gte_precision_speculative_begin();
+    pgxp_suppress_begin();
+    psx_in_device_service = 1;
+    g_psx_cyc_local_acc = NULL;
+    /* Per-block debug observers are for the live guest only. */
+    s_saved.quiet = debug_server_fmv_quiet();
+    debug_server_set_fmv_quiet(1);
+    render_replay_reset_channel();
+    g_render_replay_active = 1;
+    s_stats.sessions++;
+    s_saved.t1 = SDL_GetPerformanceCounter();
+    return 1;
+}
+
+int render_replay_end(int capture) {
+    if (!g_render_replay_active) return 0;
+    g_render_replay_active = 0;
+    const uint64_t t2 = SDL_GetPerformanceCounter();
+    s_stats.guest_cycles += psx_get_cycle_count() - s_saved.cycle_count;
+    int ok = gl_replay_end(capture);
+    gpu_snapshot_read(s_saved.gpu, s_saved.gpu_len);
+    gl_replay_resume();
+    pgxp_suppress_end();
+    gte_precision_speculative_end();
+    psx_cycle_count = s_saved.cycle_count;
+    psx_next_service_cycle = s_saved.next_service;
+    g_psx_cyc_batch = s_saved.batch;
+    g_psx_cyc_batch_limit = s_saved.batch_limit;
+    g_psx_cyc_local_acc = s_saved.local_acc;
+    if (g_psx_cyc_local_acc) *g_psx_cyc_local_acc = s_saved.local_value;
+    psx_in_device_service = s_saved.in_service;
+    debug_server_set_fmv_quiet(s_saved.quiet);
+    if (capture && ok) s_stats.captured++;
+    {
+        const uint64_t f = SDL_GetPerformanceFrequency();
+        const uint64_t us = f ? (SDL_GetPerformanceCounter() - s_saved.t0) * 1000000u / f : 0u;
+        s_stats.last_us = us;
+        if (f) {
+            s_stats.begin_us += (s_saved.t1 - s_saved.t0) * 1000000u / f;
+            s_stats.guest_us += (t2 - s_saved.t1) * 1000000u / f;
+            s_stats.end_us += (SDL_GetPerformanceCounter() - t2) * 1000000u / f;
+        }
+        s_stats.total_us += us;
+        if (us > s_stats.max_us) s_stats.max_us = us;
+    }
+    return ok;
+}
+
+/* Title-plugin entry points (mod_plugins.h). */
+int psx_mod_replay_begin(void) { return render_replay_begin(); }
+int psx_mod_replay_end(int capture) { return render_replay_end(capture); }
+int psx_mod_replay_active(void) { return g_render_replay_active; }
+static const char *(*s_status_fn)(void) = NULL;
