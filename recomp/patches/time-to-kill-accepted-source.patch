+    }
+    if (!s_debug_console) return false;
+    if (scancode == SDL_SCANCODE_ESCAPE) { debug_console_close(); return true; }
+    /* D26I: the keypad types its characters with Num Lock on; with it off its
+     * navigation keys act as the matching main keys, as in a desktop text field. */
+    if (!(mod & KMOD_NUM)) {
+        if (scancode == SDL_SCANCODE_KP_8) scancode = SDL_SCANCODE_UP;
+        else if (scancode == SDL_SCANCODE_KP_2) scancode = SDL_SCANCODE_DOWN;
+        else if (scancode == SDL_SCANCODE_KP_9) scancode = SDL_SCANCODE_PAGEUP;
+        else if (scancode == SDL_SCANCODE_KP_3) scancode = SDL_SCANCODE_PAGEDOWN;
+        else if (scancode == SDL_SCANCODE_KP_7) scancode = SDL_SCANCODE_HOME;
+        else if (scancode == SDL_SCANCODE_KP_1) scancode = SDL_SCANCODE_END;
+    }
+    /* Scrollback: PgUp/PgDn a page, Ctrl+Home/Ctrl+End the oldest/newest line. */
+    if (scancode == SDL_SCANCODE_UP || scancode == SDL_SCANCODE_DOWN) {
+        /* Recall typed commands, newest first; Down past the newest clears the line. */
+        if (s_console_recall > s_console_cmds.size()) s_console_recall = s_console_cmds.size();
+        if (scancode == SDL_SCANCODE_UP && s_console_recall > 0) --s_console_recall;
+        else if (scancode == SDL_SCANCODE_DOWN && s_console_recall < s_console_cmds.size()) ++s_console_recall;
+        const char *text = s_console_recall < s_console_cmds.size() ? s_console_cmds[s_console_recall].c_str() : "";
+        std::snprintf(s_console_line, sizeof s_console_line, "%s", text);
+        s_console_len = std::strlen(s_console_line);
+        debug_console_refresh();
+        return true;
+    }
+    if (scancode == SDL_SCANCODE_PAGEUP) { host_osd_console_scroll(8); return true; }
+    if (scancode == SDL_SCANCODE_PAGEDOWN) { host_osd_console_scroll(-8); return true; }
+    if (scancode == SDL_SCANCODE_HOME && (mod & KMOD_CTRL)) { host_osd_console_scroll(1 << 20); return true; }
+    if (scancode == SDL_SCANCODE_END) { host_osd_console_scroll(-(1 << 20)); return true; }
+    if (scancode == SDL_SCANCODE_RETURN || scancode == SDL_SCANCODE_KP_ENTER) {
+        debug_console_run();
+        return true;
+    }
+    /* Backspace and characters take the OS key repeat, like a desktop text field. */
+    if (scancode == SDL_SCANCODE_BACKSPACE) {
+        if (s_console_len) { --s_console_len; s_console_line[s_console_len]=0; debug_console_refresh(); }
+        return true;
+    }
+    if (mod & (KMOD_CTRL|KMOD_ALT|KMOD_GUI)) return true;
+    char ch = 0;
+    if (scancode >= SDL_SCANCODE_A && scancode <= SDL_SCANCODE_Z) ch = char('a' + (scancode - SDL_SCANCODE_A));
+    else if (scancode >= SDL_SCANCODE_1 && scancode <= SDL_SCANCODE_9) ch = char('1' + (scancode - SDL_SCANCODE_1));
+    else if (scancode == SDL_SCANCODE_0) ch = '0';
+    else if (scancode == SDL_SCANCODE_SPACE) ch = ' ';
+    else if (scancode == SDL_SCANCODE_MINUS) ch = '-';
+    else if (scancode == SDL_SCANCODE_EQUALS) ch = '=';
+    else if (scancode == SDL_SCANCODE_PERIOD) ch = '.'; /* D10G1: decimal console values */
+    else if (scancode >= SDL_SCANCODE_KP_1 && scancode <= SDL_SCANCODE_KP_9 && (mod & KMOD_NUM))
+        ch = char('1' + (scancode - SDL_SCANCODE_KP_1));
+    else if (scancode == SDL_SCANCODE_KP_0 && (mod & KMOD_NUM)) ch = '0';
+    else if (scancode == SDL_SCANCODE_KP_PERIOD && (mod & KMOD_NUM)) ch = '.';
+    else if (scancode == SDL_SCANCODE_KP_MINUS) ch = '-';
+    else if (scancode == SDL_SCANCODE_KP_PLUS) ch = '+';
+    else if (scancode == SDL_SCANCODE_KP_MULTIPLY) ch = '*';
+    else if (scancode == SDL_SCANCODE_KP_DIVIDE) ch = '/';
+    if (ch && s_console_len + 1 < sizeof s_console_line) {
+        s_console_line[s_console_len++] = ch;
+        s_console_line[s_console_len] = 0;
+        debug_console_refresh();
+    }
+    return true;
