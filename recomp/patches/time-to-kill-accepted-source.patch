+#!/usr/bin/env python3
+"""Deferred charges must not change GTE/muldiv deadlines or leak into replay."""
+from pathlib import Path
+import os
+import subprocess
+import tempfile
+src = (Path(__file__).resolve().parents[1] / 'src/psx_cycles.c').read_text()
+def function(signature):
+ a=src.index(signature);b=src.index('\n}',a)+2
+ return src[a:b]
+code=r'''
+#include <stdint.h>
+#include <stddef.h>
+#include <assert.h>
+#include <string.h>
+typedef struct {uint64_t muldiv_ts_done,gte_ts_done;uint8_t read_absorb[33],read_absorb_which;uint32_t ld_absorb;uint8_t ld_which_t;} CPUState;
+static uint64_t psx_cycle_count;
+static uint32_t g_psx_cyc_batch,g_psx_cyc_batch_limit,*g_psx_cyc_local_acc;
+static int g_psx_cyc_bb_defer,g_psx_render_untimed;
+int g_ls_replay_active=1;
+static int s_cycle_replay_active;
+static uint64_t s_cycle_replay_live;
+static uint32_t s_cycle_replay_batch,s_cycle_replay_limit;
+static int s_cycle_replay_defer;
+static uint32_t *s_cycle_replay_local;
+static void psx_advance_cycles(uint32_t n) {psx_cycle_count+=n+g_psx_cyc_batch;g_psx_cyc_batch=0;}
+'''
+for sig in ('uint64_t psx_get_cycle_count(', 'int psx_cycle_replay_begin(', 'uint64_t psx_cycle_replay_end(', 'static uint64_t psx_pipeline_now(', 'void psx_muldiv_set(', 'void psx_muldiv_stall(', 'void psx_gte_read(', 'void psx_gte_set(', 'void psx_gte_stall('):code+=function(sig)+'\n'
+code+=r'''
+static void run(CPUState *c,unsigned op,unsigned n) {
+ switch(op) {case 0:psx_muldiv_set(c,n);break;case 1:psx_muldiv_stall(c);break;case 2:psx_gte_read(c,4);break;case 3:psx_gte_set(c,n);break;case 4:psx_gte_stall(c);break;}
+}
+int main(void) {
+ CPUState serial={0};serial.gte_ts_done=150;
+ psx_cycle_count=100;g_psx_cyc_batch=20;psx_gte_set(&serial,7);
+ assert(serial.gte_ts_done==157 && psx_get_cycle_count()==150);
+
+ for(unsigned b=0;b<65;b++)for(unsigned local=0;local<5;local++)for(unsigned d=0;d<80;d++)for(unsigned op=0;op<5;op++) {
+  CPUState a={0},c={0};a.muldiv_ts_done=a.gte_ts_done=100+d;a.read_absorb[0]=12;c=a;
+  psx_cycle_count=100+b+local;g_psx_cyc_batch=0;g_psx_cyc_local_acc=NULL;run(&a,op,7);uint64_t end=psx_get_cycle_count();
+  uint32_t acc=local;psx_cycle_count=100;g_psx_cyc_batch=b;g_psx_cyc_local_acc=&acc;run(&c,op,7);
+  assert(end==psx_get_cycle_count());assert(memcmp(&a,&c,sizeof a)==0);
+ }
+ uint32_t acc=23;psx_cycle_count=100;g_psx_cyc_batch=34;g_psx_cyc_batch_limit=64;g_psx_cyc_bb_defer=2;g_psx_cyc_local_acc=&acc;
+ assert(psx_cycle_replay_begin(10));assert(psx_get_cycle_count()==10);assert(!g_psx_cyc_local_acc && !g_psx_cyc_bb_defer);
+ psx_advance_cycles(5);g_psx_cyc_batch=2;assert(psx_cycle_replay_end()==17);
+ assert(psx_cycle_count==100 && g_psx_cyc_batch==34 && g_psx_cyc_batch_limit==64 && g_psx_cyc_bb_defer==2 && g_psx_cyc_local_acc==&acc && acc==23);
+ return 0;
+}
+'''
+with tempfile.TemporaryDirectory() as tmp:
+ p=Path(tmp);(p/'test.c').write_text(code)
+ subprocess.run([os.environ.get('CC','cc'),'-O2',str(p/'test.c'),'-o',str(p/'test')],check=True)
+ subprocess.run([str(p/'test')],check=True)
+print('pipeline batch deadlines and replay isolation: passed')
