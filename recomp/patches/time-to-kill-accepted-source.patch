+/* Time to Kill D17AW: one redraw on the render thread's instance
+ * (render_copy/rc_render_replay.c, render_thread.h). Only the GPU emulator
+ * and renderer of that instance are touched: the guest's cycle counters,
+ * interrupts, PGXP and debug state belong to the emulation thread and a feed
+ * runs no guest code. The instance starts from the snapshot's GPU state;
+ * gl_replay_end restores its surfaces for the next redraw of the same frame. */
+extern void gpu_rt_ws_import(const uint8_t *p);
+/* D23O part 2: the snapshot's GPU and widescreen state, before the session
+ * (render_thread.c calls it while it holds the snapshot). */
+int render_replay_rt_import(const uint8_t *gpu, uint32_t gpu_len, const uint8_t *ws) {
+    if (g_render_replay_active) return 0;
+    gpu_rt_ws_import(ws);
+    if (!gpu_snapshot_read(gpu, gpu_len)) { s_stats.failed++; return 0; }
+    return 1;
+}
+int render_replay_rt_session(const uint32_t *stream, uint32_t n, int capture_cache) {
+    extern int gl_replay_set_capture_cache(int c);
+    extern void gl_replay_reset_capture_cache(void);
+    extern void gpu_host_replay_begin(void);
+    if (g_render_replay_active) return 0;
+    if (!gl_replay_set_capture_cache(capture_cache)) return 0;
+    const uint64_t t0 = SDL_GetPerformanceCounter();
+    if (!gl_replay_begin()) { s_stats.failed++; gl_replay_reset_capture_cache(); return 0; }
+    gpu_host_replay_begin();
+    render_replay_reset_channel();
+    g_render_replay_active = 1;
+    s_stats.sessions++;
+    const uint64_t t1 = SDL_GetPerformanceCounter();
+    const int ok = render_replay_feed(stream, n);
+    g_render_replay_active = 0;
+    const uint64_t t2 = SDL_GetPerformanceCounter();
+    const int captured = gl_replay_end(ok) && ok;
+    gl_replay_resume();
+    gl_replay_reset_capture_cache();
+    if (captured) s_stats.captured++; else s_stats.failed++;
+    const uint64_t f = SDL_GetPerformanceFrequency();
+    if (f) {
+        const uint64_t now = SDL_GetPerformanceCounter(), us = (now - t0) * 1000000u / f;
+        s_stats.begin_us += (t1 - t0) * 1000000u / f;
+        s_stats.guest_us += (t2 - t1) * 1000000u / f;
+        s_stats.end_us += (now - t2) * 1000000u / f;
+        s_stats.total_us += us; s_stats.last_us = us;
+        if (us > s_stats.max_us) s_stats.max_us = us;
+    }
+    return captured;
+}
