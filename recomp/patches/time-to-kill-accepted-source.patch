+/* shadow_mesh.c - the shared world shadow mesh (Time to Kill D41F).
+ * The title sets it on the emulation thread; every renderer instance (the
+ * emulation thread's and the render threads' copies, render_copy/) takes its
+ * own copy when the generation changes and uploads it to its context. Not a
+ * copied source: one store for all instances. */
+#if defined(__linux__) && !defined(_GNU_SOURCE)
+#define _GNU_SOURCE   /* pthread_setname_np */
+#endif
+#include "mod_plugins.h"
+#include <math.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+static pthread_mutex_t s_mu = PTHREAD_MUTEX_INITIALIZER;
+static float *s_xyz = NULL;
+static PSXModShadowChunk *s_chunks = NULL;
+static uint32_t s_ntris = 0, s_nchunks = 0, s_gen = 0;
+
+void psx_mod_gpu_set_shadow_mesh(const float *xyz, uint32_t ntris, const PSXModShadowChunk *chunks, uint32_t nchunks) {
+    float *nx = NULL; PSXModShadowChunk *nc = NULL;
+    if (!xyz || !chunks) ntris = nchunks = 0;
+    if (ntris && nchunks) {
+        nx = (float *)malloc((size_t)ntris * 9 * sizeof(float));
+        nc = (PSXModShadowChunk *)malloc((size_t)nchunks * sizeof(PSXModShadowChunk));
+        if (!nx || !nc) { free(nx); free(nc); nx = NULL; nc = NULL; ntris = nchunks = 0; }
+        else {
+            memcpy(nx, xyz, (size_t)ntris * 9 * sizeof(float));
+            memcpy(nc, chunks, (size_t)nchunks * sizeof(PSXModShadowChunk));
+        }
+    }
+    pthread_mutex_lock(&s_mu);
+    free(s_xyz); free(s_chunks);
+    s_xyz = nx; s_chunks = nc; s_ntris = ntris; s_nchunks = nchunks;
+    if (++s_gen == 0) s_gen = 1;
+    pthread_mutex_unlock(&s_mu);
+}
+
+uint32_t psx_shadow_mesh_generation(void) {
+    pthread_mutex_lock(&s_mu);
+    const uint32_t g = s_gen;
+    pthread_mutex_unlock(&s_mu);
+    return g;
+}
+
+int psx_shadow_mesh_take(uint32_t have, uint32_t *gen, float **xyz, uint32_t *ntris, PSXModShadowChunk **chunks, uint32_t *nchunks) {
+    int r = 0;
+    pthread_mutex_lock(&s_mu);
+    if (s_gen != have) {
+        *gen = s_gen; *xyz = NULL; *chunks = NULL; *ntris = 0; *nchunks = 0;
+        if (s_ntris && s_nchunks) {
+            float *x = (float *)malloc((size_t)s_ntris * 9 * sizeof(float));
+            PSXModShadowChunk *c = (PSXModShadowChunk *)malloc((size_t)s_nchunks * sizeof(PSXModShadowChunk));
+            if (x && c) {
+                memcpy(x, s_xyz, (size_t)s_ntris * 9 * sizeof(float));
+                memcpy(c, s_chunks, (size_t)s_nchunks * sizeof(PSXModShadowChunk));
+                *xyz = x; *chunks = c; *ntris = s_ntris; *nchunks = s_nchunks;
+            } else { free(x); free(c); }
+        }
+        r = 1;
+    }
+    pthread_mutex_unlock(&s_mu);
+    return r;
+}
+/* D41F1: SHADOW EDGES, a setting rather than part of the image: every renderer
+ * instance of this process (not copied per render thread) reads it. */
+int g_psx_shadow_edges = 1;
+void psx_mod_gpu_set_shadow_edges(int smooth) { __atomic_store_n(&g_psx_shadow_edges, smooth < 0 ? 0 : smooth > 2 ? 2 : smooth, __ATOMIC_RELAXED); }
+
+/* ---- D23O part 2: shadow classes, one table for every renderer instance ----
+ * D41F2 classified each (light, receiving triangle) pair as wholly lit, wholly
+ * shadowed or partial on the renderer instance that met it, within a CPU
+ * budget per image (400 us), into a table of its own: the emulation thread
+ * and both render threads each classified the same pairs, on the thread that
+ * draws, and in a busy view most pairs waited behind the budget for many
+ * images (per pixel meanwhile). Now one table serves every instance and one
+ * low-priority thread classifies: a renderer only looks a pair up; a miss is
+ * queued (once: the entry reads "pending" until done) and drawn per pixel, as
+ * a budget miss was. The classifier and its tests are those of D41F2 (moved
+ * here unchanged), so a class is the same whichever thread meets the pair.
+ *
+ * Keys are made by the renderers (slot, map stamp, mesh generation, reach,
+ * tile, quantized world corners) with the class + 1 in their low two bits;
+ * low bits 0 mark a pending pair. Entries are single 64-bit words updated
+ * with atomics, so lookups take no lock. Requests for a mesh generation the
+ * classifier no longer holds are answered "partial" (per pixel: always
+ * right). Developer PSX_SHADOW_CLASSIFY_THREAD=0: no thread (every pair stays
+ * per pixel, for comparison). */
+#define SH_CL_BASE 3.0
+#define SH_CL_SIDE 0.25
+#define SH_CL_TEX 4.0
+static inline double cl_dot(const double *a, const double *b) { return a[0]*b[0] + a[1]*b[1] + a[2]*b[2]; }
+static inline void cl_cross(const double *a, const double *b, double *o) {
+    o[0] = a[1]*b[2] - a[2]*b[1]; o[1] = a[2]*b[0] - a[0]*b[2]; o[2] = a[0]*b[1] - a[1]*b[0];
+}
+/* 1 lit, 2 shadowed, 0 partial. P the light, R the receiver (world). */
+static int cl_classify(const double P[3], const double R[9], double far, double T,
+                       const float *xyz, uint32_t ntris, const PSXModShadowChunk *chunks, uint32_t nchunks, uint64_t *tests) {
+    double pl[5][4];   /* inside: dot(n, X) - d > 0 */
+    double nr[3], e1[3] = { R[3]-R[0], R[4]-R[1], R[5]-R[2] }, e2[3] = { R[6]-R[0], R[7]-R[1], R[8]-R[2] };
+    cl_cross(e1, e2, nr);
+    double ln = sqrt(cl_dot(nr, nr));
+    if (ln < 1e-6) return 0;
+    for (int k = 0; k < 3; k++) nr[k] /= ln;
+    const double pr[3] = { P[0]-R[0], P[1]-R[1], P[2]-R[2] };
+    if (cl_dot(nr, pr) < 0.0) for (int k = 0; k < 3; k++) nr[k] = -nr[k];
+    if (cl_dot(nr, pr) <= SH_CL_BASE + 0.5) return 0;   /* light (nearly) in the receiver's plane */
+    pl[0][0] = nr[0]; pl[0][1] = nr[1]; pl[0][2] = nr[2]; pl[0][3] = cl_dot(nr, R) + SH_CL_BASE;
+    for (int e = 0; e < 3; e++) {
+        const double *A = R + e * 3, *B = R + ((e + 1) % 3) * 3, *C = R + ((e + 2) % 3) * 3;
+        double a[3] = { A[0]-P[0], A[1]-P[1], A[2]-P[2] }, b[3] = { B[0]-P[0], B[1]-P[1], B[2]-P[2] }, c[3] = { C[0]-P[0], C[1]-P[1], C[2]-P[2] }, n[3];
+        cl_cross(a, b, n);
+        double l = sqrt(cl_dot(n, n));
+        if (l < 1e-9) return 0;
+        for (int k = 0; k < 3; k++) n[k] /= l;
+        if (cl_dot(n, c) < 0.0) for (int k = 0; k < 3; k++) n[k] = -n[k];
+        pl[1 + e][0] = n[0]; pl[1 + e][1] = n[1]; pl[1 + e][2] = n[2]; pl[1 + e][3] = cl_dot(n, P) + SH_CL_SIDE;
+    }
+    double lo[3], hi[3];
+    for (int k = 0; k < 3; k++) {
+        lo[k] = fmin(P[k], fmin(R[k], fmin(R[3 + k], R[6 + k])));
+        hi[k] = fmax(P[k], fmax(R[k], fmax(R[3 + k], R[6 + k])));
+    }
+    /* Corners within the map's reach (beyond it the lookup reads lit). */
+    int reach = 1;
+    for (int i = 0; i < 3; i++) {
+        const double d[3] = { R[i*3]-P[0], R[i*3+1]-P[1], R[i*3+2]-P[2] };
+        if (cl_dot(d, d) >= far * far * 0.98) reach = 0;
+    }
+    int partial = 0;
+    for (uint32_t c = 0; c < nchunks; c++) {
+        const PSXModShadowChunk *q = &chunks[c];
+        if (q->hi[0] < lo[0] || q->lo[0] > hi[0] || q->hi[1] < lo[1] || q->lo[1] > hi[1] || q->hi[2] < lo[2] || q->lo[2] > hi[2]) continue;
+        if (q->first + q->count > ntris) continue;
+        {   /* The whole chunk box outside one pyramid face: nothing in it enters. */
+            int out = 0;
+            for (int p = 0; p < 4 && !out; p++) {
+                const double *n = pl[p];
+                const double mx = n[0] * (n[0] > 0.0 ? q->hi[0] : q->lo[0]) + n[1] * (n[1] > 0.0 ? q->hi[1] : q->lo[1]) + n[2] * (n[2] > 0.0 ? q->hi[2] : q->lo[2]);
+                if (mx - n[3] <= 0.0) out = 1;
+            }
+            if (out) continue;
+        }
+        for (uint32_t t = q->first; t < q->first + q->count; t++) {
+            const float *v = xyz + (size_t)t * 9;
+            (*tests)++;
+            const double V[9] = { v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7], v[8] };
+            int sep = 0;
+            for (int p = 0; p < 4 && !sep; p++) {
+                const double *n = pl[p];
+                if (n[0]*V[0] + n[1]*V[1] + n[2]*V[2] - n[3] <= 0.0 &&
+                    n[0]*V[3] + n[1]*V[4] + n[2]*V[5] - n[3] <= 0.0 &&
+                    n[0]*V[6] + n[1]*V[7] + n[2]*V[8] - n[3] <= 0.0) sep = 1;
+            }
+            if (sep) continue;
+            /* Wholly inside the 4-unit near plane: never in the map. */
+            {
+                int nearall = 1;
+                for (int i = 0; i < 3 && nearall; i++) {
+                    const double d[3] = { V[i*3]-P[0], V[i*3+1]-P[1], V[i*3+2]-P[2] };
+                    if (cl_dot(d, d) >= 3.9 * 3.9) nearall = 0;
+                }
+                if (nearall) continue;
+            }
+            double f1[3] = { V[3]-V[0], V[4]-V[1], V[5]-V[2] }, f2[3] = { V[6]-V[0], V[7]-V[1], V[8]-V[2] }, no[3];
+            cl_cross(f1, f2, no);
+            const double lo2 = sqrt(cl_dot(no, no));
+            if (lo2 < 1e-9) continue;   /* degenerate: the map draws nothing */
+            for (int k = 0; k < 3; k++) no[k] /= lo2;
+            {   /* The occluder's plane separates it from the pyramid (light and corners). */
+                const double d0 = cl_dot(no, V);
+                const double sp = cl_dot(no, P) - d0;
+                double smin = sp, smax = sp;
+                for (int i = 0; i < 3; i++) { const double si = cl_dot(no, R + i * 3) - d0; smin = fmin(smin, si); smax = fmax(smax, si); }
+                if (smin >= 0.0 || smax <= 0.0) continue;
+            }
+            partial = 1;
+            if (!reach) return 0;
+            /* Does this one triangle cover all three corners (with a margin)? */
+            int cover = 1;
+            for (int i = 0; i < 3 && cover; i++) {
+                const double dir[3] = { R[i*3]-P[0], R[i*3+1]-P[1], R[i*3+2]-P[2] };
+                const double dn = cl_dot(dir, no);
+                if (fabs(dn) < 1e-9) { cover = 0; break; }
+                const double tt = (cl_dot(no, V) - cl_dot(no, P)) / dn;
+                const double len = sqrt(cl_dot(dir, dir));
+                if (tt * len <= 4.0 || tt >= 1.0 - (SH_CL_BASE + 1.0) / len) { cover = 0; break; }
+                const double X[3] = { P[0] + dir[0]*tt, P[1] + dir[1]*tt, P[2] + dir[2]*tt };
+                const double m = SH_CL_TEX * 2.0 * tt * len / T;   /* texels at the occluder */
+                for (int e = 0; e < 3; e++) {
+                    const double *A = V + e * 3, *B = V + ((e + 1) % 3) * 3, *C = V + ((e + 2) % 3) * 3;
+                    double ab[3] = { B[0]-A[0], B[1]-A[1], B[2]-A[2] }, inw[3];
+                    cl_cross(no, ab, inw);
+                    const double il = sqrt(cl_dot(inw, inw));
+                    const double ac[3] = { C[0]-A[0], C[1]-A[1], C[2]-A[2] };
+                    if (cl_dot(inw, ac) < 0.0) for (int k = 0; k < 3; k++) inw[k] = -inw[k];
+                    const double ax[3] = { X[0]-A[0], X[1]-A[1], X[2]-A[2] };
+                    if (cl_dot(inw, ax) / il < m) { cover = 0; break; }
+                }
+            }
+            if (cover) return 2;
+        }
+    }
+    return partial ? 0 : 1;
+}
+
+#define CLS_HASH (1u << 18)
+#define CLS_PROBE 8
+#define CLS_QUEUE 4096
+typedef struct { uint64_t key; uint32_t gen; float far, tile; double P[3], R[9]; } ClsReq;
+static _Atomic uint64_t *s_cls_tab = NULL;
+static pthread_mutex_t s_cls_mu = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t s_cls_cv = PTHREAD_COND_INITIALIZER;
+static ClsReq s_cls_q[CLS_QUEUE];
+static uint32_t s_cls_head = 0, s_cls_tail = 0;
+static int s_cls_state = 0;   /* 0 not started, 1 running, -1 off */
+static _Atomic uint64_t s_cls_done = 0, s_cls_dropped = 0, s_cls_full = 0, s_cls_ns = 0, s_cls_tests = 0;
+static float *s_cls_xyz = NULL; static PSXModShadowChunk *s_cls_chunks = NULL;
+static uint32_t s_cls_ntris = 0, s_cls_nchunks = 0, s_cls_gen = 0;
+
+static void cls_store(uint64_t key, int cls) {
+    const uint64_t k = key & ~3ull;
+    const uint32_t at = (uint32_t)(k >> 20) & (CLS_HASH - 1u);
+    for (int i = 0; i < CLS_PROBE; i++) {
+        _Atomic uint64_t *e = &s_cls_tab[(at + i) & (CLS_HASH - 1u)];
+        const uint64_t v = atomic_load_explicit(e, memory_order_relaxed);
+        if ((v & ~3ull) == k) atomic_store_explicit(e, k | (uint64_t)(cls + 1), memory_order_release);   /* every copy (see below) */
+    }
+}
+/* Snapping (D23O part 2). A drawn triangle's world corners are rebuilt from
+ * eye-relative positions whose error grows with distance (0.1-1 unit in the
+ * level 3 corridor) and changes with the camera, so a key made from them
+ * changed at almost every redraw and the D41F2 cache rarely hit. Level
+ * geometry lies on a coarse lattice (room origins and piece steps of 128 and
+ * 1024 units, halved or quartered where the game subdivides a polygon), so
+ * each coordinate within a distance-scaled tolerance of a multiple of
+ * SNAP_STEP is that multiple: the key, and the triangle classified, become
+ * exact and the same at every redraw. A triangle with a coordinate off the
+ * lattice (actors, props, moving parts) is not classified: per pixel, as a
+ * budget miss was. */
+#define SNAP_STEP 16.0
+int psx_shadow_snap(double R[9], const double eye[3]) {
+    double S[9];
+    for (int c = 0; c < 3; c++) {
+        const double *p = R + c * 3;
+        /* The distance bounded by sqrt(3) x the largest axis (no square root). */
+        const double ax = fmax(fabs(p[0] - eye[0]), fmax(fabs(p[1] - eye[1]), fabs(p[2] - eye[2])));
+        double tol = 0.5 + ax * (1.7321 / 4096.0);   /* about 4x the error seen */
+        if (tol > 6.0) tol = 6.0;
+        for (int k = 0; k < 3; k++) {
+            const double q = nearbyint(p[k] * (1.0 / SNAP_STEP)) * SNAP_STEP;
+            if (fabs(p[k] - q) > tol) return 0;
+            S[c * 3 + k] = q;
+        }
+    }
+    memcpy(R, S, sizeof S);
+    return 1;
+}
+static void cls_take_mesh(void) {
+    uint32_t gen = 0, nt = 0, nc = 0; float *x = NULL; PSXModShadowChunk *c = NULL;
+    if (psx_shadow_mesh_take(s_cls_gen, &gen, &x, &nt, &c, &nc)) {
+        free(s_cls_xyz); free(s_cls_chunks);
+        s_cls_xyz = x; s_cls_chunks = c; s_cls_ntris = nt; s_cls_nchunks = nc; s_cls_gen = gen;
+    }
+}
+static void *cls_thread(void *arg) {
+    (void)arg;
+#if defined(__linux__)
+    pthread_setname_np(pthread_self(), "psx-shclass");
+#endif
+    pthread_mutex_lock(&s_cls_mu);
+    for (;;) {
+        while (s_cls_head == s_cls_tail) pthread_cond_wait(&s_cls_cv, &s_cls_mu);
+        const ClsReq r = s_cls_q[s_cls_tail++ % CLS_QUEUE];
+        pthread_mutex_unlock(&s_cls_mu);
+        if (r.gen != s_cls_gen) cls_take_mesh();
+        if (r.gen != s_cls_gen || !s_cls_xyz || !s_cls_chunks) {
+            cls_store(r.key, 0);   /* another mesh: per pixel */
+            atomic_fetch_add(&s_cls_dropped, 1);
+        } else {
+            struct timespec a, b; uint64_t tests = 0;
+            clock_gettime(CLOCK_MONOTONIC, &a);
+            const int cls = cl_classify(r.P, r.R, (double)r.far, (double)r.tile, s_cls_xyz, s_cls_ntris, s_cls_chunks, s_cls_nchunks, &tests);
+            clock_gettime(CLOCK_MONOTONIC, &b);
+            cls_store(r.key, cls);
+            atomic_fetch_add(&s_cls_done, 1); atomic_fetch_add(&s_cls_tests, tests);
+            atomic_fetch_add(&s_cls_ns, (uint64_t)((b.tv_sec - a.tv_sec) * 1000000000ll + (b.tv_nsec - a.tv_nsec)));
+        }
+        pthread_mutex_lock(&s_cls_mu);
+    }
+    return NULL;
+}
+static int cls_start(void) {
+    pthread_mutex_lock(&s_cls_mu);
+    if (s_cls_state == 0) {
+        const char *e = getenv("PSX_SHADOW_CLASSIFY_THREAD");
+        s_cls_tab = (_Atomic uint64_t *)calloc(CLS_HASH, sizeof(uint64_t));
+        s_cls_state = -1;
+        if (s_cls_tab && !(e && e[0] == '0')) {
+            pthread_t t; pthread_attr_t at;
+            pthread_attr_init(&at); pthread_attr_setdetachstate(&at, PTHREAD_CREATE_DETACHED);
+            if (pthread_create(&t, &at, cls_thread, NULL) == 0) s_cls_state = 1;
+            pthread_attr_destroy(&at);
+        }
+    }
+    const int st = s_cls_state;
+    pthread_mutex_unlock(&s_cls_mu);
+    return st;
+}
+int psx_shadow_class_get(uint64_t key, uint32_t gen, const double P[3], const double R[9], float far, float tile) {
+    static _Atomic int started = 0;
+    if (!atomic_load_explicit(&started, memory_order_acquire)) { if (cls_start() != 1) return -2; atomic_store(&started, 1); }
+    const uint64_t k = key & ~3ull;
+    const uint32_t at = (uint32_t)(k >> 20) & (CLS_HASH - 1u);
+    for (int i = 0; i < CLS_PROBE; i++) {
+        _Atomic uint64_t *e = &s_cls_tab[(at + i) & (CLS_HASH - 1u)];
+        uint64_t v = atomic_load_explicit(e, memory_order_acquire);
+        if ((v & ~3ull) == k) return (v & 3u) ? (int)(v & 3u) - 1 : -1;
+        if (v == 0) {
+            /* Claim the free entry as pending, then queue the pair. */
+            if (!atomic_compare_exchange_strong(e, &v, k)) {
+                if ((v & ~3ull) == k) return (v & 3u) ? (int)(v & 3u) - 1 : -1;
+                continue;
+            }
+            pthread_mutex_lock(&s_cls_mu);
+            if (s_cls_head - s_cls_tail < CLS_QUEUE) {
+                ClsReq *q = &s_cls_q[s_cls_head++ % CLS_QUEUE];
+                q->key = k; q->gen = gen; q->far = far; q->tile = tile;
+                memcpy(q->P, P, sizeof q->P); memcpy(q->R, R, sizeof q->R);
+                pthread_cond_signal(&s_cls_cv);
+                pthread_mutex_unlock(&s_cls_mu);
+            } else {
+                pthread_mutex_unlock(&s_cls_mu);
+                atomic_store_explicit(e, k | 1u, memory_order_release);   /* queue full: per pixel */
+                atomic_fetch_add(&s_cls_full, 1);
+            }
+            return -1;
+        }
+    }
+    /* Probe window full: replace its first entry (an older pair asks again). */
+    atomic_store_explicit(&s_cls_tab[at], 0, memory_order_relaxed);
+    return -1;
+}
+void psx_shadow_class_stats(uint64_t out[5]) {
+    out[0] = atomic_load(&s_cls_done); out[1] = atomic_load(&s_cls_ns); out[2] = atomic_load(&s_cls_tests);
+    out[3] = atomic_load(&s_cls_dropped); out[4] = atomic_load(&s_cls_full);
+}
