+ // Older seven-word entries retain their original depth contract.
+ buf[0]=(4u<<24)|7;assert(render_replay_feed(buf,8));
+ assert(stores==3 && got_depth==got_z && got_coverage==1.0f);
+ // First-person weapons still opt out independently of perspective.
+ render_replay_record_begin(buf,16);
+ render_replay_record_host_vertex(0x80012340,0xabcd,-123,456,600,0,0,-600,1);
+ n=render_replay_record_end(&overflow);assert(render_replay_feed(buf,n));
