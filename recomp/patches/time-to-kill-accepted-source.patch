+/* Title opt-in precise culling: a validated exact sign that disagrees with the
+ * integer determinant becomes MAC0 (+1/-1); untracked inputs and the
+ * disabled default keep the native value. */
+int test_precise_nclip_culling() {
+    CPUState cpu{};
+    gte_precision_tracking_set(1);
+    g_test_precise_nclip_enabled = 0;
+    const uint32_t packed[3] = {0x00000001u, 0xFFFFFFFEu, 0xFFFFFFFFu};
+    const int32_t x16[3] = {101245, -109694, -34340};
+    const int32_t y16[3] = {19509, -59658, -20365};
+    for (uint32_t i = 0; i < 3; ++i) {
+        cpu.gte_data[12 + i] = packed[i];
+        gte_test_seed_precise_projection(i, packed[i], x16[i], y16[i], 100);
+    }
+    gte_execute(&cpu, 0x06u);
+    if (cpu.gte_data[24] != 1u)
+        return fail_value("precise culling is off by default", 0, 0x06u,
+                          0, 1u, cpu.gte_data[24]);
+    gte_nclip_culling_set(1);
+    uint64_t checks0 = 0, flips0 = 0;
+    gte_nclip_culling_stats(&checks0, &flips0);
+    for (uint32_t i = 0; i < 3; ++i)
+        gte_test_seed_precise_projection(i, packed[i], x16[i], y16[i], 100);
+    gte_execute(&cpu, 0x06u);
+    uint64_t checks1 = 0, flips1 = 0;
+    gte_nclip_culling_stats(&checks1, &flips1);
+    if (cpu.gte_data[24] != 0xFFFFFFFFu || checks1 != checks0 + 1u ||
+        flips1 != flips0 + 1u)
+        return fail_value("precise culling takes the exact sign", 0, 0x06u,
+                          0, 0xFFFFFFFFu, cpu.gte_data[24]);
+    /* A stale shadow keeps the native determinant. */
+    gte_test_seed_precise_projection(0, packed[0] ^ 1u, x16[0], y16[0], 100);
+    gte_execute(&cpu, 0x06u);
+    uint64_t checks2 = 0, flips2 = 0;
+    gte_nclip_culling_stats(&checks2, &flips2);
+    gte_nclip_culling_set(0);
+    if (cpu.gte_data[24] != 1u || checks2 != checks1 || flips2 != flips1)
+        return fail_value("stale shadow keeps native NCLIP", 0, 0x06u,
+                          0, 1u, cpu.gte_data[24]);
+    return 0;
+}
+
 int test_precision_speculative_transaction() {
     constexpr uint32_t address = 0x00123450u;
     constexpr uint32_t packed = 0x00420021u;
@@ -740,6 +783,7 @@ int main() {
     if (int rc = test_command_timing_hook()) return rc;
     if (int rc = test_precise_sxy_invalidation()) return rc;
     if (int rc = test_precise_nclip_is_title_scoped()) return rc;
