+        const uint32_t base = hpv_slot(a);
+        uint32_t slot = HOST_PV_CAP;
+        for (uint32_t k = 0; k < HOST_PV_PROBE; k++) {
+            const uint32_t c = (base + k) & (HOST_PV_CAP - 1u);
