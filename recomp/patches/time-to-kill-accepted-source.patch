+            for (int j = 0; j < 3; j++) s_ph_sum[j] += (double)(t[j + 1] - t[j]) / 1e6;
+            for (int d = 0; d + 1 < s_ph_dn[i]; d += 2) {
+                GLuint64 a = 0, b = 0; p_glGetQueryObjectui64v(s_ph_dq[i][d], GL_QUERY_RESULT, &a); p_glGetQueryObjectui64v(s_ph_dq[i][d + 1], GL_QUERY_RESULT, &b);
