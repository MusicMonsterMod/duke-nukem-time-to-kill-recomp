+    "band", "mirror", "upload", "fill-copy", "wide-clear", "setup", "end" };
+static GLuint s_phc_q[PH_N][PHC_MARKS]; static unsigned char s_phc_cat[PH_N][PHC_MARKS]; static int s_phc_n[PH_N];
+static int s_phc_stack[16], s_phc_sp = 0, s_phc_in = 0; static double s_phc_sum[PHC_N]; static uint64_t s_phc_cnt[PHC_N];
+static void phc_mark(int cat) {
+    if (s_ph_on != 2 || s_ph_i < 0 || !s_phc_in) return;
+    int n = s_phc_n[s_ph_i];
