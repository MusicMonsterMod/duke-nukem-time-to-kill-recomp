+    if (!window) return;
+    const auto flags = SDL_GetWindowFlags(window);
+    if (flags & SDL_WINDOW_FULLSCREEN) return;
+    if (flags & SDL_WINDOW_MAXIMIZED) { s_last_windowed_w = 0; return; }
+    int w = 0, h = 0;
+    SDL_GetWindowSize(window, &w, &h);
