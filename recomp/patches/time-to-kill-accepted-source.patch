+    if(bytes>capacity) {
+        free(first);free(next);first=malloc(bytes);next=malloc(bytes);capacity=bytes;
+    }
+    if(!first || !next) return 0;
+    gs_bind_fb(PSXGL_READ_FRAMEBUFFER,s_rp_fbo[slot]);
+    glReadPixels(0,0,s_rp_tw[slot],s_rp_th[slot],GL_RGBA,GL_UNSIGNED_BYTE,second?next:first);
+    gs_bind_fb(PSXGL_READ_FRAMEBUFFER,0);
+    if(!second) {first_size=bytes;return 1;}
+    if(bytes==first_size && memcmp(first,next,bytes)==0) return 1;
+    if(bytes==first_size) {   /* developer detail: how far apart */
+        size_t n=0;int maxd=0,x0=1<<30,y0=1<<30,x1=-1,y1=-1;const int w=s_rp_tw[slot];
