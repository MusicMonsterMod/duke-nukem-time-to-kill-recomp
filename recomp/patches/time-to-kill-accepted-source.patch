+}
+static void ph_mark(int k) {
+    if (s_ph_on < 0) {
+        const char *e = getenv("PSX_GPU_PHASES");
+        s_ph_on = e && (e[0] == '1' || e[0] == '2') && p_glQueryCounter && p_glGetQueryObjectiv && p_glGetQueryObjectui64v ? e[0] - '0' : 0;
