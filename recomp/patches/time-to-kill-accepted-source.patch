+/* Copy a displayed-frame rect (native coords) of the current present path into
+ * an rp texture. y is the top of the band to copy. */
+static int rp_copy_band_body(int slot, int y);
+static int rp_copy_band(int slot, int y) { ph_push(6); int r = rp_copy_band_body(slot, y); ph_pop(); return r; }
+static int rp_copy_band_body(int slot, int y) {
+    int S = s_scale > 0 ? s_scale : 1;
+    GLuint src = 0;
+    int x = 0;
+    if (s_rp_path == GL_PRES_WIDE) {
+        for (int i = 0; i < WIDE_MAX_SURF; i++)
+            if (s_wide_fbo[i] && s_wide_base[i] == s_rp_base_x) src = s_wide_fbo[i];
+        if (!src) return 0;
+        rr_cow_wide(src, y, y + s_rp_h - 1);
+        wide_blit_center(src, s_rp_base_x, y, s_rp_h);
+    } else {
+        src = s_hr_fbo;
+        x = s_rp_base_x;
+    }
+    rp_ensure_tex(slot, s_rp_w * S, s_rp_h * S);
+    GLuint st, sr;
+    if (rr_copy_image_on() && s_rr_ci_checked && rr_surf_of(src, &st, &sr) && st && s_rp_tex[slot]) {   /* D23J */
