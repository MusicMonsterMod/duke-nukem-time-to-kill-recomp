// Stable action order, default input token, SDL scancode (mouse = negative), PS1 bit.
TTK_ACTION(move_forward, W, 26, 0)
TTK_ACTION(move_back, S, 22, 0)
TTK_ACTION(move_left, A, 4, 0)
TTK_ACTION(move_right, D, 7, 0)
TTK_ACTION(fire, Mouse1, -1, 16384)
TTK_ACTION(jump, Space, 44, 32768)
TTK_ACTION(holster, ScrollLock, 71, 8192)
TTK_ACTION(crouch, LCtrl, 224, 0)
TTK_ACTION(walk, LShift, 225, 1024)
// D08T1: original precision aim is unbound in Modernized; with legacy
// (original) weapon aiming or camera the primary Grab input serves it instead.
TTK_ACTION(original_aim, Unbound, 0, 2048)
// D08A5: unbound by default; Comma/Period browse the mission inventory instead
// (A/D strafe in every Modernized state, including the original-control fallback).
TTK_ACTION(original_strafe_left, Unbound, 0, 256)
TTK_ACTION(original_strafe_right, Unbound, 0, 512)
TTK_ACTION(inventory, I, 12, 0)
// Interaction-only: queue original holster first when needed; never armed Cross.
TTK_ACTION(interact, E, 8, 0)
// D10 camera edges: handled on press, never queued as guest commands.
TTK_ACTION(camera_recenter, V, 25, 0)
TTK_ACTION(camera_shoulder, H, 11, 0)
// D11: first-person / third-person view toggle, handled on press like D10 edges.
TTK_ACTION(camera_view, P, 19, 0)
// D08T1: Grab / Manipulate, held. Two default inputs; Alt means either Alt key.
TTK_ACTION(grab, Mouse2, -3, 0)
TTK_ACTION(grab_alt, Alt, 226, 0)
TTK_ACTION(weapon_previous, Semicolon, 51, 0)
TTK_ACTION(weapon_next, Apostrophe, 52, 0)
TTK_ACTION(weapon_last, X, 27, 0)
TTK_ACTION(medkit, M, 16, 0)
TTK_ACTION(steroids, R, 21, 0)
TTK_ACTION(jetpack, J, 13, 0)
TTK_ACTION(goggles, N, 17, 0)
TTK_ACTION(biomask, B, 5, 0)
TTK_ACTION(item_previous, LBracket, 47, 0)
TTK_ACTION(item_next, RBracket, 48, 0)
TTK_ACTION(item_use, U, 24, 0)
TTK_ACTION(quick_kick, Q, 20, 0)
TTK_ACTION(weapon_group_1, 1, 30, 0)
TTK_ACTION(weapon_group_2, 2, 31, 0)
TTK_ACTION(weapon_group_3, 3, 32, 0)
TTK_ACTION(weapon_group_4, 4, 33, 0)
TTK_ACTION(weapon_group_5, 5, 34, 0)
TTK_ACTION(weapon_group_6, 6, 35, 0)
TTK_ACTION(weapon_group_7, 7, 36, 0)
TTK_ACTION(weapon_group_8, 8, 37, 0)
TTK_ACTION(weapon_group_9, 9, 38, 0)
TTK_ACTION(weapon_group_0, 0, 39, 0)
// D08A5: mission inventory, previous / next item (host only, never queued).
TTK_ACTION(mission_previous, Comma, 54, 0)
TTK_ACTION(mission_next, Period, 55, 0)
